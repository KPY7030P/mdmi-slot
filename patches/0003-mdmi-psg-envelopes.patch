diff --git a/tests/unit/test_midi_psg.c b/tests/unit/test_midi_psg.c
index affbb29..736df00 100644
--- a/tests/unit/test_midi_psg.c
+++ b/tests/unit/test_midi_psg.c
@@ -3,13 +3,19 @@
 #include "mocks/mock_psg.h"
 #include "mocks/mock_sgdk.h"
 
+#define MAX_PSG_TONE_CHAN (MAX_PSG_CHAN - 1)
+#define NOISE_MIDI_CHAN MAX_PSG_CHAN
+#define TONE3_MIDI_CHAN MAX_PSG_TONE_CHAN
+#define CC_NOISE_TYPE 12
+#define CC_NOISE_RATE 13
+
