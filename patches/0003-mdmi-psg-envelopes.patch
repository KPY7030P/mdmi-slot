+
+// Stage 22b: a PORTA legato chain of 5 notes, each key raised after the next is pressed. Every new
+// note glides (its target set, no Note On to the chip), raising the key that no longer sounds
+// changes nothing, and the chip's Note Off comes only with the last key. In 0.22.2 the raise of the
+// non-sounding key took the sounding note off the stack, and the third note struck.
+static void tick_gliding(u8 ticks)
+{
+    for (u8 i = 0; i < ticks; i++) {
+        expect_synth_pitch_any();
+        midi_tick(1);
+    }
+}
+
+void test_midi_portamento_legato_chain_glides_on_every_note(UNUSED void** state)
+{
+    const u8 chan = 0;
+    const u8 notes[] = { 45, 48, 52, 55, 60 };
+    DeviceChannel* devChan = &__real_midi_channel_mappings()[chan];
+    __real_midi_cc(chan, CC_PORTAMENTO_ENABLE, 127);
+
+    expect_synth_pitch(chan, 2, 0x439);
+    expect_synth_volume_any();
+    expect_synth_note_on(chan);
+    __real_midi_note_on(chan, notes[0], MAX_MIDI_VOLUME);
+    midi_tick(1);
+
+    for (u8 i = 1; i < sizeof(notes); i++) {
+        __real_midi_note_on(chan, notes[i], MAX_MIDI_VOLUME);
+        assert_int_equal(devChan->glideTargetPitch, notes[i]);
+        tick_gliding(8);
+        __real_midi_note_off(chan, notes[i - 1]);
+        assert_int_equal(devChan->glideTargetPitch, notes[i]);
+        assert_true(devChan->noteOn);
+        tick_gliding(8);
+    }
+
+    expect_value(__wrap_synth_note_off, channel, chan);
+    __real_midi_note_off(chan, notes[sizeof(notes) - 1]);
+    midi_tick(1);
+}
+
+// With three keys held the middle one raised changes nothing either; the top one raised glides
+// back to the one below it, the stack holding exactly the held keys.
+void test_midi_portamento_raising_a_held_key_below_keeps_the_glide(UNUSED void** state)
+{
+    const u8 chan = 0;
+    DeviceChannel* devChan = &__real_midi_channel_mappings()[chan];
+    __real_midi_cc(chan, CC_PORTAMENTO_ENABLE, 127);
+
+    expect_synth_pitch(chan, 2, 0x439);
+    expect_synth_volume_any();
+    expect_synth_note_on(chan);
+    __real_midi_note_on(chan, 45, MAX_MIDI_VOLUME);
+    __real_midi_note_on(chan, 48, MAX_MIDI_VOLUME);
+    __real_midi_note_on(chan, 52, MAX_MIDI_VOLUME);
+    tick_gliding(8);
+    __real_midi_note_off(chan, 48);
+    assert_int_equal(devChan->glideTargetPitch, 52);
+    tick_gliding(8);
+    __real_midi_note_off(chan, 52);
+    assert_int_equal(devChan->glideTargetPitch, 45);
+    // A glide down ends once its whole note reaches the target, here within the first semitone.
+    tick_gliding(4);
+    expect_value(__wrap_synth_note_off, channel, chan);
+    __real_midi_note_off(chan, 45);
+    midi_tick(1);
+}
+
+// Without PORTA the raised top key strikes the one below it, as in 0.22.2, also after a key below
+// was raised; the last key sends Note Off.
+void test_midi_note_stack_without_portamento_as_before(UNUSED void** state)
+{
+    const u8 chan = 0;
+    expect_synth_pitch(chan, 4, 0x284);
+    expect_synth_volume_any();
+    expect_synth_note_on(chan);
+    __real_midi_note_on(chan, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+    expect_synth_pitch(chan, 4, 0x2a9);
+    expect_synth_volume_any();
+    expect_synth_note_on(chan);
+    __real_midi_note_on(chan, MIDI_PITCH_CS4, MAX_MIDI_VOLUME);
+    expect_synth_pitch(chan, 6, 0x47a);
+    expect_synth_volume_any();
+    expect_synth_note_on(chan);
+    __real_midi_note_on(chan, MIDI_PITCH_AS6, MAX_MIDI_VOLUME);
+
+    __real_midi_note_off(chan, MIDI_PITCH_C4);
+
+    expect_synth_pitch(chan, 4, 0x2a9);
+    expect_synth_volume_any();
+    expect_synth_note_on(chan);
+    __real_midi_note_off(chan, MIDI_PITCH_AS6);
+
+    expect_value(__wrap_synth_note_off, channel, chan);
+    __real_midi_note_off(chan, MIDI_PITCH_CS4);
+}
