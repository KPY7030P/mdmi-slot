+// Stage 21, ONE NOTE: the note of MIDI 3 keys all four, the operator channels write nothing.
+void test_ch3_one_note_keys_all_four(void** state)
+{
+    stub_everdrive_as_present();
+    enable_ch3_special_mode();
+    stub_usb_receive_cc(MIDI_CHANNEL_1, CC_CH3_NOTES, 64);
+    expect_ym2612_write_reg(0, YM_KEY_ON_OFF, 0x02);
+    midi_rx_read();
+
+    stub_usb_receive_note_on(MIDI_CHANNEL_11, MIDI_PITCH_C4, 120);
+    midi_rx_read();
+
+    stub_usb_receive_note_on(MIDI_CHANNEL_3, MIDI_PITCH_C4, MIDI_VELOCITY_MAX);
+    expect_ym2612_write_reg(0, 0xAD, 0x22);
+    expect_ym2612_write_reg(0, 0xA9, 0x84);
+    expect_ym2612_write_reg(0, 0xAE, 0x22);
+    expect_ym2612_write_reg(0, 0xAA, 0x84);
+    expect_ym2612_write_reg(0, 0xAC, 0x22);
+    expect_ym2612_write_reg(0, 0xA8, 0x84);
+    expect_ym2612_write_reg(0, 0xA6, 0x22);
+    expect_ym2612_write_reg(0, 0xA2, 0x84);
+    expect_ym2612_write_reg(0, YM_KEY_ON_OFF, 0xF2);
+    midi_rx_read();
+
+    stub_usb_receive_note_off(MIDI_CHANNEL_3, MIDI_PITCH_C4);
+    expect_ym2612_write_reg(0, YM_KEY_ON_OFF, 0x02);
+    midi_rx_read();
+}
+
+// Stage 22 (D52), CSM: the formants as in ONE NOTE, then 0x24 = NA >> 2 and 0x25 = NA & 3, then
+// 0x27 with CSM and timer A; never 0x28 for channel 3 nor 0x26. Pitch changes under the note write
+// 0x24/0x25 and no 0x27; Note Off goes back to 01. Bits 1-3 of a raw write stay in every 0x27.
+static void expect_ch3_formants(void)
+{
+    const u8 regs[] = { 0xAD, 0xA9, 0xAE, 0xAA, 0xAC, 0xA8, 0xA6, 0xA2 };
+    for (u8 i = 0; i < sizeof(regs); i++) {
+        expect_ym2612_write_reg_any_data(0, regs[i]);
+    }
+}
+
+static void expect_timer_a(u16 na)
+{
+    expect_ym2612_write_reg(0, 0x24, na >> 2);
+    expect_ym2612_write_reg(0, 0x25, na & 3);
+}
+
+// Stage 22b (D57): entering or leaving CSM rewrites the AR registers of channel 3's four operators,
+// in operator order (values in test_synth.c).
+static void expect_ch3_attack_rates(void)
+{
+    const u8 regs[] = { 0x52, 0x5A, 0x56, 0x5E };
+    for (u8 i = 0; i < sizeof(regs); i++) {
+        expect_ym2612_write_reg_any_data(0, regs[i]);
+    }
+}
+
+static void receive_raw_ch3_mode(u8 value)
+{
+    const u8 sysEx[] = { 0xF0, 0x00, 0x22, 0x77, 0x08, 0x02, 0x07, value >> 4, value & 0xF, 0xF7 };
+    for (u16 i = 0; i < sizeof(sysEx); i++) {
+        stub_usb_receive_byte(sysEx[i]);
+    }
+}
+
+void test_ch3_csm_writes_timer_then_mode(void** state)
+{
+    stub_everdrive_as_present();
+    enable_ch3_special_mode();
+    stub_usb_receive_cc(MIDI_CHANNEL_1, CC_CH3_NOTES, 127);
+    expect_ym2612_write_reg(0, YM_KEY_ON_OFF, 0x02);
+    expect_ch3_attack_rates();
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x40);
+    midi_rx_read();
+
+    // A4: NA 903.
+    stub_usb_receive_note_on(MIDI_CHANNEL_3, 69, MIDI_VELOCITY_MAX);
+    expect_ch3_formants();
+    expect_timer_a(903);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x81);
+    midi_rx_read();
+
+    // MIDI 11-13 write nothing.
+    stub_usb_receive_note_on(MIDI_CHANNEL_11, MIDI_PITCH_C4, 120);
+    midi_rx_read();
+    stub_usb_receive_note_off(MIDI_CHANNEL_11, MIDI_PITCH_C4);
+    midi_rx_read();
+
+    // Bend +2: B4, NA 916, the timer keeps running.
+    stub_usb_receive_pitch_bend(MIDI_CHANNEL_3, 0x4000);
+    expect_ch3_formants();
+    expect_timer_a(916);
+    midi_rx_read();
+    stub_usb_receive_pitch_bend(MIDI_CHANNEL_3, 0x2000);
+    expect_ch3_formants();
+    expect_timer_a(903);
+    midi_rx_read();
+
+    stub_usb_receive_note_off(MIDI_CHANNEL_3, 69);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x40);
+    midi_rx_read();
+
+    // A raw 0x27 = 0x0A: its bits 1-3 stay from now on.
+    receive_raw_ch3_mode(0x0A);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x4A);
+    midi_rx_read();
+
+    // A5 (NA 963), A6 over it (NA 994), A6 off raises A5: only 0x24/0x25 under the note.
+    stub_usb_receive_note_on(MIDI_CHANNEL_3, 81, MIDI_VELOCITY_MAX);
+    expect_ch3_formants();
+    expect_timer_a(963);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x8B);
+    midi_rx_read();
+    stub_usb_receive_note_on(MIDI_CHANNEL_3, 93, MIDI_VELOCITY_MAX);
+    expect_ch3_formants();
+    expect_timer_a(994);
+    midi_rx_read();
+    stub_usb_receive_note_off(MIDI_CHANNEL_3, 93);
+    expect_ch3_formants();
+    expect_timer_a(963);
+    midi_rx_read();
+    stub_usb_receive_note_off(MIDI_CHANNEL_3, 81);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x4A);
+    midi_rx_read();
+
+    // Below note 32 NA 0. CC 80 off under the note: CSM off first, then Ch3 Special.
+    stub_usb_receive_note_on(MIDI_CHANNEL_3, 20, MIDI_VELOCITY_MAX);
+    expect_ch3_formants();
+    expect_timer_a(0);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x8B);
+    midi_rx_read();
+    stub_usb_receive_cc(MIDI_CHANNEL_1, CC_GENMDM_CH3_SPECIAL_MODE, 0);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x4A);
+    expect_ch3_attack_rates();
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x0A);
+    midi_rx_read();
+
+    // Ch3 Special on again with CSM still chosen: 01, no note.
+    stub_usb_receive_cc(MIDI_CHANNEL_1, CC_GENMDM_CH3_SPECIAL_MODE, SPECIAL_MODE_ON);
+    expect_ym2612_write_reg(0, YM_KEY_ON_OFF, 0x02);
+    expect_ch3_attack_rates();
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x4A);
+    midi_rx_read();
+
+    // CC 81 to OPS under a CSM note: the note goes off by the mode, CSM leaves.
+    stub_usb_receive_note_on(MIDI_CHANNEL_3, 69, MIDI_VELOCITY_MAX);
+    expect_ch3_formants();
+    expect_timer_a(903);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x8B);
+    midi_rx_read();
+    stub_usb_receive_cc(MIDI_CHANNEL_1, CC_CH3_NOTES, 0);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x4A);
+    expect_ch3_attack_rates();
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x4A);
+    midi_rx_read();
+    stub_usb_receive_note_off(MIDI_CHANNEL_3, 69);
+    midi_rx_read();
+}
