+// Where the screen's own tiles start in VRAM (rom-screen.md 10.3).
+#define UI_TILE_BASE 16
+#define UI_T_NOTE (UI_TILE_BASE + 0)
+#define UI_T_DAC_NOTE (UI_TILE_BASE + 60)
+#define UI_T_DAC_DIM (UI_TILE_BASE + 80)
+#define UI_T_DASH (UI_TILE_BASE + 100)
+#define UI_T_OWNER (UI_TILE_BASE + 101)
+#define UI_T_STRIPE (UI_TILE_BASE + 165)
+#define UI_T_BRACKET (UI_TILE_BASE + 169)
+#define UI_T_LABEL_FM (UI_TILE_BASE + 172)
+#define UI_T_LABEL_PSG (UI_TILE_BASE + 177)
+#define UI_T_LEVEL (UI_TILE_BASE + 180)
+#define UI_T_BAR (UI_TILE_BASE + 225)
+#define UI_T_SQUARE (UI_TILE_BASE + 240)
+#define UI_T_WAVE (UI_TILE_BASE + 246)
+#define UI_T_END (UI_TILE_BASE + 343)
+#define UI_TILE_COUNT 343
+#define UI_NOTE_GLYPHS 20
+#define UI_GLYPH_QUESTION 19
+#define UI_GLYPH_DASH 18
+#define UI_LEVEL_PATTERNS 15
+#define UI_WAVE_CLASSES 13
+#define UI_WAVE_FLAT 0
+
+// The plugin's tests read the tile numbers alone.
+#ifndef UI_TILE_NUMBERS_ONLY
+#include "genesis.h"
+extern const u32 UI_TILES[UI_TILE_COUNT * 8];
+extern const u16 UI_PALETTE[64];
+// A key's name as 3 note glyphs: C-4, C#4, ??? below A0.
+extern const u8 UI_NOTE[128][3];
+// A tile of a 16-stripe bar: its pattern by how many of its 4 stripes are lit and where
+// the peak is, +1 (0 none).
+extern const s8 UI_LEVEL_PATTERN[5][5];
+// The tone period below which the wave has the next class, from A2's class 0 up.
+extern const u16 UI_WAVE_PERIOD[UI_WAVE_CLASSES - 1];
+// The wave's 4 tiles from UI_T_WAVE by class and height (3, 5, 7 points).
+extern const u8 UI_WAVE[UI_WAVE_CLASSES][3][4];
+#endif
+#define UI_LABEL_FM_TILES 5
+#define UI_LABEL_PSG_TILES 3
