+    driver_takes();
+    __real_midi_note_off(dacFmChannel, keys[0]);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_IWAVADR(0)), 0x77);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_STATUS] & 3, 2);
+    __real_midi_note_off(dacFmChannel, keys[1]);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_IWAVADR(1)), 0x77);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_COMMAND], 0);
+    put_back();
+}
 
+// A key whose voice another key took writes nothing at Note Off.
+void test_midi_dac_note_off_of_taken_voice_does_nothing(UNUSED void** state)
+{
+    use_samples();
+    for (u8 i = 0; i < 5; i++) {
+        __real_midi_note_on(dacFmChannel, keys[i], 100);
+        driver_takes();
+    }
+    const int takes = mock_pcm_takes;
+    __real_midi_note_off(dacFmChannel, keys[0]);
+    assert_int_equal(mock_pcm_takes, takes);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_STATUS] & 15, 15);
+    put_back();
+}
+
+// A one-shot plays on after Note Off (D38).
+void test_midi_dac_one_shot_ignores_note_off(UNUSED void** state)
+{
+    use_samples();
+    __real_midi_note_on(dacFmChannel, keys[5], 100);
+    driver_takes();
+    const int takes = mock_pcm_takes;
+    __real_midi_note_off(dacFmChannel, keys[5]);
+    assert_int_equal(mock_pcm_takes, takes);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_STATUS] & 1, 1);
+    put_back();
+}
+
+// The stop button and the panic silence all four, one-shots too, and starts not yet taken.
+void test_midi_dac_all_notes_off_stops_all_voices(UNUSED void** state)
+{
+    use_samples();
+    for (u8 cc = 120; cc <= 123; cc += 3) {
+        for (u8 i = 2; i < 6; i++) {
+            __real_midi_note_on(dacFmChannel, keys[i], 100);
+            if (i < 5) {
+                driver_takes();
+            }
+        }
+        __real_midi_cc(dacFmChannel, cc, 0);
+        assert_int_equal(mock_pcm_ram[PCM_DRV_STATUS] & 15, 0);
+        assert_int_equal(mock_pcm_ram[PCM_DRV_COMMAND], 0);
+    }
+    put_back();
+}
+
+// A LOOP sample goes to its voice with the loop bit and stops at Note Off (stage 18).
+void test_midi_dac_loop_sample_loops_until_note_off(UNUSED void** state)
+{
+    static const PcmSample looped = { data[0], 256, 1, PCM_LOOP };
+    const PcmSample* was = percussionPcmSample[noteKey];
+    percussionPcmSample[noteKey] = &looped;
     __real_midi_note_on(dacFmChannel, noteKey, 100);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 1);
+    driver_takes();
+    __real_midi_note_off(dacFmChannel, noteKey);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_STATUS] & 1, 0);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 0);
+    percussionPcmSample[noteKey] = was;
+    mock_pcm_driver_reset();
+}
 
-    expect_function_call(__wrap_SND_PCM_stopPlay);
+// PCM4 has no RATE or PAN: 0x108-0x10B are only ever voice 1's address and length.
+void test_midi_dac_writes_no_rate_or_pan(UNUSED void** state)
+{
+    use_samples();
+    __real_midi_note_on(dacFmChannel, keys[0], 100);
+    assert_int_equal(mock_pcm_read16(0x108), 0);
+    assert_int_equal(mock_pcm_read16(0x10A), 0);
+    __real_midi_note_on(dacFmChannel, keys[1], 100);
+    assert_int_equal(mock_pcm_read16(0x108), block_of(1));
+    assert_int_equal(mock_pcm_read16(0x10A), 1);
+    put_back();
+}
 
+// DAC On again while it is on keeps the voices: a held LOOP sample still stops at Note Off.
+void test_midi_dac_repeated_enable_keeps_voices(UNUSED void** state)
+{
+    use_samples();
+    static const PcmSample looped = { data[0], 256, 1, PCM_LOOP };
+    const PcmSample* was = percussionPcmSample[noteKey];
+    percussionPcmSample[noteKey] = &looped;
+    __real_midi_note_on(dacFmChannel, noteKey, 100);
+    driver_takes();
+    expect_value(__wrap_synth_enable_dac, enable, true);
+    expect_synth_special_mode_keys_off();
+    expect_synth_stereo(5, STEREO_MODE_CENTRE);
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_CLOCK2);
+    __real_midi_cc(0, 78, 0x7F);
     __real_midi_note_off(dacFmChannel, noteKey);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_STATUS] & 1, 0);
+    percussionPcmSample[noteKey] = was;
+    put_back();
+}
+
+// Stage 24a: the screen's DAC table reads each voice's key, state and start.
+void test_midi_dac_voice_view_reads_a_start(UNUSED void** state)
+{
+    use_samples();
+    MidiDacVoiceView before, view;
+    midi_dac_voice_view(0, &before);
+    __real_midi_note_on(dacFmChannel, keys[0], 100);
+    midi_dac_voice_view(0, &view);
+    assert_int_equal(view.key, keys[0]);
+    assert_int_equal(view.state, MIDI_DAC_VOICE_PLAYING);
+    assert_int_not_equal(view.order, before.order);
+    driver_takes();
+    __real_midi_note_on(dacFmChannel, keys[0], 100);
+    MidiDacVoiceView again;
+    midi_dac_voice_view(0, &again);
+    assert_int_not_equal(again.order, view.order);
+    put_back();
 }
