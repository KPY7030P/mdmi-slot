+// Releasing a held one-shot kick leaves the hat started over it playing (stage 14).
+void test_midi_dac_released_key_leaves_other_sample(UNUSED void** state)
+{
+    static const u8 kickData[256] = { 0 };
+    static const u8 hatData[256] = { 0 };
+    static const PcmSample kick = { kickData, sizeof(kickData), 1, PCM_ONE_SHOT };
+    static const PcmSample hat = { hatData, sizeof(hatData), 1, 0 };
+    const u8 kickKey = 36, hatKey = 42;
+    const PcmSample* savedKick = percussionPcmSample[kickKey];
+    const PcmSample* savedHat = percussionPcmSample[hatKey];
+    percussionPcmSample[kickKey] = &kick;
+    percussionPcmSample[hatKey] = &hat;
+
+    expect_pcm_start(kickData);
+    __real_midi_note_on(dacFmChannel, kickKey, 100);
+    expect_pcm_start(hatData);
+    __real_midi_note_on(dacFmChannel, hatKey, 100);
+    __real_midi_note_off(dacFmChannel, kickKey);
+    expect_function_call(__wrap_SND_PCM_stopPlay);
+    __real_midi_note_off(dacFmChannel, hatKey);
+
+    percussionPcmSample[kickKey] = savedKick;
+    percussionPcmSample[hatKey] = savedHat;
+}
+
+// After CC 123 the keys held before it are forgotten: releasing a new key doesn't start them again.
+void test_midi_dac_all_notes_off_forgets_held_keys(UNUSED void** state)
+{
+    static const u8 data[3][256] = { { 0 } };
+    static const PcmSample samples[3] = { { data[0], 256, 1, 0 }, { data[1], 256, 1, 0 },
+        { data[2], 256, 1, 0 } };
+    const u8 keys[3] = { 36, 38, 40 };
+    const PcmSample* saved[3];
+    for (u8 i = 0; i < 3; i++) {
+        saved[i] = percussionPcmSample[keys[i]];
+        percussionPcmSample[keys[i]] = &samples[i];
+    }
+
+    expect_pcm_start(data[0]);
+    __real_midi_note_on(dacFmChannel, keys[0], 100);
+    expect_pcm_start(data[1]);
+    __real_midi_note_on(dacFmChannel, keys[1], 100);
+    expect_function_call(__wrap_SND_PCM_stopPlay);
+    __real_midi_cc(dacFmChannel, 123, 0);
+    expect_pcm_start(data[2]);
+    __real_midi_note_on(dacFmChannel, keys[2], 100);
+    expect_function_call(__wrap_SND_PCM_stopPlay);
+    __real_midi_note_off(dacFmChannel, keys[2]);
+
+    for (u8 i = 0; i < 3; i++) {
+        percussionPcmSample[keys[i]] = saved[i];
+    }
+}
+
+// Changing the driver resets the PSG behind the ROM: a sounding note is written again, and the
+// same note after the switch is written at all.
+void test_midi_dac_switch_rewrites_psg(UNUSED void** state)
+{
+    const u8 chan = MIN_PSG_CHAN;
+    const u8 psgChan = chan - MIN_PSG_CHAN;
+
+    expect_psg_tone(psgChan, TONE_NTSC_C4);
+    expect_psg_attenuation(psgChan, 0);
+    __real_midi_note_on(chan, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+
+    expect_value(__wrap_synth_enable_dac, enable, true);
+    expect_synth_stereo(5, STEREO_MODE_CENTRE);
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_CLOCK2);
+    expect_psg_tone(psgChan, TONE_NTSC_C4);
+    expect_psg_attenuation(psgChan, 0);
+    __real_midi_cc(0, 78, 0x7F);
+
+    expect_psg_attenuation(psgChan, PSG_ATTENUATION_SILENCE);
+    __real_midi_note_off(chan, MIDI_PITCH_C4);
+
+    expect_value(__wrap_synth_enable_dac, enable, false);
+    expect_synth_stereo(5, STEREO_MODE_CENTRE);
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_CLOCK2);
+    __real_midi_cc(0, 78, 0);
+
+    expect_psg_tone(psgChan, TONE_NTSC_C4);
+    expect_psg_attenuation(psgChan, 0);
+    __real_midi_note_on(chan, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+}
+
+void test_midi_dac_switch_rewrites_noise_on_tone3(UNUSED void** state)
+{
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_TONE3);
+    __real_midi_cc(GENERAL_MIDI_PERCUSSION_CHANNEL, 13, 96);
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_TONE3);
+    expect_psg_tone(PSG_CH3, 106);
+    expect_psg_attenuation(PSG_NOISE_CH4, 0);
+    __real_midi_note_on(GENERAL_MIDI_PERCUSSION_CHANNEL, 36, MAX_MIDI_VOLUME);
+
+    expect_value(__wrap_synth_enable_dac, enable, true);
+    expect_synth_stereo(5, STEREO_MODE_CENTRE);
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_TONE3);
+    expect_psg_tone(PSG_CH3, 106);
+    expect_psg_attenuation(PSG_NOISE_CH4, 0);
+    __real_midi_cc(0, 78, 0x7F);
+}
+
+static void expect_pcm_start_pan(SoundPanning pan, u8 loop)
+{
+    expect_any(__wrap_SND_PCM_startPlay, sample);
+    expect_any(__wrap_SND_PCM_startPlay, len);
+    expect_any(__wrap_SND_PCM_startPlay, rate);
+    expect_value(__wrap_SND_PCM_startPlay, pan, pan);
+    expect_value(__wrap_SND_PCM_startPlay, loop, loop);
+}
+
+// CC 10 on channel 6 pans the DAC as FM pan: 0-31 left, 32-95 centre, 96-127 right. B6 is
+// written at once, so a sounding sample moves, and the next sample starts there (stage 18).
+void test_midi_dac_pan_sets_b6_and_next_sample(UNUSED void** state)
+{
+    const u8 values[3] = { 0, 64, 127 };
+    const u8 modes[3] = { STEREO_MODE_LEFT, STEREO_MODE_CENTRE, STEREO_MODE_RIGHT };
+    const SoundPanning pans[3] = { SOUND_PAN_LEFT, SOUND_PAN_CENTER, SOUND_PAN_RIGHT };
+
+    for (u8 i = 0; i < 3; i++) {
+        expect_pcm_start_pan(i == 0 ? SOUND_PAN_CENTER : pans[i - 1], 0);
+        __real_midi_note_on(dacFmChannel, noteKey, 100);
+        expect_synth_stereo(dacFmChannel, modes[i]);
+        __real_midi_cc(dacFmChannel, CC_PAN, values[i]);
+        expect_function_call(__wrap_SND_PCM_stopPlay);
+        __real_midi_note_off(dacFmChannel, noteKey);
+    }
+    expect_pcm_start_pan(SOUND_PAN_RIGHT, 0);
+    __real_midi_note_on(dacFmChannel, noteKey, 100);
+}
+
+// A pan set while channel 6 is FM reaches the DAC when it is switched on (stage 18).
+void test_midi_dac_pan_before_enable_applies(UNUSED void** state)
+{
+    expect_synth_stereo(dacFmChannel, STEREO_MODE_LEFT);
+    __real_midi_cc(dacFmChannel, CC_PAN, 0);
+
+    expect_value(__wrap_synth_enable_dac, enable, true);
+    expect_synth_stereo(dacFmChannel, STEREO_MODE_LEFT);
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_CLOCK2);
+    __real_midi_cc(0, 78, 0x7F);
+
+    expect_pcm_start_pan(SOUND_PAN_LEFT, 0);
+    __real_midi_note_on(dacFmChannel, noteKey, 100);
+}
+
+// After the DAC is switched off, FM 6 gets its pan again: the driver swap reset the chip (stage 18).
+void test_midi_dac_disable_rewrites_fm_pan(UNUSED void** state)
+{
+    expect_synth_stereo(dacFmChannel, STEREO_MODE_RIGHT);
+    __real_midi_cc(dacFmChannel, CC_PAN, 127);
+
+    expect_value(__wrap_synth_enable_dac, enable, false);
+    expect_synth_stereo(dacFmChannel, STEREO_MODE_RIGHT);
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_CLOCK2);
+    __real_midi_cc(0, 78, 0);
+}
+
+// A LOOP sample goes to the driver with its loop flag and stops at Note Off (stage 18).
+void test_midi_dac_loop_sample_loops_until_note_off(UNUSED void** state)
+{
+    static const u8 data[512] = { 0 };
+    static const PcmSample looped = { data, sizeof(data), 1, PCM_LOOP };
+    const PcmSample* saved = percussionPcmSample[nullNoteKey];
+    percussionPcmSample[nullNoteKey] = &looped;
+
+    expect_value(__wrap_SND_PCM_startPlay, sample, data);
+    expect_value(__wrap_SND_PCM_startPlay, len, sizeof(data));
+    expect_value(__wrap_SND_PCM_startPlay, rate, 1);
+    expect_value(__wrap_SND_PCM_startPlay, pan, SOUND_PAN_CENTER);
+    expect_value(__wrap_SND_PCM_startPlay, loop, 1);
+    __real_midi_note_on(dacFmChannel, nullNoteKey, 100);
+    expect_function_call(__wrap_SND_PCM_stopPlay);
+    __real_midi_note_off(dacFmChannel, nullNoteKey);
+
+    percussionPcmSample[nullNoteKey] = saved;
+}
