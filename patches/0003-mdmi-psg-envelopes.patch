+// In CSM a CC AR, RS and a program change keep the voice's AR while the chip gets 31; the extracted
+// preset has the voice's AR, and leaving CSM writes it.
+void test_synth_csm_attack_rate_keeps_the_voice(UNUSED void** state)
+{
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x40);
+    __real_synth_set_special_mode(true);
+    expect_ch3_attack_rates(true);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x40);
+    __real_synth_set_csm(true);
+
+    expect_ym2612_write_operator(CH3_SPECIAL_MODE, 0, YM_BASE_ATTACK_RATE_SCALING_RATE, 0x5F);
+    __real_synth_operator_attack_rate(CH3_SPECIAL_MODE, 0, 10);
+    expect_ym2612_write_operator(CH3_SPECIAL_MODE, 0, YM_BASE_ATTACK_RATE_SCALING_RATE, 0x9F);
+    __real_synth_operator_rate_scaling(CH3_SPECIAL_MODE, 0, 2);
+    assert_int_equal(__real_synth_channel_parameters(CH3_SPECIAL_MODE)->operators[0].attackRate, 10);
+
+    FmPreset preset;
+    __real_synth_extract_preset(CH3_SPECIAL_MODE, &preset);
+    assert_int_equal(preset.operators[0].attackRate, 10);
+    assert_int_equal(preset.operators[1].attackRate, 24);
+    assert_int_equal(preset.operators[2].attackRate, 31);
+    assert_int_equal(preset.operators[3].attackRate, 27);
+
+    // A program change with AR 5-8: kept, the chip gets 31 with the program's RS.
+    for (u8 op = 0; op < MAX_FM_OPERATORS; op++) {
+        preset.operators[op].attackRate = 5 + op;
+        preset.operators[op].rateScaling = op;
+    }
+    expect_ym2612_write_channel_any_data(CH3_SPECIAL_MODE, YM_BASE_ALGORITHM_FEEDBACK);
+    expect_ym2612_write_channel_any_data(CH3_SPECIAL_MODE, YM_BASE_STEREO_AMS_PMS);
+    for (u8 op = 0; op < MAX_FM_OPERATORS; op++) {
+        expect_ym2612_write_operator_any_data(CH3_SPECIAL_MODE, op, YM_BASE_MULTIPLE_DETUNE);
+        expect_ym2612_write_operator(
+            CH3_SPECIAL_MODE, op, YM_BASE_ATTACK_RATE_SCALING_RATE, 0x1F | (op << 6));
+        expect_ym2612_write_operator_any_data(CH3_SPECIAL_MODE, op, YM_BASE_DECAY_RATE_AM_ENABLE);
+        expect_ym2612_write_operator_any_data(CH3_SPECIAL_MODE, op, YM_BASE_SUSTAIN_RATE);
+        expect_ym2612_write_operator_any_data(
+            CH3_SPECIAL_MODE, op, YM_BASE_RELEASE_RATE_SUSTAIN_LEVEL);
+        expect_ym2612_write_operator_any_data(CH3_SPECIAL_MODE, op, YM_BASE_TOTAL_LEVEL);
+        expect_ym2612_write_operator_any_data(CH3_SPECIAL_MODE, op, YM_BASE_SSG_EG);
+    }
+    __real_synth_preset(CH3_SPECIAL_MODE, &preset);
+    FmPreset extracted;
+    __real_synth_extract_preset(CH3_SPECIAL_MODE, &extracted);
+    for (u8 op = 0; op < MAX_FM_OPERATORS; op++) {
+        assert_int_equal(extracted.operators[op].attackRate, 5 + op);
+    }
+
+    for (u8 op = 0; op < MAX_FM_OPERATORS; op++) {
+        expect_ym2612_write_operator(
+            CH3_SPECIAL_MODE, op, YM_BASE_ATTACK_RATE_SCALING_RATE, (5 + op) | (op << 6));
+    }
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x40);
+    __real_synth_set_csm(false);
+}
+
+// Channels 1, 2, 4-6 in CSM, and channel 3 with CSM chosen but Ch3 Special off, write their AR.
+void test_synth_csm_attack_rate_only_on_channel_3(UNUSED void** state)
+{
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x40);
+    __real_synth_set_special_mode(true);
+    expect_ch3_attack_rates(true);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x40);
+    __real_synth_set_csm(true);
+    for (u8 chan = 0; chan < MAX_FM_CHANS; chan++) {
+        if (chan == CH3_SPECIAL_MODE) {
+            continue;
+        }
+        for (u8 op = 0; op < MAX_FM_OPERATORS; op++) {
+            expect_ym2612_write_operator(
+                chan, op, YM_BASE_ATTACK_RATE_SCALING_RATE, 20 | (CH3_VOICE_AR_RS[op] & 0xC0));
+            __real_synth_operator_attack_rate(chan, op, 20);
+        }
+    }
+
+    expect_ch3_attack_rates(false);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x00);
+    __real_synth_set_special_mode(false);
+    expect_ym2612_write_operator(CH3_SPECIAL_MODE, 1, YM_BASE_ATTACK_RATE_SCALING_RATE, 0x54);
+    __real_synth_operator_attack_rate(CH3_SPECIAL_MODE, 1, 20);
+}
