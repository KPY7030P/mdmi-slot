+
+// MDMI plugin fork, 2026-11-04: PSG envelopes stored per program.
+static void store_psg_envelope(u8 program, const u8* eef, u16 length)
+{
+    u8 msg[6 + (MAX_STORED_ENVELOPE_STEPS + 1) * 2];
+    u16 n = 0;
+    msg[n++] = SYSEX_MANU_EXTENDED;
+    msg[n++] = SYSEX_MANU_REGION;
+    msg[n++] = SYSEX_MANU_ID;
+    msg[n++] = SYSEX_COMMAND_STORE_PROGRAM;
+    msg[n++] = STORE_PROGRAM_TYPE_PSG;
+    msg[n++] = program;
+    for (u16 i = 0; i < length; i++) {
+        msg[n++] = eef[i] >> 4;
+        msg[n++] = eef[i] & 0x0F;
+    }
+    __real_midi_sysex(msg, n);
+}
+
+static void play_first_step(u8 midiChan, u8 psgChan, u8 attenuation)
+{
+    expect_psg_tone(psgChan, TONE_NTSC_C4);
+    expect_psg_attenuation(psgChan, attenuation);
+    __real_midi_note_on(midiChan, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+}
+
+void test_midi_sysex_stores_psg_envelope(UNUSED void** state)
+{
+    mock_log_enable_checks();
+    const u8 eef[] = { 0x06, 0x0F };
+    expect_log_info("Prg %d: PSG envelope stored");
+    store_psg_envelope(5, eef, sizeof(eef));
+    mock_log_disable_checks();
+
+    __real_midi_program(MIDI_CHANNEL_7, 5);
+    play_first_step(MIDI_CHANNEL_7, PSG_CH1, 6);
+
+    expect_psg_attenuation(PSG_CH1, PSG_ATTENUATION_SILENCE);
+    __real_midi_psg_tick();
+}
+
+void test_midi_sysex_stored_psg_envelopes_differ_per_channel(UNUSED void** state)
+{
+    const u8 eef1[] = { 0x03 };
+    const u8 eef2[] = { 0x09 };
+    store_psg_envelope(1, eef1, sizeof(eef1));
+    store_psg_envelope(2, eef2, sizeof(eef2));
+
+    __real_midi_program(MIDI_CHANNEL_7, 1);
+    __real_midi_program(MIDI_CHANNEL_7 + 1, 2);
+    play_first_step(MIDI_CHANNEL_7, PSG_CH1, 3);
+    play_first_step(MIDI_CHANNEL_7 + 1, PSG_CH1 + 1, 9);
+}
+
+void test_midi_sysex_reset_restores_default_psg_envelopes(UNUSED void** state)
+{
+    const u8 eef[] = { 0x05 };
+    store_psg_envelope(1, eef, sizeof(eef));
+
+    mock_synth_disable_checks();
+    __real_midi_reset();
+    mock_synth_enable_checks();
+
+    __real_midi_program(MIDI_CHANNEL_7, 1);
+    play_first_step(MIDI_CHANNEL_7, PSG_CH1, PSG_ATTENUATION_LOUDEST);
+}
+
+void test_midi_sysex_stores_longest_psg_envelope(UNUSED void** state)
+{
+    u8 eef[MAX_STORED_ENVELOPE_STEPS + 1];
+    memset(eef, 0x02, sizeof(eef));
+
+    mock_log_enable_checks();
+    expect_log_info("Prg %d: PSG envelope stored");
+    store_psg_envelope(4, eef, MAX_STORED_ENVELOPE_STEPS);
+    mock_log_disable_checks();
+
+    __real_midi_program(MIDI_CHANNEL_7, 4);
+    play_first_step(MIDI_CHANNEL_7, PSG_CH1, 2);
+}
+
+void test_midi_sysex_rejects_too_long_psg_envelope(UNUSED void** state)
+{
+    u8 eef[MAX_STORED_ENVELOPE_STEPS + 1];
+    memset(eef, 0x02, sizeof(eef));
+
+    mock_log_enable_checks();
+    expect_log_warn("Prg %d: Invalid PSG envelope");
+    store_psg_envelope(3, eef, sizeof(eef));
+
+    const u8 oddLength[] = { SYSEX_MANU_EXTENDED, SYSEX_MANU_REGION, SYSEX_MANU_ID,
+        SYSEX_COMMAND_STORE_PROGRAM, STORE_PROGRAM_TYPE_PSG, 0x03, 0x00, 0x02, 0x00 };
+    expect_log_warn("Prg %d: Invalid PSG envelope");
+    __real_midi_sysex(oddLength, sizeof(oddLength));
+    mock_log_disable_checks();
+
+    __real_midi_program(MIDI_CHANNEL_7, 3);
+    play_first_step(MIDI_CHANNEL_7, PSG_CH1, PSG_ATTENUATION_LOUDEST);
+}
+
+void test_midi_sysex_overwritten_psg_envelope_waits_for_next_note(UNUSED void** state)
+{
+    const u8 longer[] = { 0x01, 0x02, 0x03 };
+    const u8 shorter[] = { 0x04 };
+    store_psg_envelope(2, longer, sizeof(longer));
+
+    __real_midi_program(MIDI_CHANNEL_7, 2);
+    play_first_step(MIDI_CHANNEL_7, PSG_CH1, 1);
+    expect_psg_attenuation(PSG_CH1, 2);
+    __real_midi_psg_tick();
+
+    store_psg_envelope(2, shorter, sizeof(shorter));
+    expect_psg_attenuation(PSG_CH1, 3);
+    __real_midi_psg_tick();
+
+    expect_psg_attenuation(PSG_CH1, 4);
+    __real_midi_note_on(MIDI_CHANNEL_7, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+}
