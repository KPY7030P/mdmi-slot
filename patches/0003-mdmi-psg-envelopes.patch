+// A 68000 is slow: a cell costs a compare when it holds what it should, and three port writes when not.
+static inline __attribute__((always_inline)) bool cell_at(u16 offset, u16 attr)
+{
+    u16* const shadowed = shadow_at(offset);
+    if (*shadowed == attr) {
+        return TRUE;
+    }
+    if (words >= WORD_CEILING && ceilingOn) {
+        leftover = TRUE;
+        return FALSE;
+    }
+    // Plane A is 64 cells wide at 0xE000 (SGDK's layout): the address in one long write, its top
+    // bits 3 for all of it, and the word, straight to the ports.
+    vdp_write(((u32)(u16)(planeCtrl + (offset << 1)) << 16) | 3, attr);
+    *shadowed = attr;
+    words++;
+    return TRUE;
+}
 
