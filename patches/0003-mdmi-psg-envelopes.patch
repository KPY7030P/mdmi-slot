diff --git a/src/pcm_sample.h b/src/pcm_sample.h
index df535e9..a6089c0 100644
--- a/src/pcm_sample.h
+++ b/src/pcm_sample.h
@@ -1,10 +1,32 @@
 #pragma once
 #include "types.h"
 
+// flags: PCM_ONE_SHOT lets the sample play to its end whatever Note Off comes (MDMI plugin, D38).
+// PCM_LOOP repeats the sample until Note Off; its length is whole 256-byte blocks (stage 18).
+// The record stays 10 bytes, the flags byte was its padding.
+#define PCM_LOOP 0x01
+#define PCM_ONE_SHOT 0x02
+// PCM_MARKS: the record is a PcmMarked, the loop between two blocks of the sample, and what follows
+// the loop's end plays after Note Off (stage 18b). Only the plugin writes such records.
+#define PCM_MARKS 0x04
+
 typedef struct PcmSample {
     const u8* data;
     u32 length;
     u8 rate;
+    u8 flags;
 } PcmSample;
 
+// The plugin writes records 14 bytes apart, the marks big endian at +10 and +12.
+typedef struct PcmMarked {
+    PcmSample sample;
+    u16 loopStart;
+    u16 loopEnd;
+} PcmMarked;
+
+#ifdef __m68k__
+_Static_assert(sizeof(PcmSample) == 10, "the plugin writes 10-byte records");
+_Static_assert(sizeof(PcmMarked) == 14, "the plugin writes the marks at +10 and +12");
+#endif
+
 extern const PcmSample* percussionPcmSample[128];
