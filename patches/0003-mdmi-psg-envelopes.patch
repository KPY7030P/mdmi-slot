+// MDMI plugin fork, 2026-11-04: the length depends on the type, so it is checked here.
+static void store_psg_program(u8 program, const u8* data, u16 length)
+{
+    if (length % 2 != 0 || length / 2 > MAX_STORED_ENVELOPE_STEPS || program >= MIDI_PROGRAMS) {
+        log_warn("Prg %d: Invalid PSG envelope", program);
+        return;
+    }
+    u8 eef[MAX_STORED_ENVELOPE_STEPS];
+    for (u16 i = 0; i < length; i += 2) {
+        eef[i / 2] = (data[i] << 4) | data[i + 1];
+    }
+    midi_psg_store_envelope(program, eef, length / 2);
+    log_info("Prg %d: PSG envelope stored", program);
+}
+
+// MDMI plugin fork, stage 20: <loop> <step + 64>..., the number of steps is the length of the data.
+static void store_arp_row(bool fm, u8 program, const u8* data, u16 length)
+{
+    u16 count = length > 0 ? length - 1 : 0;
+    bool valid = length > 0 && count <= MAX_ARP_STEPS && program < MIDI_PROGRAMS
+        && (data[0] == ARP_NO_LOOP || data[0] < count);
+    for (u16 i = 1; valid && i < length; i++) {
+        valid = data[i] >= ARP_STEP_CENTRE - MAX_ARP_SHIFT
+            && data[i] <= ARP_STEP_CENTRE + MAX_ARP_SHIFT;
+    }
+    if (!valid) {
+        if (fm) {
+            log_warn("Prg %d: Invalid FM arpeggio", program);
+        } else {
+            log_warn("Prg %d: Invalid PSG arpeggio", program);
+        }
+        return;
+    }
+    ArpRow* row = fm ? &fmArpRows[program] : &psgArpRows[program];
+    row->count = count;
+    row->loop = data[0];
+    for (u16 i = 0; i < count; i++) {
+        row->steps[i] = data[i + 1] - ARP_STEP_CENTRE;
+    }
+    if (fm) {
+        log_info("Prg %d: FM arpeggio stored", program);
+    } else {
+        log_info("Prg %d: PSG arpeggio stored", program);
+    }
+}
+
 static void store_program(const u8* data, u16 length)
 {
+    if (length < STORE_PROGRAM_HEADER_LENGTH) {
+        log_warn("Sysex %02X: Invalid length: %d (!= %d)", SYSEX_COMMAND_STORE_PROGRAM, length,
+            STORE_PROGRAM_FM_LENGTH);
+        return;
+    }
     u8 type = data[0];
     u8 program = data[1];
 
     switch (type) {
+    case STORE_PROGRAM_TYPE_PSG:
+        store_psg_program(program, data + STORE_PROGRAM_HEADER_LENGTH,
+            length - STORE_PROGRAM_HEADER_LENGTH);
+        break;
+    case STORE_PROGRAM_TYPE_FM_ARP:
+    case STORE_PROGRAM_TYPE_PSG_ARP:
+        store_arp_row(type == STORE_PROGRAM_TYPE_FM_ARP, program,
+            data + STORE_PROGRAM_HEADER_LENGTH, length - STORE_PROGRAM_HEADER_LENGTH);
+        break;
     case STORE_PROGRAM_TYPE_FM: {
+        if (length != STORE_PROGRAM_FM_LENGTH) {
+            log_warn("Sysex %02X: Invalid length: %d (!= %d)", SYSEX_COMMAND_STORE_PROGRAM, length,
+                STORE_PROGRAM_FM_LENGTH);
+            return;
+        }
         FmPreset fmPreset;
         fmPreset.algorithm = data[2];
         fmPreset.feedback = data[3];
