+// Stage 19: samples for the voice tests, 256 bytes each, aligned as the driver needs.
+static const u8 data[6][256] __attribute__((aligned(256))) = { { 0 } };
+static const PcmSample plain[6] = { { data[0], 256, 1, 0 }, { data[1], 256, 1, 0 }, { data[2], 256, 1, 0 },
+    { data[3], 256, 1, 0 }, { data[4], 256, 1, 0 }, { data[5], 256, 1, PCM_ONE_SHOT } };
+static const u8 keys[6] = { 36, 38, 40, 41, 43, 45 };
+static const PcmSample* saved[6];
+
+static void use_samples(void)
+{
+    for (u8 i = 0; i < 6; i++) {
+        saved[i] = percussionPcmSample[keys[i]];
+        percussionPcmSample[keys[i]] = &plain[i];
+    }
+}
+
+static void put_back(void)
+{
+    for (u8 i = 0; i < 6; i++) {
+        percussionPcmSample[keys[i]] = saved[i];
+    }
+    mock_pcm_driver_reset();
+}
+
+static u16 block_of(u8 i)
+{
+    return (u16)((u32)(long)data[i] >> 8);
+}
+
+// The driver takes every start: clears the commands, copies, sets playing.
+static void driver_takes(void)
+{
+    const u8 command = mock_pcm_ram[PCM_DRV_COMMAND];
+    for (u8 v = 0; v < PCM_DRV_VOICES; v++) {
+        if (command & (1 << v)) {
+            mock_pcm_write16(PCM_DRV_IWAVADR(v), mock_pcm_read16(PCM_DRV_WAVADR(v)));
+            mock_pcm_write16(PCM_DRV_IWAVLEN(v), mock_pcm_read16(PCM_DRV_WAVLEN(v)));
+        }
+    }
+    mock_pcm_ram[PCM_DRV_STATUS] |= command;
+    mock_pcm_ram[PCM_DRV_COMMAND] = 0;
+}
+
+static int voice_of(u8 i)
+{
+    for (u8 v = 0; v < PCM_DRV_VOICES; v++) {
+        if (mock_pcm_read16(PCM_DRV_WAVADR(v)) == block_of(i)) {
+            return v;
+        }
+    }
+    return -1;
+}
