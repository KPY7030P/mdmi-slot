diff --git a/src/pcm_driver.c b/src/pcm_driver.c
new file mode 100644
index 0000000..64e2787
--- /dev/null
+++ b/src/pcm_driver.c
@@ -0,0 +1,28 @@
+#include "pcm_driver.h"
+#include "genesis.h"
+
+u8 pcm_driver_read(u16 address)
+{
+    return *(vu8*)(long)(Z80_RAM + address);
+}
+
+void pcm_driver_write(u16 address, u8 value)
+{
+    *(vu8*)(long)(Z80_RAM + address) = value;
+}
+
+// Only the Z80's RAM is touched, never the YM2612, so the driver's 0x2A latch stays as it was.
+void pcm_driver_take(void)
+{
+    Z80_requestBus(TRUE);
+}
+
+void pcm_driver_give(void)
+{
+    Z80_releaseBus();
+}
+
+void pcm_driver_wait_us(u16 us)
+{
+    waitSubTick(((u32)us * SUBTICKPERSECOND + 999999) / 1000000);
+}
diff --git a/src/pcm_driver.h b/src/pcm_driver.h
new file mode 100644
index 0000000..6e06792
--- /dev/null
+++ b/src/pcm_driver.h
@@ -0,0 +1,24 @@
+#pragma once
+#include "types.h"
+
+// SGDK 2.00 drv_pcm's RAM as the 68000 reaches it, for samples with loop marks (MDMI plugin, stage
+// 18b, docs/research/drv-pcm-loop-marks.md in the plugin). Addresses are the Z80's; u16 values are
+// little endian. Lengths and addresses count 256-byte blocks. The unit tests wrap these functions.
+#define PCM_DRV_COMMAND 0x0100 // bit 0 play
+#define PCM_DRV_STATUS 0x0102 // bit 0 playing: set by the driver after it copied the params
+#define PCM_DRV_LOOP 0x0103 // bit 0 loop
+#define PCM_DRV_WAVADR 0x0104
+#define PCM_DRV_WAVLEN 0x0106
+#define PCM_DRV_RATE 0x0108
+#define PCM_DRV_PAN 0x010A
+#define PCM_DRV_IWAVADR 0x0114 // the block playing
+#define PCM_DRV_IWAVLEN 0x0116 // blocks left in this pass
+#define PCM_DRV_NULLWAVADR 0x0124
+
+u8 pcm_driver_read(u16 address);
+void pcm_driver_write(u16 address, u8 value);
+// The Z80's bus, held across a few reads and writes of its RAM.
+void pcm_driver_take(void);
+void pcm_driver_give(void);
+// Busy waits with the bus given back, so the driver runs on.
+void pcm_driver_wait_us(u16 us);
