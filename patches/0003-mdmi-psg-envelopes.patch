+    expect_synth_pitch(chan, 4, 0x2a9);
+    expect_synth_volume_any();
+    expect_synth_note_on(chan);
+    __real_midi_note_on(chan, MIDI_PITCH_CS4, MAX_MIDI_VOLUME);
+    expect_synth_pitch(chan, 6, 0x47a);
+    expect_synth_volume_any();
+    expect_synth_note_on(chan);
+    __real_midi_note_on(chan, MIDI_PITCH_AS6, MAX_MIDI_VOLUME);
+
+    __real_midi_note_off(chan, MIDI_PITCH_C4);
+
+    expect_synth_pitch(chan, 4, 0x2a9);
+    expect_synth_volume_any();
+    expect_synth_note_on(chan);
+    __real_midi_note_off(chan, MIDI_PITCH_AS6);
+
+    expect_value(__wrap_synth_note_off, channel, chan);
+    __real_midi_note_off(chan, MIDI_PITCH_CS4);
+}
