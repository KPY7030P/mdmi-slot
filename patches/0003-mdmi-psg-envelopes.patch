+// Generated by tools/gen_rom_screen.py (MDMI plugin, stage 24a). Do not edit.
+#pragma once
+
+// Where the screen's own tiles start in VRAM (rom-screen.md 10.3).
+#define UI_TILE_BASE 16
+#define UI_T_NOTE (UI_TILE_BASE + 0)
+#define UI_T_DAC_NOTE (UI_TILE_BASE + 60)
+#define UI_T_DAC_DIM (UI_TILE_BASE + 80)
+#define UI_T_DASH (UI_TILE_BASE + 100)
+#define UI_T_OWNER (UI_TILE_BASE + 101)
+#define UI_T_STRIPE (UI_TILE_BASE + 165)
+#define UI_T_BRACKET (UI_TILE_BASE + 169)
+#define UI_T_LABEL_FM (UI_TILE_BASE + 172)
+#define UI_T_LABEL_PSG (UI_TILE_BASE + 177)
+#define UI_T_LEVEL (UI_TILE_BASE + 180)
+#define UI_T_BAR (UI_TILE_BASE + 225)
+#define UI_T_SQUARE (UI_TILE_BASE + 240)
+#define UI_T_WAVE (UI_TILE_BASE + 246)
+#define UI_T_END (UI_TILE_BASE + 343)
+#define UI_TILE_COUNT 343
+// Stage 24a2: the ribbon's patterns from 384, the hold tile and the noise's (rom-screen.md 10.3).
+#define UI_TILE_B_BASE 384
+#define UI_T_RIBBON (UI_TILE_B_BASE + 0)
+#define UI_T_HOLD (UI_TILE_B_BASE + 256)
+#define UI_T_NOISE (UI_TILE_B_BASE + 257)
+#define UI_T_B_END (UI_TILE_B_BASE + 265)
+#define UI_TILE_B_COUNT 265
+// Stage 24a3: the CC 83 view's algorithm pictures from 1285 (rom-screen.md 10.3).
+#define UI_TILE_C_BASE 1285
+#define UI_T_ALGO (UI_TILE_C_BASE + 0)
+#define UI_T_C_END (UI_TILE_C_BASE + 51)
+#define UI_TILE_C_COUNT 51
+#define UI_ALGO_COLS 6
+#define UI_ALGO_ROWS 4
+#define UI_FLASH_FRAMES 21
+#define UI_RELEASE_FRAMES 14
+#define UI_NOISE_SHUFFLES 8
+#define UI_NOTE_GLYPHS 20
+#define UI_GLYPH_QUESTION 19
+#define UI_GLYPH_DASH 18
+#define UI_LEVEL_PATTERNS 15
+#define UI_WAVE_CLASSES 13
+#define UI_WAVE_FLAT 0
+
+// The plugin's tests read the tile numbers alone.
+#ifndef UI_TILE_NUMBERS_ONLY
+#include "genesis.h"
+extern const u32 UI_TILES[UI_TILE_COUNT * 8];
+extern const u16 UI_PALETTE[64];
+// A key's name as 3 note glyphs: C-4, C#4, ??? below A0.
+extern const u8 UI_NOTE[128][3];
+// A tile of a 16-stripe bar: its pattern by how many of its 4 stripes are lit and where
+// the peak is, +1 (0 none).
+extern const s8 UI_LEVEL_PATTERN[5][5];
+// The tone period below which the wave has the next class, from A2's class 0 up.
+extern const u16 UI_WAVE_PERIOD[UI_WAVE_CLASSES - 1];
+// The wave's 4 tiles from UI_T_WAVE by class and height (3, 5, 7 points).
+extern const u8 UI_WAVE[UI_WAVE_CLASSES][3][4];
+extern const u32 UI_TILES_B[UI_TILE_B_COUNT * 8];
+extern const u32 UI_TILES_C[UI_TILE_C_COUNT * 8];
+// The YM2612's envelope for the screen's estimate (24a3): an attack's frames and its step, a
+// decay's frames over 0..1023 and its step by effective rate (D1R, D2R 2n; RR 4n + 2); steps
+// are attenuation a frame in 10.6 fixed point. 65536 / n for fractions.
+extern const u8 UI_ATTACK_FRAMES[32];
+extern const u16 UI_ATTACK_STEP[32];
+extern const u16 UI_DECAY_FRAMES[64];
+extern const u16 UI_DECAY_STEP[64];
+extern const u16 UI_RECIP[251];
+extern const u32 UI_NIBBLES[256];
+// An algorithm's picture, 6 x 4 cells by row: 0 empty, else the tile from UI_T_ALGO, + 1.
+extern const u8 UI_ALGO[8][UI_ALGO_COLS * UI_ALGO_ROWS];
+// A live note cell's colour by chip (FM, PSG, Ch3 Special): frames since the hit toward the held
+// colour [0] or the dim one [1]; frames since the release from held to dim; held and dim.
+extern const u16 UI_FLASH[3][2][UI_FLASH_FRAMES];
+extern const u16 UI_RELEASE[3][UI_RELEASE_FRAMES];
+extern const u16 UI_LIVE_HELD[3];
+extern const u16 UI_LIVE_DIM[3];
+// The noise's 4 cells PAL3 12-15 by loudness step: periodic by phase, white by shuffle; silent.
+extern const u16 UI_NOISE_PERIODIC[4][4][4];
+extern const u16 UI_NOISE_WHITE[4][UI_NOISE_SHUFFLES][4];
+extern const u16 UI_NOISE_SILENT[2][4];
+#endif
