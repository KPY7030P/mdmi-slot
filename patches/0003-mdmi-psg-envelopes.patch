@@ -0,0 +1,476 @@
+// MDMI plugin fork, stage 20: arpeggio rows of FM and PSG programs, SysEx 0A 02 and 0A 03.
+#include "test_midi_arp.h"
+#include "test_midi.h"
+#include "mocks/mock_sgdk.h"
+
+#define FM_MIDI_CHAN MIDI_CHANNEL_1
+#define CH3_MIDI_CHAN MIDI_CHANNEL_3
+#define DAC_MIDI_CHAN MIDI_CHANNEL_6
+#define PSG_MIDI_CHAN MIDI_CHANNEL_7
+#define NOISE_MIDI_CHAN GENERAL_MIDI_PERCUSSION_CHANNEL
+#define OP_MIDI_CHAN MIDI_CHANNEL_11
+#define NO_LOOP ARP_NO_LOOP
+
+// PSG tones of C4, D#4, E4, G4 and C5 (TONES_NTSC in midi_psg.c).
+#define TONE_C4 427
+#define TONE_DS4 359
+#define TONE_E4 339
+#define TONE_G4 285
+#define TONE_C5 213
+
+static void store_row_raw(u8 type, u8 program, u8 loop, const s8* steps, u16 count)
+{
+    u8 msg[7 + MAX_ARP_STEPS + 8];
+    u16 n = 0;
+    msg[n++] = SYSEX_MANU_EXTENDED;
+    msg[n++] = SYSEX_MANU_REGION;
+    msg[n++] = SYSEX_MANU_ID;
+    msg[n++] = SYSEX_COMMAND_STORE_PROGRAM;
+    msg[n++] = type;
+    msg[n++] = program;
+    msg[n++] = loop;
+    for (u16 i = 0; i < count; i++) {
+        msg[n++] = steps[i] + ARP_STEP_CENTRE;
+    }
+    __real_midi_sysex(msg, n);
+}
+
+static void store_fm_row(u8 program, u8 loop, const s8* steps, u16 count)
+{
+    store_row_raw(STORE_PROGRAM_TYPE_FM_ARP, program, loop, steps, count);
+}
+
+static void store_psg_row(u8 program, u8 loop, const s8* steps, u16 count)
+{
+    store_row_raw(STORE_PROGRAM_TYPE_PSG_ARP, program, loop, steps, count);
+}
+
+static void fm_note_on(u8 pitch, u8 octave, u16 freq)
+{
+    expect_synth_pitch(FM_CH1, octave, freq);
+    expect_synth_volume_any();
+    expect_synth_note_on(FM_CH1);
+    __real_midi_note_on(FM_MIDI_CHAN, pitch, MAX_MIDI_VOLUME);
+}
+
+static void fm_tick(u8 octave, u16 freq)
+{
+    expect_synth_pitch(FM_CH1, octave, freq);
+    midi_tick(1);
+}
+
+static void psg_note_on(u8 pitch, u16 tone)
+{
+    expect_psg_tone(PSG_CH1, tone);
+    expect_psg_attenuation(PSG_CH1, PSG_ATTENUATION_LOUDEST);
+    __real_midi_note_on(PSG_MIDI_CHAN, pitch, MAX_MIDI_VOLUME);
+}
+
+static void psg_tick(u16 tone)
+{
+    expect_psg_tone(PSG_CH1, tone);
+    midi_tick(1);
+}
+
+// No expectation is set, so any pitch or tone write fails the test.
+static void ticks_without_writes(u16 count)
+{
+    for (u16 i = 0; i < count; i++) {
+        midi_tick(1);
+    }
+}
+
+void test_midi_arp_stores_fm_row(UNUSED void** state)
+{
+    const s8 steps[] = { 0, 3, 4, 7, 12 };
+    mock_log_enable_checks();
+    expect_log_info("Prg %d: FM arpeggio stored");
+    store_fm_row(0, 0, steps, sizeof(steps));
+    mock_log_disable_checks();
+
+    fm_note_on(MIDI_PITCH_C4, 4, SYNTH_NTSC_C);
+    fm_tick(4, SYNTH_NTSC_DS);
+    fm_tick(4, SYNTH_NTSC_E);
+    fm_tick(4, SYNTH_NTSC_G);
+    fm_tick(5, SYNTH_NTSC_C);
+    fm_tick(4, SYNTH_NTSC_C);
+    fm_tick(4, SYNTH_NTSC_DS);
+}
+
+void test_midi_arp_stores_psg_row(UNUSED void** state)
+{
+    const s8 steps[] = { 3, 4, 7, 12 };
+    mock_log_enable_checks();
+    expect_log_info("Prg %d: PSG arpeggio stored");
+    store_psg_row(0, NO_LOOP, steps, sizeof(steps));
+    mock_log_disable_checks();
+
+    psg_note_on(MIDI_PITCH_C4, TONE_DS4);
+    psg_tick(TONE_E4);
+    psg_tick(TONE_G4);
+    psg_tick(TONE_C5);
+    ticks_without_writes(10);
+}
