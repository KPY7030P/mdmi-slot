+// Stage 24a3: a number's digits without sprintf or division (hundreds, tens, ones by
+// subtraction), right-aligned in width cells or left-aligned and padded.
+static void number_text(char* out, u8 value, u8 width, bool left)
+{
+    static const u8 POWERS[] = { 100, 10, 1 };
+    char digits[3];
+    u8 n = 0;
+    for (u8 p = 0; p < 3; p++) {
+        char digit = '0';
+        while (value >= POWERS[p]) {
+            value -= POWERS[p];
+            digit++;
+        }
+        if (digit != '0' || n || p == 2) {
+            digits[n++] = digit;
+        }
+    }
+    u8 i = 0;
+    if (!left) {
+        for (; i + n < width; i++) {
+            out[i] = ' ';
+        }
+    }
+    for (u8 d = 0; d < n; d++) {
+        out[i++] = digits[d];
+    }
+    for (; i < width; i++) {
+        out[i] = ' ';
+    }
+    out[i] = 0;
+}
