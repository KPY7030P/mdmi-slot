 void synth_note_on(u8 channel)
 {
+    if (channel == CH3_SPECIAL_MODE) {
+        ch3Keys = 0xF;
+        write_ch3_keys();
+        return;
+    }
     write_reg_safe(0, YM_KEY_ON_OFF, 0xF0 + key_on_off_reg_offset(channel));
 }
 
 void synth_note_off(u8 channel)
 {
+    if (channel == CH3_SPECIAL_MODE) {
+        ch3Keys = 0;
+        write_ch3_keys();
+        return;
+    }
     write_reg_safe(0, YM_KEY_ON_OFF, key_on_off_reg_offset(channel));
 }
 
+void synth_special_mode_note_on(u8 op)
+{
+    ch3Keys |= 1 << op;
+    write_ch3_keys();
+}
+
+void synth_special_mode_note_off(u8 op)
+{
+    ch3Keys &= ~(1 << op);
+    write_ch3_keys();
+}
+
+// In CSM the ROM never writes 0x28 for channel 3: the note goes by the mode bits instead.
+void synth_special_mode_keys_off(void)
+{
+    if (global.specialMode && csm) {
+        synth_csm_note_off();
+        return;
+    }
+    synth_note_off(CH3_SPECIAL_MODE);
+}
+
+static bool csm_runs(void)
+{
+    return global.specialMode && csm && csmNote;
+}
+
+static void write_ch3_mode_reg(u8 once)
+{
+    u8 mode = !global.specialMode ? 0
+        : csm_runs()              ? CH3_MODE_CSM | CH3_MODE_TIMER_A
+                                  : CH3_MODE_SPECIAL;
+    write_reg_safe(0, YM_CH3_MODE, mode | ch3ModeKept | once);
+}
+
+void synth_set_csm(bool enable)
+{
+    if (csm == enable) {
+        return;
+    }
+    bool override = csm_attack_override();
+    csm = enable;
+    csmNote = false;
+    if (override != csm_attack_override()) {
+        write_ch3_attack_rates();
+    }
+    write_ch3_mode_reg(0);
+}
+
+// 0x24 and 0x25 in a row; a running timer takes them at its next reload, so its phase is kept.
+void synth_csm_timer(u16 timerA)
+{
+    write_reg_safe(0, YM_TIMER_A_MSB, timerA >> 2);
+    write_reg_safe(0, YM_TIMER_A_LSB, timerA & 3);
+}
+
+// Timer A starts with an overflow at once, which keys the four operators. A note over a sounding
+// one keeps the timer running: writing bit 0 again would not restart it anyway.
+void synth_csm_note_on(void)
+{
+    if (csmNote) {
+        return;
+    }
+    csmNote = true;
+    write_ch3_mode_reg(0);
+}
+
+// Back to 01: in BlastEm stopping the timer alone can leave the operators keyed (the experiment of
+// stage 22: 7 stops of 200), leaving CSM releases them.
+void synth_csm_note_off(void)
+{
+    csmNote = false;
+    write_ch3_mode_reg(0);
+}
+
+// Stage 21: LFO off and straight back on, no wait of our own. SGDK's write already waits out the
+// chip's busy time (about 25 us), longer than the one timer tick BlastEm needs to zero the LFO step
+// (docs/research/ch3-csm.md, plugin repository).
+void synth_reset_lfo(void)
+{
+    if (!global.lfoEnable) {
+        return;
+    }
+    write_reg_safe(0, YM_LFO_ENABLE, global.lfoFrequency);
+    write_global_lfo();
