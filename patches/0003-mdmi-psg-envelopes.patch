+    expect_synth_special_mode_keys_off();
+    __real_midi_cc(FM_MIDI_CHAN, CC_GENMDM_CH3_SPECIAL_MODE, 127);
+
+    expect_synth_pitch(FM_CH3, 4, SYNTH_NTSC_C);
+    expect_synth_special_mode_volume(3, MAX_MIDI_VOLUME);
+    expect_synth_special_mode_note_on(3);
+    __real_midi_note_on(CH3_MIDI_CHAN, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+
+    expect_synth_special_mode_pitch(0, 4, SYNTH_NTSC_C);
+    expect_synth_special_mode_volume(0, MAX_MIDI_VOLUME);
+    expect_synth_special_mode_note_on(0);
+    __real_midi_note_on(OP_MIDI_CHAN, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+
+    ticks_without_writes(100);
+}
