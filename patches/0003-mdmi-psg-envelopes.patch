+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x81);
+    midi_rx_read();
+
+    // MIDI 11-13 write nothing.
+    stub_usb_receive_note_on(MIDI_CHANNEL_11, MIDI_PITCH_C4, 120);
+    midi_rx_read();
+    stub_usb_receive_note_off(MIDI_CHANNEL_11, MIDI_PITCH_C4);
+    midi_rx_read();
+
+    // Bend +2: B4, NA 916, the timer keeps running.
+    stub_usb_receive_pitch_bend(MIDI_CHANNEL_3, 0x4000);
+    expect_ch3_formants();
+    expect_timer_a(916);
+    midi_rx_read();
+    stub_usb_receive_pitch_bend(MIDI_CHANNEL_3, 0x2000);
+    expect_ch3_formants();
+    expect_timer_a(903);
+    midi_rx_read();
+
+    stub_usb_receive_note_off(MIDI_CHANNEL_3, 69);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x40);
+    midi_rx_read();
+
+    // A raw 0x27 = 0x0A: its bits 1-3 stay from now on.
+    receive_raw_ch3_mode(0x0A);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x4A);
+    midi_rx_read();
+
+    // A5 (NA 963), A6 over it (NA 994), A6 off raises A5: only 0x24/0x25 under the note.
+    stub_usb_receive_note_on(MIDI_CHANNEL_3, 81, MIDI_VELOCITY_MAX);
+    expect_ch3_formants();
+    expect_timer_a(963);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x8B);
+    midi_rx_read();
+    stub_usb_receive_note_on(MIDI_CHANNEL_3, 93, MIDI_VELOCITY_MAX);
+    expect_ch3_formants();
+    expect_timer_a(994);
+    midi_rx_read();
+    stub_usb_receive_note_off(MIDI_CHANNEL_3, 93);
+    expect_ch3_formants();
+    expect_timer_a(963);
+    midi_rx_read();
+    stub_usb_receive_note_off(MIDI_CHANNEL_3, 81);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x4A);
+    midi_rx_read();
+
+    // Below note 32 NA 0. CC 80 off under the note: CSM off first, then Ch3 Special.
+    stub_usb_receive_note_on(MIDI_CHANNEL_3, 20, MIDI_VELOCITY_MAX);
+    expect_ch3_formants();
+    expect_timer_a(0);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x8B);
+    midi_rx_read();
+    stub_usb_receive_cc(MIDI_CHANNEL_1, CC_GENMDM_CH3_SPECIAL_MODE, 0);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x4A);
+    expect_ch3_attack_rates();
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x0A);
+    midi_rx_read();
+
+    // Ch3 Special on again with CSM still chosen: 01, no note.
+    stub_usb_receive_cc(MIDI_CHANNEL_1, CC_GENMDM_CH3_SPECIAL_MODE, SPECIAL_MODE_ON);
+    expect_ym2612_write_reg(0, YM_KEY_ON_OFF, 0x02);
+    expect_ch3_attack_rates();
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x4A);
+    midi_rx_read();
+
+    // CC 81 to OPS under a CSM note: the note goes off by the mode, CSM leaves.
+    stub_usb_receive_note_on(MIDI_CHANNEL_3, 69, MIDI_VELOCITY_MAX);
+    expect_ch3_formants();
+    expect_timer_a(903);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x8B);
+    midi_rx_read();
+    stub_usb_receive_cc(MIDI_CHANNEL_1, CC_CH3_NOTES, 0);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x4A);
+    expect_ch3_attack_rates();
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x4A);
+    midi_rx_read();
+    stub_usb_receive_note_off(MIDI_CHANNEL_3, 69);
+    midi_rx_read();
+}
