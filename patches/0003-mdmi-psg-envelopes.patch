+    expect_z80_get_and_request_bus(TRUE, false);
+    expect_ym2612_write_reg(0, YM_DAC_ENABLE, 0x80);
+    expect_ym2612_latch_dac_data();
+    expect_z80_release_bus();
+    expect_z80_get_and_request_bus(TRUE, false);
+    expect_ym2612_write_reg(0, YM_CH3_MODE, 0x4A);
+    expect_ym2612_latch_dac_data();
