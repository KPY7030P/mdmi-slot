diff --git a/tests/unit/test_midi_arp.c b/tests/unit/test_midi_arp.c
new file mode 100644
index 0000000..e2dd68d
--- /dev/null
+++ b/tests/unit/test_midi_arp.c
@@ -0,0 +1,476 @@
+// MDMI plugin fork, stage 20: arpeggio rows of FM and PSG programs, SysEx 0A 02 and 0A 03.
+#include "test_midi_arp.h"
+#include "test_midi.h"
+#include "mocks/mock_sgdk.h"
+
+#define FM_MIDI_CHAN MIDI_CHANNEL_1
+#define CH3_MIDI_CHAN MIDI_CHANNEL_3
+#define DAC_MIDI_CHAN MIDI_CHANNEL_6
+#define PSG_MIDI_CHAN MIDI_CHANNEL_7
+#define NOISE_MIDI_CHAN GENERAL_MIDI_PERCUSSION_CHANNEL
+#define OP_MIDI_CHAN MIDI_CHANNEL_11
+#define NO_LOOP ARP_NO_LOOP
+
+// PSG tones of C4, D#4, E4, G4 and C5 (TONES_NTSC in midi_psg.c).
+#define TONE_C4 427
+#define TONE_DS4 359
+#define TONE_E4 339
+#define TONE_G4 285
+#define TONE_C5 213
+
+static void store_row_raw(u8 type, u8 program, u8 loop, const s8* steps, u16 count)
+{
+    u8 msg[7 + MAX_ARP_STEPS + 8];
+    u16 n = 0;
+    msg[n++] = SYSEX_MANU_EXTENDED;
+    msg[n++] = SYSEX_MANU_REGION;
+    msg[n++] = SYSEX_MANU_ID;
+    msg[n++] = SYSEX_COMMAND_STORE_PROGRAM;
+    msg[n++] = type;
+    msg[n++] = program;
+    msg[n++] = loop;
+    for (u16 i = 0; i < count; i++) {
+        msg[n++] = steps[i] + ARP_STEP_CENTRE;
+    }
+    __real_midi_sysex(msg, n);
+}
+
+static void store_fm_row(u8 program, u8 loop, const s8* steps, u16 count)
+{
+    store_row_raw(STORE_PROGRAM_TYPE_FM_ARP, program, loop, steps, count);
+}
+
+static void store_psg_row(u8 program, u8 loop, const s8* steps, u16 count)
+{
+    store_row_raw(STORE_PROGRAM_TYPE_PSG_ARP, program, loop, steps, count);
+}
+
+static void fm_note_on(u8 pitch, u8 octave, u16 freq)
+{
+    expect_synth_pitch(FM_CH1, octave, freq);
+    expect_synth_volume_any();
+    expect_synth_note_on(FM_CH1);
+    __real_midi_note_on(FM_MIDI_CHAN, pitch, MAX_MIDI_VOLUME);
+}
+
+static void fm_tick(u8 octave, u16 freq)
+{
+    expect_synth_pitch(FM_CH1, octave, freq);
+    midi_tick(1);
+}
+
+static void psg_note_on(u8 pitch, u16 tone)
+{
+    expect_psg_tone(PSG_CH1, tone);
+    expect_psg_attenuation(PSG_CH1, PSG_ATTENUATION_LOUDEST);
+    __real_midi_note_on(PSG_MIDI_CHAN, pitch, MAX_MIDI_VOLUME);
+}
+
+static void psg_tick(u16 tone)
+{
+    expect_psg_tone(PSG_CH1, tone);
+    midi_tick(1);
+}
+
+// No expectation is set, so any pitch or tone write fails the test.
+static void ticks_without_writes(u16 count)
+{
+    for (u16 i = 0; i < count; i++) {
+        midi_tick(1);
+    }
+}
+
+void test_midi_arp_stores_fm_row(UNUSED void** state)
+{
+    const s8 steps[] = { 0, 3, 4, 7, 12 };
+    mock_log_enable_checks();
+    expect_log_info("Prg %d: FM arpeggio stored");
+    store_fm_row(0, 0, steps, sizeof(steps));
+    mock_log_disable_checks();
+
+    fm_note_on(MIDI_PITCH_C4, 4, SYNTH_NTSC_C);
+    fm_tick(4, SYNTH_NTSC_DS);
+    fm_tick(4, SYNTH_NTSC_E);
+    fm_tick(4, SYNTH_NTSC_G);
+    fm_tick(5, SYNTH_NTSC_C);
+    fm_tick(4, SYNTH_NTSC_C);
+    fm_tick(4, SYNTH_NTSC_DS);
+}
+
+void test_midi_arp_stores_psg_row(UNUSED void** state)
+{
+    const s8 steps[] = { 3, 4, 7, 12 };
+    mock_log_enable_checks();
+    expect_log_info("Prg %d: PSG arpeggio stored");
+    store_psg_row(0, NO_LOOP, steps, sizeof(steps));
+    mock_log_disable_checks();
+
+    psg_note_on(MIDI_PITCH_C4, TONE_DS4);
+    psg_tick(TONE_E4);
+    psg_tick(TONE_G4);
+    psg_tick(TONE_C5);
+    ticks_without_writes(10);
+}
+
+void test_midi_arp_no_steps_clears_row(UNUSED void** state)
+{
+    const s8 steps[] = { 0, 7 };
+    store_fm_row(0, 0, steps, sizeof(steps));
+    store_psg_row(0, 0, steps, sizeof(steps));
+
+    mock_log_enable_checks();
+    expect_log_info("Prg %d: FM arpeggio stored");
+    store_fm_row(0, NO_LOOP, NULL, 0);
+    expect_log_info("Prg %d: PSG arpeggio stored");
+    store_psg_row(0, NO_LOOP, NULL, 0);
+    mock_log_disable_checks();
+
+    fm_note_on(MIDI_PITCH_C4, 4, SYNTH_NTSC_C);
+    psg_note_on(MIDI_PITCH_C4, TONE_C4);
+    ticks_without_writes(10);
+}
+
+void test_midi_arp_rejects_invalid_rows(UNUSED void** state)
+{
+    const s8 kept[] = { 12 };
+    store_fm_row(0, NO_LOOP, kept, sizeof(kept));
+    store_psg_row(0, NO_LOOP, kept, sizeof(kept));
+
+    s8 tooLong[MAX_ARP_STEPS + 1];
+    memset(tooLong, 7, sizeof(tooLong));
+    const s8 two[] = { 0, 7 };
+    const s8 tooHigh[] = { 0, MAX_ARP_SHIFT + 1 };
+    const s8 tooLow[] = { -MAX_ARP_SHIFT - 1 };
+    const u8 noLoopByte[] = { SYSEX_MANU_EXTENDED, SYSEX_MANU_REGION, SYSEX_MANU_ID,
+        SYSEX_COMMAND_STORE_PROGRAM, STORE_PROGRAM_TYPE_FM_ARP, 0 };
+
+    mock_log_enable_checks();
+    for (u8 type = STORE_PROGRAM_TYPE_FM_ARP; type <= STORE_PROGRAM_TYPE_PSG_ARP; type++) {
+        const char* warning = type == STORE_PROGRAM_TYPE_FM_ARP ? "Prg %d: Invalid FM arpeggio"
+                                                                : "Prg %d: Invalid PSG arpeggio";
+        expect_log_warn(warning);
+        store_row_raw(type, 0, NO_LOOP, tooLong, sizeof(tooLong));
+        expect_log_warn(warning);
+        store_row_raw(type, 0, 2, two, sizeof(two));
+        expect_log_warn(warning);
+        store_row_raw(type, 0, 0, NULL, 0);
+        expect_log_warn(warning);
+        store_row_raw(type, MIDI_PROGRAMS, NO_LOOP, two, sizeof(two));
+        expect_log_warn(warning);
+        store_row_raw(type, 0, NO_LOOP, tooHigh, sizeof(tooHigh));
+        expect_log_warn(warning);
+        store_row_raw(type, 0, NO_LOOP, tooLow, sizeof(tooLow));
+    }
+    expect_log_warn("Prg %d: Invalid FM arpeggio");
+    __real_midi_sysex(noLoopByte, sizeof(noLoopByte));
+    mock_log_disable_checks();
+
+    // The longest row and the widest shifts are taken.
+    s8 longest[MAX_ARP_STEPS];
+    memset(longest, 0, sizeof(longest));
+    longest[MAX_ARP_STEPS - 1] = MAX_ARP_SHIFT;
+    mock_log_enable_checks();
+    expect_log_info("Prg %d: FM arpeggio stored");
+    store_fm_row(1, MAX_ARP_STEPS - 1, longest, sizeof(longest));
+    const s8 widest[] = { -MAX_ARP_SHIFT, MAX_ARP_SHIFT };
+    expect_log_info("Prg %d: PSG arpeggio stored");
+    store_psg_row(1, NO_LOOP, widest, sizeof(widest));
+    mock_log_disable_checks();
+
+    // Program 0 still plays the rows stored before.
+    fm_note_on(MIDI_PITCH_C4, 5, SYNTH_NTSC_C);
+    psg_note_on(MIDI_PITCH_C4, TONE_C5);
+    ticks_without_writes(10);
+}
+
+void test_midi_arp_program_selects_row_of_its_type(UNUSED void** state)
+{
+    const s8 octave[] = { 12 };
+    const s8 fifth[] = { 7 };
+    store_fm_row(5, NO_LOOP, octave, sizeof(octave));
+    store_psg_row(5, NO_LOOP, fifth, sizeof(fifth));
+    // The test envelope of program 5 is silent: a loud one-step envelope in its place.
+    const u8 envelope[] = { SYSEX_MANU_EXTENDED, SYSEX_MANU_REGION, SYSEX_MANU_ID,
+        SYSEX_COMMAND_STORE_PROGRAM, STORE_PROGRAM_TYPE_PSG, 5, 0x0, 0x0 };
+    __real_midi_sysex(envelope, sizeof(envelope));
+
+    // Program 0 has no row of either type.
+    fm_note_on(MIDI_PITCH_C4, 4, SYNTH_NTSC_C);
+    psg_note_on(MIDI_PITCH_C4, TONE_C4);
+    expect_synth_note_off(FM_CH1);
+    __real_midi_note_off(FM_MIDI_CHAN, MIDI_PITCH_C4);
+    expect_psg_attenuation(PSG_CH1, PSG_ATTENUATION_SILENCE);
+    __real_midi_note_off(PSG_MIDI_CHAN, MIDI_PITCH_C4);
+
+    mock_synth_disable_checks();
+    __real_midi_program(FM_MIDI_CHAN, 5);
+    mock_synth_enable_checks();
+    __real_midi_program(PSG_MIDI_CHAN, 5);
+
+    fm_note_on(MIDI_PITCH_C4, 5, SYNTH_NTSC_C);
+    psg_note_on(MIDI_PITCH_C4, TONE_G4);
+    ticks_without_writes(10);
+}
+
+void test_midi_arp_without_loop_holds_last_step(UNUSED void** state)
+{
+    const s8 steps[] = { 3, 4, 7 };
+    store_fm_row(0, NO_LOOP, steps, sizeof(steps));
+
+    fm_note_on(MIDI_PITCH_C4, 4, SYNTH_NTSC_DS);
+    fm_tick(4, SYNTH_NTSC_E);
+    fm_tick(4, SYNTH_NTSC_G);
+    ticks_without_writes(100);
+}
+
+void test_midi_arp_loop_returns_to_its_step(UNUSED void** state)
+{
+    const s8 steps[] = { 0, 12, 4, 7 };
+    store_fm_row(0, 2, steps, sizeof(steps));
+
+    fm_note_on(MIDI_PITCH_C4, 4, SYNTH_NTSC_C);
+    fm_tick(5, SYNTH_NTSC_C);
+    fm_tick(4, SYNTH_NTSC_E);
+    fm_tick(4, SYNTH_NTSC_G);
+    fm_tick(4, SYNTH_NTSC_E);
+    fm_tick(4, SYNTH_NTSC_G);
+    fm_tick(4, SYNTH_NTSC_E);
+}
+
+void test_midi_arp_note_off_stops_steps(UNUSED void** state)
+{
+    const s8 steps[] = { 0, 12 };
+    store_fm_row(0, 0, steps, sizeof(steps));
+
+    fm_note_on(MIDI_PITCH_C4, 4, SYNTH_NTSC_C);
+    fm_tick(5, SYNTH_NTSC_C);
+    expect_synth_note_off(FM_CH1);
+    __real_midi_note_off(FM_MIDI_CHAN, MIDI_PITCH_C4);
+    ticks_without_writes(100);
+}
+
+void test_midi_arp_rewrite_keeps_sounding_row(UNUSED void** state)
+{
+    const s8 fifth[] = { 0, 7 };
+    const s8 octave[] = { 0, 12 };
+    store_fm_row(0, 0, fifth, sizeof(fifth));
+    store_psg_row(0, 0, fifth, sizeof(fifth));
+
+    fm_note_on(MIDI_PITCH_C4, 4, SYNTH_NTSC_C);
+    psg_note_on(MIDI_PITCH_C4, TONE_C4);
+    store_fm_row(0, 0, octave, sizeof(octave));
+    store_psg_row(0, 0, octave, sizeof(octave));
+
+    expect_synth_pitch(FM_CH1, 4, SYNTH_NTSC_G);
+    expect_psg_tone(PSG_CH1, TONE_G4);
+    midi_tick(1);
+    expect_synth_pitch(FM_CH1, 4, SYNTH_NTSC_C);
+    expect_psg_tone(PSG_CH1, TONE_C4);
+    midi_tick(1);
+
+    // A new attack takes the new row from its first step.
+    expect_synth_note_off(FM_CH1);
+    __real_midi_note_off(FM_MIDI_CHAN, MIDI_PITCH_C4);
+    expect_psg_attenuation(PSG_CH1, PSG_ATTENUATION_SILENCE);
+    __real_midi_note_off(PSG_MIDI_CHAN, MIDI_PITCH_C4);
+    fm_note_on(MIDI_PITCH_C4, 4, SYNTH_NTSC_C);
+    // The PSG tone is C4 already, so only the attenuation is written.
+    expect_psg_attenuation(PSG_CH1, PSG_ATTENUATION_LOUDEST);
+    __real_midi_note_on(PSG_MIDI_CHAN, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+    expect_psg_tone(PSG_CH1, TONE_C5);
+    fm_tick(5, SYNTH_NTSC_C);
+}
+
+void test_midi_arp_reset_clears_rows(UNUSED void** state)
+{
+    const s8 steps[] = { 7, 12 };
+    store_fm_row(0, 0, steps, sizeof(steps));
+    store_psg_row(0, 0, steps, sizeof(steps));
+
+    mock_synth_disable_checks();
+    __real_midi_reset();
+    mock_synth_enable_checks();
+
+    fm_note_on(MIDI_PITCH_C4, 4, SYNTH_NTSC_C);
+    psg_note_on(MIDI_PITCH_C4, TONE_C4);
+    ticks_without_writes(10);
+}
+
+// Stage 24: a reset gives each program the image's row again, past what a SysEx stored over it.
+void test_midi_arp_reset_takes_image_rows(UNUSED void** state)
+{
+    TEST_ARP_ROWS[0] = (ArpRow) { .count = 2, .loop = 0, .steps = { 0, 12 } };
+    TEST_ARP_ROWS[MIDI_PROGRAMS] = (ArpRow) { .count = 2, .loop = 0, .steps = { 0, 7 } };
+    const s8 steps[] = { 3 };
+    store_fm_row(0, NO_LOOP, steps, sizeof(steps));
+    store_psg_row(0, NO_LOOP, steps, sizeof(steps));
+
+    mock_synth_disable_checks();
+    __real_midi_reset();
+    mock_synth_enable_checks();
+
+    fm_note_on(MIDI_PITCH_C4, 4, SYNTH_NTSC_C);
+    fm_tick(5, SYNTH_NTSC_C);
+    expect_synth_note_off(FM_CH1);
+    __real_midi_note_off(FM_MIDI_CHAN, MIDI_PITCH_C4);
+    psg_note_on(MIDI_PITCH_C4, TONE_C4);
+    psg_tick(TONE_G4);
+}
+
+// Fine tune +50 cents, bend +1 semitone, the row +12: C#5 and 50 cents.
+void test_midi_arp_adds_to_bend_and_fine_tune(UNUSED void** state)
+{
+    const u16 HALF_C = SYNTH_NTSC_C + (SYNTH_NTSC_CS - SYNTH_NTSC_C) / 2;
+    const u16 HALF_CS = SYNTH_NTSC_CS + (SYNTH_NTSC_D - SYNTH_NTSC_CS) / 2;
+    const s8 steps[] = { 0, 12 };
+    store_fm_row(0, 0, steps, sizeof(steps));
+    __real_midi_cc(FM_MIDI_CHAN, CC_FINE_TUNE, 64 + 50);
+
+    fm_note_on(MIDI_PITCH_C4, 4, HALF_C);
+    expect_synth_pitch(FM_CH1, 4, HALF_CS);
+    __real_midi_pitch_bend(FM_MIDI_CHAN, MIDI_PITCH_BEND_CENTRE + 0x1000);
+    fm_tick(5, HALF_CS);
+    fm_tick(4, HALF_CS);
+}
+
+// A legato note glides 47 cents a frame and the row goes on from where it was: one write a frame.
+void test_midi_arp_adds_to_portamento(UNUSED void** state)
+{
+    const s8 steps[] = { 0, 4 };
+    store_fm_row(0, 0, steps, sizeof(steps));
+    __real_midi_cc(FM_MIDI_CHAN, CC_PORTAMENTO_ENABLE, 127);
+
+    fm_note_on(MIDI_PITCH_C4, 4, SYNTH_NTSC_C);
+    __real_midi_note_on(FM_MIDI_CHAN, MIDI_PITCH_C4 + 2, MAX_MIDI_VOLUME);
+
+    fm_tick(4, SYNTH_NTSC_E + (SYNTH_NTSC_F - SYNTH_NTSC_E) * 47 / 100);
+    fm_tick(4, SYNTH_NTSC_C + (SYNTH_NTSC_CS - SYNTH_NTSC_C) * 94 / 100);
+    fm_tick(4, SYNTH_NTSC_F + (SYNTH_NTSC_FS - SYNTH_NTSC_F) * 41 / 100);
+}
+
+void test_midi_arp_fm_held_within_range(UNUSED void** state)
+{
+    const s8 up[] = { MAX_ARP_SHIFT };
+    const s8 down[] = { -MAX_ARP_SHIFT };
+
+    store_fm_row(0, NO_LOOP, up, sizeof(up));
+    fm_note_on(100, 7, SYNTH_NTSC_AS);
+    expect_synth_note_off(FM_CH1);
+    __real_midi_note_off(FM_MIDI_CHAN, 100);
+
+    store_fm_row(0, NO_LOOP, down, sizeof(down));
+    fm_note_on(20, 0, SYNTH_NTSC_B);
+    ticks_without_writes(10);
+}
+
+// Runs with the DAC on (test_midi_dac_setup).
+void test_midi_arp_dac_does_not_step(UNUSED void** state)
+{
+    const s8 steps[] = { 0, 12 };
+    store_fm_row(0, 0, steps, sizeof(steps));
+
+    __real_midi_note_on(DAC_MIDI_CHAN, 36, MAX_MIDI_VOLUME);
+    ticks_without_writes(100);
+    assert_int_equal(__real_midi_channel_mappings()[DEV_CHAN_MAX_FM].arp.count, 0);
+}
+
+// Stage 21: in OPS the row moves neither channel 3 nor its operators.
+void test_midi_arp_ch3_special_does_not_step(UNUSED void** state)
+{
+    const s8 steps[] = { 0, 12 };
+    store_fm_row(0, 0, steps, sizeof(steps));
+    expect_synth_set_special_mode(true);
+    expect_synth_special_mode_keys_off();
+    __real_midi_cc(FM_MIDI_CHAN, CC_GENMDM_CH3_SPECIAL_MODE, 127);
+
+    expect_synth_pitch(FM_CH3, 4, SYNTH_NTSC_C);
+    expect_synth_special_mode_volume(3, MAX_MIDI_VOLUME);
+    expect_synth_special_mode_note_on(3);
+    __real_midi_note_on(CH3_MIDI_CHAN, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+
+    expect_synth_special_mode_pitch(0, 4, SYNTH_NTSC_C);
+    expect_synth_special_mode_volume(0, MAX_MIDI_VOLUME);
+    expect_synth_special_mode_note_on(0);
+    __real_midi_note_on(OP_MIDI_CHAN, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+
+    ticks_without_writes(100);
+}
+
+// Stage 21: in ONE NOTE the row moves all four operators of channel 3.
+void test_midi_arp_ch3_one_note_steps(UNUSED void** state)
+{
+    const s8 steps[] = { 0, 12 };
+    store_fm_row(0, 0, steps, sizeof(steps));
+    expect_synth_set_special_mode(true);
+    expect_synth_special_mode_keys_off();
+    __real_midi_cc(FM_MIDI_CHAN, CC_GENMDM_CH3_SPECIAL_MODE, 127);
+    expect_synth_special_mode_keys_off();
+    expect_synth_set_csm(false);
+    __real_midi_cc(FM_MIDI_CHAN, CC_CH3_NOTES, 64);
+
+    for (u8 op = 0; op < 3; op++) {
+        expect_synth_special_mode_pitch(op, 4, SYNTH_NTSC_C);
+    }
+    expect_synth_pitch(FM_CH3, 4, SYNTH_NTSC_C);
+    expect_synth_volume_any();
+    expect_synth_note_on(FM_CH3);
+    __real_midi_note_on(CH3_MIDI_CHAN, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+
+    for (u8 op = 0; op < 3; op++) {
+        expect_synth_special_mode_pitch(op, 5, SYNTH_NTSC_C);
+    }
+    expect_synth_pitch(FM_CH3, 5, SYNTH_NTSC_C);
+    midi_tick(1);
+    for (u8 op = 0; op < 3; op++) {
+        expect_synth_special_mode_pitch(op, 4, SYNTH_NTSC_C);
+    }
+    expect_synth_pitch(FM_CH3, 4, SYNTH_NTSC_C);
+    midi_tick(1);
+}
+
+void test_midi_arp_noise_kit_does_not_step(UNUSED void** state)
+{
+    const s8 steps[] = { 0, 12 };
+    store_psg_row(0, 0, steps, sizeof(steps));
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_TONE3);
+    __real_midi_cc(NOISE_MIDI_CHAN, CC_NOISE_RATE, 96);
+    __real_midi_cc(NOISE_MIDI_CHAN, CC_NOISE_RATE, 127);
+
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_TONE3);
+    expect_psg_tone(PSG_CH3, 95);
+    expect_psg_attenuation(PSG_NOISE_CH4, PSG_ATTENUATION_LOUDEST);
+    __real_midi_note_on(NOISE_MIDI_CHAN, 36, MAX_MIDI_VOLUME);
+
+    ticks_without_writes(100);
+}
+
+// Key 36 sounds the tone of key 84 on tone 3; +12 moves it to key 96.
+void test_midi_arp_moves_noise_on_tone3(UNUSED void** state)
+{
+    const s8 steps[] = { 0, 12 };
+    store_psg_row(0, 0, steps, sizeof(steps));
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_TONE3);
+    __real_midi_cc(NOISE_MIDI_CHAN, CC_NOISE_RATE, 96);
+
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_TONE3);
+    expect_psg_tone(PSG_CH3, 106);
+    expect_psg_attenuation(PSG_NOISE_CH4, PSG_ATTENUATION_LOUDEST);
+    __real_midi_note_on(NOISE_MIDI_CHAN, 36, MAX_MIDI_VOLUME);
+
+    expect_psg_tone(PSG_CH3, 53);
+    midi_tick(1);
+    expect_psg_tone(PSG_CH3, 106);
+    midi_tick(1);
+}
+
+void test_midi_arp_empty_row_writes_no_pitch(UNUSED void** state)
+{
+    // A row of another program does not count.
+    const s8 steps[] = { 0, 12 };
+    store_fm_row(1, 0, steps, sizeof(steps));
+    store_psg_row(1, 0, steps, sizeof(steps));
+
+    fm_note_on(MIDI_PITCH_C4, 4, SYNTH_NTSC_C);
+    psg_note_on(MIDI_PITCH_C4, TONE_C4);
+    ticks_without_writes(100);
+}
