+// A one-shot sample plays to its end: Note Off leaves it, as the plugin marks drums (D38).
+void test_midi_dac_one_shot_ignores_note_off(UNUSED void** state)
+{
+    static const u8 data[256] = { 0 };
+    static const PcmSample oneShot = { data, sizeof(data), 1, PCM_ONE_SHOT };
+    const PcmSample* saved = percussionPcmSample[nullNoteKey];
+    percussionPcmSample[nullNoteKey] = &oneShot;
+
+    expect_value(__wrap_SND_PCM_startPlay, sample, data);
+    expect_value(__wrap_SND_PCM_startPlay, len, sizeof(data));
+    expect_value(__wrap_SND_PCM_startPlay, rate, 1);
+    expect_value(__wrap_SND_PCM_startPlay, pan, SOUND_PAN_CENTER);
+    expect_value(__wrap_SND_PCM_startPlay, loop, 0);
+    __real_midi_note_on(dacFmChannel, nullNoteKey, 100);
+    __real_midi_note_off(dacFmChannel, nullNoteKey);
+
+    percussionPcmSample[nullNoteKey] = saved;
+}
+
+// A one-shot held under a shorter note isn't struck again when that note is released (D38).
+void test_midi_dac_one_shot_not_retriggered(UNUSED void** state)
+{
+    static const u8 data[256] = { 0 };
+    static const PcmSample oneShot = { data, sizeof(data), 1, PCM_ONE_SHOT };
+    const PcmSample* saved = percussionPcmSample[nullNoteKey];
+    percussionPcmSample[nullNoteKey] = &oneShot;
+
+    expect_value(__wrap_SND_PCM_startPlay, sample, data);
+    expect_any(__wrap_SND_PCM_startPlay, len);
+    expect_any(__wrap_SND_PCM_startPlay, rate);
+    expect_any(__wrap_SND_PCM_startPlay, pan);
+    expect_any(__wrap_SND_PCM_startPlay, loop);
+    __real_midi_note_on(dacFmChannel, nullNoteKey, 100);
+
+    expect_any(__wrap_SND_PCM_startPlay, sample);
+    expect_any(__wrap_SND_PCM_startPlay, len);
+    expect_any(__wrap_SND_PCM_startPlay, rate);
+    expect_any(__wrap_SND_PCM_startPlay, pan);
+    expect_any(__wrap_SND_PCM_startPlay, loop);
+    __real_midi_note_on(dacFmChannel, noteKey, 100);
+
+    expect_function_call(__wrap_SND_PCM_stopPlay);
+    __real_midi_note_off(dacFmChannel, noteKey);
+
+    percussionPcmSample[nullNoteKey] = saved;
+}
+
+static void expect_pcm_start(const u8* data)
+{
+    expect_value(__wrap_SND_PCM_startPlay, sample, data);
+    expect_any(__wrap_SND_PCM_startPlay, len);
+    expect_any(__wrap_SND_PCM_startPlay, rate);
+    expect_any(__wrap_SND_PCM_startPlay, pan);
+    expect_any(__wrap_SND_PCM_startPlay, loop);
+}
