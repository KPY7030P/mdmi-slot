+    u8 hasType = PSG_NOISE_TYPE_WHITE;
+    u8 hasRate = PSG_NOISE_FREQ_CLOCK2;
+    for (u8 type = 0; type < 2; type++) {
+        for (u8 rate = 0; rate < 4; rate++) {
+            if (type != hasType) {
+                expect_psg_noise(type, hasRate);
+                hasType = type;
+            }
+            __real_midi_cc(NOISE_MIDI_CHAN, CC_NOISE_TYPE, type ? 64 : 0);
+            if (rate != hasRate) {
+                expect_psg_noise(type, rate);
+                hasRate = rate;
+            }
+            __real_midi_cc(NOISE_MIDI_CHAN, CC_NOISE_RATE, rate * 26 + 13);
+            for (u8 k = 0; k < sizeof(keys); k++) {
+                if (rate == PSG_NOISE_FREQ_TONE3 && keys[k] > 79) {
+                    __real_midi_note_on(NOISE_MIDI_CHAN, keys[k], MAX_MIDI_VOLUME);
+                    __real_midi_note_off(NOISE_MIDI_CHAN, keys[k]);
