diff --git a/src/midi_psg.c b/src/midi_psg.c
index 82a5655..7d69893 100644
--- a/src/midi_psg.c
+++ b/src/midi_psg.c
@@ -48,6 +48,11 @@ typedef struct MidiPsgChannel {
 static u8 userDefinedEnvelope[256];
 static u8* userDefinedEnvelopePtr;
 static const u8** envelopes;
+// MDMI plugin fork, 2026-11-04: envelopes stored per program, like FM user presets. A note plays a
+// copy of its stored envelope, so storing another under the same program can't change it.
+static u8 storedEnvelopes[MIDI_PROGRAMS][MAX_STORED_ENVELOPE_STEPS + 1];
+static const u8* activeStoredEnvelopes[MIDI_PROGRAMS];
+static u8 playingEnvelopes[MAX_PSG_CHANS][MAX_STORED_ENVELOPE_STEPS + 1];
 static MidiPsgChannel psgChannels[MAX_PSG_CHANS];
 
 static u16 tone_for_midi_key(u8 midiKey);
@@ -67,6 +72,7 @@ void midi_psg_init(const u8** defaultEnvelopes)
 void midi_psg_reset(void)
 {
     userDefinedEnvelopePtr = NULL;
+    memset(activeStoredEnvelopes, 0, sizeof(activeStoredEnvelopes));
     for (u8 chan = 0; chan < MAX_PSG_CHANS; chan++) {
         MidiPsgChannel* psgChan = psg_channel(chan);
         psgChan->attenuation = PSG_ATTENUATION_SILENCE;
@@ -85,8 +91,18 @@ void midi_psg_reset(void)
 
 static void init_envelope(MidiPsgChannel* psgChan)
 {
-    psgChan->envelopeStep
-        = userDefinedEnvelopePtr != NULL ? userDefinedEnvelopePtr : envelopes[psgChan->envelope];
+    const u8* stored = activeStoredEnvelopes[psgChan->envelope];
+    if (userDefinedEnvelopePtr == NULL && stored != NULL) {
+        u8* copy = playingEnvelopes[psgChan->chanNum];
+        u16 i = 0;
+        do {
+            copy[i] = stored[i];
+        } while (stored[i++] != EEF_END);
+        psgChan->envelopeStep = copy;
+    } else {
+        psgChan->envelopeStep
+            = userDefinedEnvelopePtr != NULL ? userDefinedEnvelopePtr : envelopes[psgChan->envelope];
+    }
     psgChan->envelopeLoopStart = NULL;
 }
 
@@ -209,6 +225,21 @@ static void apply_envelope_step(MidiPsgChannel* psgChan)
     apply_attenuation(psgChan, effective_attenuation(psgChan));
 }
 
+// Changing the Z80 driver resets the PSG (SGDK's PSG_reset): tone 0 and silence on every channel,
+// noise control 0. The shadow now says the same, and a sounding note is written again.
+void midi_psg_chip_reset(void)
+{
+    for (u8 chan = 0; chan < MAX_PSG_CHANS; chan++) {
+        MidiPsgChannel* psgChan = &psgChannels[chan];
+        psgChan->freq = 0;
+        psgChan->attenuation = PSG_ATTENUATION_SILENCE;
+        if (psgChan->noteOn) {
+            apply_tone(psgChan, envelope_tone(psgChan));
+            apply_attenuation(psgChan, effective_attenuation(psgChan));
+        }
+    }
+}
+
 void midi_psg_note_on(u8 chan, u8 pitch, s8 cents, u8 velocity)
 {
     if (pitch < MIN_MIDI_KEY) {
@@ -293,6 +324,15 @@ void midi_psg_load_envelope(const u8* eef)
     userDefinedEnvelopePtr = userDefinedEnvelope;
 }
 
+// The tail is filled with EEF_END, so a copy ends within the slot whatever was stored before.
+void midi_psg_store_envelope(u8 program, const u8* eef, u16 length)
+{
+    u8* slot = storedEnvelopes[program];
+    memset(slot, EEF_END, sizeof(storedEnvelopes[program]));
+    memcpy(slot, eef, length);
+    activeStoredEnvelopes[program] = slot;
+}
+
 static u16 tone_for_midi_key(u8 midiKey)
 {
     const u16* tones = SYS_isPAL() ? TONES_PAL : TONES_NTSC;
