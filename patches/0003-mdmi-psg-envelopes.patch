+    __real_midi_note_off(TONE3_MIDI_CHAN, MIDI_PITCH_C4);
+    __real_midi_pitch_bend(TONE3_MIDI_CHAN, 0x2000);
+    __real_midi_note_on(TONE3_MIDI_CHAN, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+    __real_midi_psg_tick();
+    __real_midi_note_off(TONE3_MIDI_CHAN, MIDI_PITCH_C4);
+    __real_midi_cc(TONE3_MIDI_CHAN, CC_VOLUME, MAX_MIDI_VOLUME);
+
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_CLOCK2);
+    __real_midi_cc(NOISE_MIDI_CHAN, CC_NOISE_RATE, 0);
+
+    expect_psg_tone(PSG_CH3, TONE_NTSC_C4);
+    expect_psg_attenuation(PSG_CH3, PSG_ATTENUATION_LOUDEST);
+    __real_midi_note_on(TONE3_MIDI_CHAN, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+}
+
+// A note of the noise already sounding moves its tone into channel 3 with the mode.
+void test_midi_psg_noise_switched_to_tone3_while_sounding(UNUSED void** state)
+{
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_CLOCK2);
+    expect_psg_attenuation(PSG_NOISE_CH4, PSG_ATTENUATION_LOUDEST);
+    __real_midi_note_on(NOISE_MIDI_CHAN, 36, MAX_MIDI_VOLUME);
+
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_TONE3);
+    expect_psg_tone(PSG_CH3, 106);
+    __real_midi_cc(NOISE_MIDI_CHAN, CC_NOISE_RATE, 96);
+}
+
+// The envelope's pitch shift: nothing at a fixed rate, the tone in channel 3 on tone 3.
+void test_midi_psg_noise_envelope_pitch_goes_through_tone3(UNUSED void** state)
+{
+    const u8 eef[] = { 0x50, 0x00, EEF_END };
+    __real_midi_psg_load_envelope(eef);
+
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_CLOCK2);
+    expect_psg_attenuation(PSG_NOISE_CH4, PSG_ATTENUATION_LOUDEST);
+    __real_midi_note_on(NOISE_MIDI_CHAN, 36, MAX_MIDI_VOLUME);
+    __real_midi_psg_tick();
+    expect_psg_attenuation(PSG_NOISE_CH4, PSG_ATTENUATION_SILENCE);
+    __real_midi_note_off(NOISE_MIDI_CHAN, 36);
+
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_TONE3);
+    __real_midi_cc(NOISE_MIDI_CHAN, CC_NOISE_RATE, 96);
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_TONE3);
+    expect_psg_tone(PSG_CH3, 100);
+    expect_psg_attenuation(PSG_NOISE_CH4, PSG_ATTENUATION_LOUDEST);
+    __real_midi_note_on(NOISE_MIDI_CHAN, 36, MAX_MIDI_VOLUME);
+    expect_psg_tone(PSG_CH3, 106);
+    __real_midi_psg_tick();
+}
+
+// KIT: the key's place in the octave picks the drum, its type and its tone 3 value in the octave of
+// keys 36-47; each octave up halves the value. It runs on tone 3, so channel 3 stays silent.
+static void kit_key(u8 key, u8 type, u16 tone)
+{
+    expect_psg_noise(type, PSG_NOISE_FREQ_TONE3);
+    expect_psg_tone(PSG_CH3, tone);
+    expect_psg_attenuation(PSG_NOISE_CH4, PSG_ATTENUATION_LOUDEST);
+    __real_midi_note_on(NOISE_MIDI_CHAN, key, MAX_MIDI_VOLUME);
+    expect_psg_attenuation(PSG_NOISE_CH4, PSG_ATTENUATION_SILENCE);
+    __real_midi_note_off(NOISE_MIDI_CHAN, key);
+}
+
+void test_midi_psg_noise_kit_repeats_every_octave(UNUSED void** state)
+{
+    expect_psg_tone(PSG_CH3, TONE_NTSC_C4);
+    expect_psg_attenuation(PSG_CH3, PSG_ATTENUATION_LOUDEST);
+    __real_midi_note_on(TONE3_MIDI_CHAN, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+    expect_psg_attenuation(PSG_CH3, PSG_ATTENUATION_SILENCE);
+    __real_midi_cc(NOISE_MIDI_CHAN, CC_NOISE_RATE, 127);
+    __real_midi_cc(NOISE_MIDI_CHAN, CC_NOISE_TYPE, 0);
+
+    kit_key(36, PSG_NOISE_TYPE_WHITE, 95);
+    kit_key(38, PSG_NOISE_TYPE_WHITE, 12);
+    kit_key(42, PSG_NOISE_TYPE_WHITE, 2);
+    kit_key(41, PSG_NOISE_TYPE_PERIODIC, 70);
+    kit_key(48, PSG_NOISE_TYPE_WHITE, 47);
+    kit_key(24, PSG_NOISE_TYPE_WHITE, 190);
+    kit_key(0, PSG_NOISE_TYPE_WHITE, 760);
+    // Far up the drums stay at the chip's top, far down at its bottom.
+    kit_key(120, PSG_NOISE_TYPE_WHITE, 1);
+    kit_key(5, PSG_NOISE_TYPE_PERIODIC, 560);
+
+    __real_midi_note_on(TONE3_MIDI_CHAN, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+    __real_midi_note_off(TONE3_MIDI_CHAN, MIDI_PITCH_C4);
+}
+
+// A change while a key sounds writes only if the key's byte changes: every write restarts the noise.
+void test_midi_psg_noise_switched_to_kit_while_sounding(UNUSED void** state)
+{
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_CLOCK2);
+    expect_psg_attenuation(PSG_NOISE_CH4, PSG_ATTENUATION_LOUDEST);
+    __real_midi_note_on(NOISE_MIDI_CHAN, 52, MAX_MIDI_VOLUME);
+
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_TONE3);
+    expect_psg_tone(PSG_CH3, 9);
+    __real_midi_cc(NOISE_MIDI_CHAN, CC_NOISE_RATE, 127);
+    // The kit decides the type: a type lane writes nothing.
+    __real_midi_cc(NOISE_MIDI_CHAN, CC_NOISE_TYPE, 0);
+
+    expect_psg_attenuation(PSG_NOISE_CH4, PSG_ATTENUATION_SILENCE);
+    __real_midi_note_off(NOISE_MIDI_CHAN, 52);
+
+    expect_value(__wrap_synth_enable_dac, enable, true);
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_TONE3);
+    __real_midi_cc(0, 78, 0x7F);
+}
