 {
@@ -7,15 +115,44 @@ void midi_dac_note_on(u8 chan, u8 pitch, s8 cents, u8 velocity)
     if (!sample) {
         return;
     }
-    SND_PCM_startPlay(sample->data, sample->length, sample->rate, SOUND_PAN_CENTER, 0);
+    playing = sample;
+    marks.state = MARKS_IDLE;
+    if (sample->flags & PCM_MARKS) {
+        marks_start(sample);
+        return;
+    }
+    SND_PCM_startPlay(sample->data, sample->length, sample->rate, pan, sample->flags & PCM_LOOP);
+}
+
+bool midi_dac_retriggers(u8 pitch)
+{
+    const PcmSample* sample = percussionPcmSample[pitch];
+    return !sample || !(sample->flags & PCM_ONE_SHOT);
 }
 
+// The DAC switched: the driver starts afresh, nothing of a sample is awaited.
 void midi_dac_reset(void)
 {
+    playing = NULL;
+    marks.state = MARKS_IDLE;
 }
 
 void midi_dac_note_off(u8 chan, u8 pitch)
 {
+    if (playing && (playing->flags & PCM_ONE_SHOT)) {
+        return;
+    }
+    if (marks.state == MARKS_WAIT_COPY || marks.state == MARKS_LOOPING) {
+        if (marks.end > marks.loopEnd) {
+            marks_release();
+            return;
+        }
+        marks.state = MARKS_IDLE;
+    }
+    if (marks.state == MARKS_RELEASE) {
+        // The release plays out; a second Note Off of the same note doesn't cut it.
+        return;
+    }
     SND_PCM_stopPlay();
 }
 
