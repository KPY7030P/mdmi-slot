+    = { 0x01, EEF_LOOP_START, 0x02, 0x03, EEF_LOOP_END, 0x04, 0x05, EEF_END };
+
+static void expect_steps(u8 from, u8 to)
+{
+    for (u8 step = from; step <= to; step++) {
+        expect_psg_attenuation(0, step);
+        __real_midi_psg_tick();
+    }
+}
