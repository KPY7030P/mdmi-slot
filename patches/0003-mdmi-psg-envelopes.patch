+// Stage 22a (D53): LOOP with ONE-SHOT. Note Off neither releases nor stops: the loop goes on,
+// its loop bit set and its params as they were, until the key plays again. The plugin no longer
+// writes these flags since stage 22b (D54 cancels D53); the ROM still plays them so.
+void test_midi_dac_marks_one_shot_loops_past_note_off(UNUSED void** state)
+{
+    static const PcmMarked endless
+        = { { markedData, sizeof(markedData), 1, PCM_LOOP | PCM_ONE_SHOT | PCM_MARKS }, 2, 6 };
+    use_marked(&endless);
+    __real_midi_note_on(dacChannel, key, 100);
