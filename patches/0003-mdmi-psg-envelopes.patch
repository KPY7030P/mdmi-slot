new file mode 100644
index 0000000..a403e9e
--- /dev/null
+++ b/src/pcm_driver.h
@@ -0,0 +1,27 @@
+#pragma once
+#include "types.h"
+
+// SGDK 2.00 drv_pcm4's RAM as the 68000 reaches it (MDMI plugin, stages 18b and 19,
+// docs/research/pcm4.md in the plugin). Addresses are the Z80's; u16 values are little endian.
+// Lengths and addresses count 256-byte blocks. Voice v's flag is bit v of COMMAND (start), STATUS
+// (playing: set by the driver after it copied the voice's params) and LOOP. The unit tests wrap
+// these functions.
+#define PCM_DRV_VOICES 4
+#define PCM_DRV_COMMAND 0x0100
+#define PCM_DRV_STATUS 0x0102
+#define PCM_DRV_LOOP 0x0103
+#define PCM_DRV_WAVADR(v) (0x0104 + 4 * (v))
+#define PCM_DRV_WAVLEN(v) (0x0106 + 4 * (v))
+#define PCM_DRV_IWAVADR(v) (0x0114 + 4 * (v)) // the block playing
+#define PCM_DRV_IWAVLEN(v) (0x0116 + 4 * (v)) // blocks left in this pass
+#define PCM_DRV_VOLUME(v) (0x0124 + (v)) // 0-15, 15 as it is
+#define PCM_DRV_NULLWAVADR 0x0128
+#define PCM_DRV_NULLWAVLEN 0x012A
+
+u8 pcm_driver_read(u16 address);
+void pcm_driver_write(u16 address, u8 value);
+// The Z80's bus, held across a few reads and writes of its RAM.
+void pcm_driver_take(void);
+void pcm_driver_give(void);
+// Busy waits with the bus given back, so the driver runs on.
+void pcm_driver_wait_us(u16 us);
