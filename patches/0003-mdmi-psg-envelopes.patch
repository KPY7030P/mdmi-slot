diff --git a/tests/unit/test_midi_dac_marks.c b/tests/unit/test_midi_dac_marks.c
new file mode 100644
index 0000000..87db1b2
--- /dev/null
+++ b/tests/unit/test_midi_dac_marks.c
@@ -0,0 +1,370 @@
+#include "test_midi_dac_marks.h"
+#include "test_midi.h"
+#include "mocks/mock_midi.h"
+#include "mocks/mock_psg.h"
+#include "mocks/mock_pcm_driver.h"
+#include "pcm_sample.h"
+#include "pcm_driver.h"
+#include "midi_dac.h"
+#include "snd/sound.h"
+#include "snd/pcm/snd_pcm.h"
+
+// Stage 18b: a sample with loop marks, 8 blocks: intro 0-1, loop 2-5, release 6-7.
+static const u8 dacChannel = 5;
+static const u8 key = 1;
+static const u8 markedData[256 * 8] __attribute__((aligned(256))) = { 0 };
+static const PcmMarked marked = { { markedData, sizeof(markedData), 1, PCM_LOOP | PCM_MARKS }, 2, 6 };
+#define BLOCK0 ((u16)((u32)(long)markedData >> 8))
+
+static const PcmSample* saved;
+
+static void use_marked(const PcmMarked* sample)
+{
+    saved = percussionPcmSample[key];
+    percussionPcmSample[key] = &sample->sample;
+    mock_pcm_driver_reset();
+    // The driver ready, no voice playing.
+    mock_pcm_ram[PCM_DRV_STATUS] = 0x80;
+}
+
+static void done(void)
+{
+    percussionPcmSample[key] = saved;
+    mock_pcm_driver_reset();
+}
+
+// The driver takes the command: clears it, copies the params, sets playing.
+static void driver_copies(void)
+{
+    mock_pcm_ram[PCM_DRV_COMMAND] &= ~1;
+    mock_pcm_write16(PCM_DRV_IWAVADR(0), mock_pcm_read16(PCM_DRV_WAVADR(0)));
+    mock_pcm_write16(PCM_DRV_IWAVLEN(0), mock_pcm_read16(PCM_DRV_WAVLEN(0)));
+    mock_pcm_ram[PCM_DRV_STATUS] |= 1;
+}
+
+static void assert_tick_idle(void)
+{
+    const int takes = mock_pcm_takes;
+    midi_dac_tick();
+    assert_int_equal(mock_pcm_takes, takes);
+}
+
+void test_midi_dac_marks_start_then_loop(UNUSED void** state)
+{
+    use_marked(&marked);
+    __real_midi_note_on(dacChannel, key, 100);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(0)), BLOCK0);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 6);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_VOLUME(0)], 12);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 1);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_COMMAND] & 1, 1);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_STATUS], 0x80);
+    // Not taken yet: the params stay, next frame again.
+    midi_dac_tick();
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(0)), BLOCK0);
+    driver_copies();
+    midi_dac_tick();
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(0)), BLOCK0 + 2);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 4);
+    assert_tick_idle();
+    done();
+}
+
+// Stage 27: a start without intro waits for its copy too, then its loop bit is set again.
+void test_midi_dac_marks_without_intro_wait_for_copy(UNUSED void** state)
+{
+    static const PcmMarked noIntro = { { markedData, sizeof(markedData), 1, PCM_LOOP | PCM_MARKS }, 0, 6 };
+    use_marked(&noIntro);
+    __real_midi_note_on(dacChannel, key, 100);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 6);
+    driver_copies();
+    midi_dac_tick();
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 1);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 6);
+    assert_tick_idle();
+    done();
+}
+
+// Stage 27: the stop of the pass before clears the loop bit after the start set it; the copy comes
+// later. The frame after the copy sets the bit again, and the loop becomes the params.
+void test_midi_dac_marks_loop_bit_back_after_stop(UNUSED void** state)
+{
+    use_marked(&marked);
+    __real_midi_note_on(dacChannel, key, 100);
+    mock_pcm_ram[PCM_DRV_LOOP] &= ~1;
+    midi_dac_tick();
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 0);
+    driver_copies();
+    midi_dac_tick();
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 1);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(0)), BLOCK0 + 2);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 4);
+    done();
+}
+
+void test_midi_dac_marks_note_off_plays_release(UNUSED void** state)
+{
+    use_marked(&marked);
+    __real_midi_note_on(dacChannel, key, 100);
+    driver_copies();
+    midi_dac_tick();
+    // In the loop's second block, so the pass ends at block 6.
+    mock_pcm_write16(PCM_DRV_IWAVADR(0), BLOCK0 + 3);
+    mock_pcm_write16(PCM_DRV_IWAVLEN(0), 3);
+    __real_midi_note_off(dacChannel, key);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 0);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_IWAVLEN(0)), 8 - 3);
+    assert_int_equal(mock_pcm_waited_us, 600);
+    done();
+}
+
+void test_midi_dac_marks_note_off_in_intro_before_copy(UNUSED void** state)
+{
+    use_marked(&marked);
+    __real_midi_note_on(dacChannel, key, 100);
+    __real_midi_note_off(dacChannel, key);
+    // The driver will copy the intro, the loop once and the release.
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(0)), BLOCK0);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 8);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 0);
+    assert_int_equal(mock_pcm_waited_us, 0);
+    assert_tick_idle();
+    done();
+}
+
+// Without an intro, a Note Off before the driver took the command doesn't wait for it.
+void test_midi_dac_marks_note_off_before_copy_without_intro(UNUSED void** state)
+{
+    static const PcmMarked noIntro = { { markedData, sizeof(markedData), 1, PCM_LOOP | PCM_MARKS }, 0, 6 };
+    use_marked(&noIntro);
