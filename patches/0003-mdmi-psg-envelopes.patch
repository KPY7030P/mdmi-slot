     synth_direct_write_ym2612(part, data[0] << 4 | data[1], data[2] << 4 | data[3]);
 }
 
+// MDMI plugin fork, 2026-11-04: the length depends on the type, so it is checked here.
+static void store_psg_program(u8 program, const u8* data, u16 length)
+{
+    if (length % 2 != 0 || length / 2 > MAX_STORED_ENVELOPE_STEPS || program >= MIDI_PROGRAMS) {
+        log_warn("Prg %d: Invalid PSG envelope", program);
+        return;
+    }
+    u8 eef[MAX_STORED_ENVELOPE_STEPS];
+    for (u16 i = 0; i < length; i += 2) {
+        eef[i / 2] = (data[i] << 4) | data[i + 1];
+    }
+    midi_psg_store_envelope(program, eef, length / 2);
+    log_info("Prg %d: PSG envelope stored", program);
+}
+
 static void store_program(const u8* data, u16 length)
 {
+    if (length < STORE_PROGRAM_HEADER_LENGTH) {
+        log_warn("Sysex %02X: Invalid length: %d (!= %d)", SYSEX_COMMAND_STORE_PROGRAM, length,
+            STORE_PROGRAM_FM_LENGTH);
+        return;
+    }
     u8 type = data[0];
     u8 program = data[1];
 
     switch (type) {
+    case STORE_PROGRAM_TYPE_PSG:
+        store_psg_program(program, data + STORE_PROGRAM_HEADER_LENGTH,
+            length - STORE_PROGRAM_HEADER_LENGTH);
+        break;
     case STORE_PROGRAM_TYPE_FM: {
+        if (length != STORE_PROGRAM_FM_LENGTH) {
+            log_warn("Sysex %02X: Invalid length: %d (!= %d)", SYSEX_COMMAND_STORE_PROGRAM, length,
+                STORE_PROGRAM_FM_LENGTH);
+            return;
+        }
         FmPreset fmPreset;
         fmPreset.algorithm = data[2];
         fmPreset.feedback = data[3];
@@ -841,7 +870,7 @@ static const SysexCommand SYSEX_COMMANDS[] = {
     { SYSEX_COMMAND_INVERT_TOTAL_LEVEL, set_invert_total_level, 1, true },
     { SYSEX_COMMAND_WRITE_YM2612_REG_PART_0, direct_write_ym2612_part_0, 4, true },
     { SYSEX_COMMAND_WRITE_YM2612_REG_PART_1, direct_write_ym2612_part_1, 4, true },
-    { SYSEX_COMMAND_STORE_PROGRAM, store_program, 6 + (MAX_FM_OPERATORS * 11), true },
+    { SYSEX_COMMAND_STORE_PROGRAM, store_program, 0, false },
     { SYSEX_COMMAND_CLEAR_PROGRAM, clear_program, 2, true },
     { SYSEX_COMMAND_CLEAR_ALL_PROGRAMS, clear_all_programs, 1, true },
     { SYSEX_COMMAND_DUMP_PRESET, dump_preset_request, 2, true },
