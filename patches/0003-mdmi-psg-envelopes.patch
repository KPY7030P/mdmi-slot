+                    expect_any_psg_tone_on_channel(PSG_CH3);
+                }
+                expect_psg_attenuation(PSG_NOISE_CH4, PSG_ATTENUATION_LOUDEST);
+                __real_midi_note_on(NOISE_MIDI_CHAN, keys[k], MAX_MIDI_VOLUME);
+                expect_psg_attenuation(PSG_NOISE_CH4, PSG_ATTENUATION_SILENCE);
+                __real_midi_note_off(NOISE_MIDI_CHAN, keys[k]);
+            }
+        }
+    }
+}
