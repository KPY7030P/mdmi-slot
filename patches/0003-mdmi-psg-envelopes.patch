+    expect_pcm_start(kickData);
+    __real_midi_note_on(dacFmChannel, kickKey, 100);
+    expect_pcm_start(hatData);
+    __real_midi_note_on(dacFmChannel, hatKey, 100);
+    __real_midi_note_off(dacFmChannel, kickKey);
+    expect_function_call(__wrap_SND_PCM_stopPlay);
+    __real_midi_note_off(dacFmChannel, hatKey);
