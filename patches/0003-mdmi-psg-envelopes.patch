+
+    expect_synth_reset_lfo();
+    fm_note_on(MIDI_CHANNEL_1, FM_CH1, MIDI_PITCH_C4);
+
+    __real_midi_note_on(MIDI_CHANNEL_1, MIDI_PITCH_C5, MAX_MIDI_VOLUME);
+}
+
+// A raised key of the note stack is a new attack, as on FM without portamento.
+void test_midi_lfo_reset_on_raised_note(UNUSED void** state)
+{
+    __real_midi_cc(MIDI_CHANNEL_1, CC_LFO_RESET, 19);
+
+    expect_synth_reset_lfo();
+    fm_note_on(MIDI_CHANNEL_1, FM_CH1, MIDI_PITCH_C4);
+    expect_synth_reset_lfo();
+    fm_note_on(MIDI_CHANNEL_1, FM_CH1, MIDI_PITCH_C5);
+
+    expect_synth_reset_lfo();
+    expect_synth_pitch_any();
+    expect_synth_volume_any();
+    expect_synth_note_on(FM_CH1);
+    __real_midi_note_off(MIDI_CHANNEL_1, MIDI_PITCH_C5);
+}
+
+void test_midi_lfo_reset_on_chord_note_of_other_voice(UNUSED void** state)
+{
+    __real_midi_cc(MIDI_CHANNEL_1, CC_GENMDM_POLYPHONIC_MODE, 127);
+    __real_midi_cc(MIDI_CHANNEL_1, CC_LFO_RESET, 19);
+
+    expect_synth_reset_lfo();
+    fm_note_on(MIDI_CHANNEL_1, FM_CH1, MIDI_PITCH_C4);
+    expect_synth_reset_lfo();
+    fm_note_on(MIDI_CHANNEL_1, FM_CH2, MIDI_PITCH_C5);
+}
+
+// Stage 22a, item 3: portamento in CSM and, as the control, in ONE NOTE. Fixed on all four formants,
+// Porta On, Porta Time 64 (47 cents a frame); note 45 held, note 57 over it, note 45 released
+// halfway. Each frame writes the four formants at C4 and, in CSM, the NA of the glide's pitch, which
+// climbs from note 45's 540 to note 57's 782 and stays there. No key is written during the glide.
+#define GLIDE_FRAMES 26 // 1200 cents at 47 a frame
+
+static void fixed_formants_at_c4(void)
+{
+    for (u8 op = 0; op < 4; op++) {
+        expect_op_pitch(op, MIDI_PITCH_C4, 0);
+    }
+}
+
+static void glide_from_45_to_57(bool csm)
+{
+    special_mode(true);
+    ch3_notes(csm ? CSM : ONE_NOTE);
+    for (u8 op = 0; op < 3; op++) {
+        __real_midi_cc(OP1_MIDI + op, CC_CH3_OP_FIXED, 127);
+    }
+    __real_midi_cc(CH3_MIDI, CC_CH3_OP_FIXED, 127);
+    __real_midi_cc(CH3_MIDI, CC_PORTAMENTO_ENABLE, 127);
+    __real_midi_cc(CH3_MIDI, CC_PORTAMENTO_TIME_MSB, 64);
+
+    fixed_formants_at_c4();
+    if (csm) {
+        expect_synth_csm_timer(540);
+    }
+    expect_synth_volume_any();
+    if (csm) {
+        expect_synth_csm_note_on();
+    } else {
+        expect_synth_note_on(FM_CH3);
+    }
+    __real_midi_note_on(CH3_MIDI, 45, MAX_MIDI_VOLUME);
+    // The second note only sets the glide's target.
+    __real_midi_note_on(CH3_MIDI, 57, MAX_MIDI_VOLUME);
+
+    u16 last = 540;
+    for (u16 frame = 1; frame <= GLIDE_FRAMES; frame++) {
+        u16 total = 4500 + frame * 47;
+        if (total > 5700) {
+            total = 5700;
+        }
+        fixed_formants_at_c4();
+        if (csm) {
+            const u16 na = midi_fm_sm_csm_timer(total / 100, total % 100);
+            assert_true(na > last);
+            last = na;
+            expect_synth_csm_timer(na);
+        }
+        midi_tick(1);
+        if (frame == GLIDE_FRAMES / 2) {
+            __real_midi_note_off(CH3_MIDI, 45);
+        }
+    }
+    if (csm) {
+        assert_int_equal(last, 782);
+    }
+    // At the target the glide writes nothing more.
+    midi_tick(1);
+    midi_tick(1);
+
+    if (csm) {
+        expect_synth_csm_note_off();
+    } else {
+        expect_synth_note_off(FM_CH3);
+    }
+    __real_midi_note_off(CH3_MIDI, 57);
+}
+
+void test_midi_ch3_csm_portamento_moves_timer_a(UNUSED void** state)
+{
+    glide_from_45_to_57(true);
+}
+
+void test_midi_ch3_one_note_portamento(UNUSED void** state)
+{
+    glide_from_45_to_57(false);
+}
+
+// A bent pitch past FM's keys reads the table's ends, never past them (review of stage 22).
+void test_midi_ch3_csm_timer_holds_out_of_range(UNUSED void** state)
+{
+    const u16 top = midi_fm_sm_csm_timer(MAX_MIDI_PITCH, 0);
+    assert_int_equal(midi_fm_sm_csm_timer(MAX_MIDI_PITCH + 1, 0), top);
+    assert_int_equal(midi_fm_sm_csm_timer(127, 50), top);
+    assert_int_equal(midi_fm_sm_csm_timer(5, 0), midi_fm_sm_csm_timer(MIN_MIDI_PITCH, 0));
+    assert_true(midi_fm_sm_csm_timer(MAX_MIDI_PITCH, 99) >= top);
+}
