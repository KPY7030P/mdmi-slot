new file mode 100644
index 0000000..e958fb4
--- /dev/null
+++ b/tests/mocks/mock_pcm_driver.c
@@ -0,0 +1,62 @@
+#include "mock_pcm_driver.h"
+#include "pcm_driver.h"
+
+u8 mock_pcm_ram[0x200];
+u16 mock_pcm_waited_us;
+int mock_pcm_takes;
+void (*mock_pcm_on_wait)(void);
+static int held;
+
+void mock_pcm_driver_reset(void)
+{
+    for (u16 i = 0; i < sizeof(mock_pcm_ram); i++)
+        mock_pcm_ram[i] = 0;
+    mock_pcm_waited_us = 0;
+    mock_pcm_takes = 0;
+    mock_pcm_on_wait = NULL;
+    held = 0;
+}
+
+u16 mock_pcm_read16(u16 address)
+{
+    return mock_pcm_ram[address] | (mock_pcm_ram[address + 1] << 8);
+}
+
+void mock_pcm_write16(u16 address, u16 value)
+{
+    mock_pcm_ram[address] = value;
+    mock_pcm_ram[address + 1] = value >> 8;
+}
+
+u8 __wrap_pcm_driver_read(u16 address)
+{
+    return mock_pcm_ram[address];
+}
+
+void __wrap_pcm_driver_write(u16 address, u8 value)
+{
+    mock_pcm_ram[address] = value;
+}
+
+void __wrap_pcm_driver_take(void)
+{
+    held++;
+    mock_pcm_takes++;
+}
+
+void __wrap_pcm_driver_give(void)
+{
+    held--;
+}
+
+void __wrap_pcm_driver_wait_us(u16 us)
+{
+    mock_pcm_waited_us += us;
+    if (mock_pcm_on_wait) {
+        mock_pcm_on_wait();
+    }
+}
+
+void __wrap_waitSubTick(u32 subtick)
+{
+}
