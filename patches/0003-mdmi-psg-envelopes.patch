+// MDMI plugin fork, stage 24a3: the screen's envelope estimate by tables equals one by division
+// from the same frame tables, within 16 of 1023 (1.5 dB), on a grid of AR, D1R, SL, D2R (RR fixed) at every frame.
+static int reference_held(u8 ar, u8 d1r, u8 sl, u8 d2r, int t)
+{
+    const int attack = UI_ATTACK_FRAMES[ar];
+    if (!ar) {
+        return 1023;
+    }
+    if (t < attack) {
+        // The attack's real length, also when it is longer than the counters.
+        const double frames = 1023.0 * 64 / UI_ATTACK_STEP[ar];
+        const int v = 1023 - (int)(t * 1023.0 / frames);
+        return v < 0 ? 0 : v;
+    }
+    t -= attack;
+    if (!d1r) {
+        return 0;
+    }
+    const int sustain = sl == 15 ? 1023 : sl * 32;
+    // The same steps, with the time to SL by division instead of the frame table.
+    const double slope1 = UI_DECAY_STEP[d1r * 2] / 64.0, slope2 = d2r ? UI_DECAY_STEP[d2r * 2] / 64.0 : 0;
+    const double reach = sustain / slope1;
+    if (t < reach) {
+        const int v = (int)(t * slope1);
+        return v > sustain ? sustain : v;
+    }
+    const double v2 = sustain + (t - reach) * slope2;
+    const int v = v2 > 1023 ? 1023 : (int)v2;
+    return v > 1023 ? 1023 : v;
+}
+
+void test_ui_envelope_matches_division(UNUSED void** state)
+{
+    int worst = 0;
+    for (u8 ar = 1; ar < 32; ar += 3) {
+        for (u8 d1r = 1; d1r < 32; d1r += 5) {
+            for (u8 sl = 0; sl < 16; sl += 3) {
+                for (u8 d2r = 0; d2r < 32; d2r += 10) {
+                    UiEnvelope env;
+                    ui_envelope_build(&env, ar, d1r, sl, d2r, 7);
+                    // Within a frame: where a phase ends inside a frame, either side of it is right.
+                    for (int t = 0; t <= 250; t++) {
+                        // The distance from the span the reference covers from a frame before to after.
+                        const int got = ui_envelope_held(&env, (u8)t);
+                        int low = 1023, high = 0;
+                        for (int near = t - 1; near <= t + 1; near++) {
+                            const int r = reference_held(ar, d1r, sl, d2r, near < 0 ? 0 : near);
+                            low = r < low ? r : low;
+                            high = r > high ? r : high;
+                        }
+                        const int diff = got < low ? low - got : got > high ? got - high : 0;
+                        if (diff > worst) {
+                            worst = diff;
+                            print_message("AR %d D1R %d SL %d D2R %d t %d: %d\n", ar, d1r, sl, d2r, t, got);
+                        }
+                    }
+                }
+            }
+        }
+    }
+    print_message("worst difference %d of 1023\n", worst);
+    assert_true(worst <= 16);
+}
+
+// MDMI plugin fork, stage 24a3: a PSG envelope of any length as 12 bars, by subtraction, equals the
+// same by division: the step each bar shows, and the playing bar (stretched: the last of its run).
+void test_ui_bars_match_division(UNUSED void** state)
+{
+    for (int n = 1; n <= 250; n++) {
+        for (int bar = 0; bar < 12; bar++) {
+            assert_int_equal(ui_bar_step((u8)bar, (u8)n), bar * n / 12);
+        }
+        for (int step = 0; step < n; step++) {
+            int want = n <= 12 ? ((step + 1) * 12 + n - 1) / n - 1 : step * 12 / n;
+            want = want > 11 ? 11 : want;
+            assert_int_equal(ui_playing_bar((u8)step, (u8)n), want);
+        }
+    }
+    // A 1-step envelope: every bar the step, the last one playing; 3 steps: bars 3, 7, 11 play.
+    assert_int_equal(ui_playing_bar(0, 1), 11);
+    assert_int_equal(ui_playing_bar(0, 3), 3);
+    assert_int_equal(ui_playing_bar(2, 3), 11);
+    assert_int_equal(ui_bar_step(11, 12), 11);
+}
