diff --git a/src/pcm_sample.h b/src/pcm_sample.h
index df535e9..a6089c0 100644
--- a/src/pcm_sample.h
+++ b/src/pcm_sample.h
@@ -1,10 +1,32 @@
 #pragma once
 #include "types.h"
 
+// flags: PCM_ONE_SHOT lets the sample play to its end whatever Note Off comes (MDMI plugin, D38).
+// PCM_LOOP repeats the sample until Note Off; its length is whole 256-byte blocks (stage 18).
+// The record stays 10 bytes, the flags byte was its padding.
+#define PCM_LOOP 0x01
+#define PCM_ONE_SHOT 0x02
+// PCM_MARKS: the record is a PcmMarked, the loop between two blocks of the sample, and what follows
+// the loop's end plays after Note Off (stage 18b). Only the plugin writes such records.
+#define PCM_MARKS 0x04
+
 typedef struct PcmSample {
     const u8* data;
     u32 length;
     u8 rate;
+    u8 flags;
 } PcmSample;
 
+// The plugin writes records 14 bytes apart, the marks big endian at +10 and +12.
+typedef struct PcmMarked {
+    PcmSample sample;
+    u16 loopStart;
+    u16 loopEnd;
+} PcmMarked;
+
+#ifdef __m68k__
+_Static_assert(sizeof(PcmSample) == 10, "the plugin writes 10-byte records");
+_Static_assert(sizeof(PcmMarked) == 14, "the plugin writes the marks at +10 and +12");
+#endif
+
 extern const PcmSample* percussionPcmSample[128];
diff --git a/src/program_names.c b/src/program_names.c
new file mode 100644
index 0000000..b393fc7
--- /dev/null
+++ b/src/program_names.c
@@ -0,0 +1,11 @@
+#include "program_names.h"
+
+const ProgramNames PROGRAM_NAMES = { .magic = { 'M', 'D', 'M', 'I', 'N', 'A', 'M', 'E' } };
+
+const ProgramNames* program_names(void)
+{
+    // The table is const and looks empty to the compiler; the plugin patches it after the build.
+    const ProgramNames* names = &PROGRAM_NAMES;
+    __asm__("" : "+g"(names));
+    return names;
+}
diff --git a/src/program_names.h b/src/program_names.h
new file mode 100644
index 0000000..9279767
--- /dev/null
+++ b/src/program_names.h
@@ -0,0 +1,20 @@
+#pragma once
+#include "midi.h"
+
+// MDMI plugin fork, stage 24: the names the screen shows for each program, FM's then PSG's, and the
+// bank's signature for the header. ASCII, 0 ends a name; the build's are empty. The plugin writes a
+// bank's names here when it exports the ROM, and the emulator's own into the running cartridge.
+#define PROGRAM_NAME_BYTES 24
+#define PROGRAM_SIGNATURE_BYTES 12
+
+typedef struct ProgramNames {
+    // "MDMINAME": the plugin finds and checks the table by it.
+    char magic[8];
+    char signature[PROGRAM_SIGNATURE_BYTES];
+    char names[2][MIDI_PROGRAMS][PROGRAM_NAME_BYTES];
+} ProgramNames;
+
+extern const ProgramNames PROGRAM_NAMES;
+
+// The table the screen reads: the image's, never folded by the compiler.
+const ProgramNames* program_names(void);
