index 33ac142..47f5b21 100644
--- a/src/midi_dac.c
+++ b/src/midi_dac.c
@@ -1,5 +1,113 @@
 #include "midi_dac.h"
 #include "pcm_sample.h"
+#include "synth.h"
+#include "pcm_driver.h"
+
+static const PcmSample* playing;
+// Channel 6's pan as the driver's B6 value; the driver writes it at each sample's start (stage 18).
+static SoundPanning pan = SOUND_PAN_CENTER;
+
+// A sample with loop marks (stage 18b, docs/research/drv-pcm-loop-marks.md in the plugin): the ROM
+// writes the driver's params itself. It starts at the start up to the loop's end with the loop
+// flag; once the driver has copied that, the params become the loop alone, so each repeat goes
+// back to the loop's start. Note Off lets the pass run out into the release after the loop.
+// Blocks are absolute, the sample's address >> 8.
+enum { MARKS_IDLE, MARKS_WAIT_COPY, MARKS_LOOPING, MARKS_RELEASE };
+static struct {
+    u8 state;
+    u16 start;
+    u16 loopStart;
+    u16 loopEnd;
+    u16 end;
+} marks;
+
+static u16 read16(u16 address)
+{
+    return pcm_driver_read(address) | (pcm_driver_read(address + 1) << 8);
+}
+
+static void write16(u16 address, u16 value)
+{
+    pcm_driver_write(address, value);
+    pcm_driver_write(address + 1, value >> 8);
+}
+
+static void marks_start(const PcmSample* sample)
+{
+    const PcmMarked* marked = (const PcmMarked*)sample;
+    marks.start = (u32)sample->data >> 8;
+    marks.loopStart = marks.start + marked->loopStart;
+    marks.loopEnd = marks.start + marked->loopEnd;
+    marks.end = marks.start + (sample->length >> 8);
+    pcm_driver_take();
+    write16(PCM_DRV_WAVADR, marks.start);
+    write16(PCM_DRV_WAVLEN, marks.loopEnd - marks.start);
+    pcm_driver_write(PCM_DRV_RATE, sample->rate);
+    pcm_driver_write(PCM_DRV_PAN, pan);
+    // Playing comes back only once the driver has copied the params.
+    pcm_driver_write(PCM_DRV_STATUS, pcm_driver_read(PCM_DRV_STATUS) & ~1);
+    pcm_driver_write(PCM_DRV_LOOP, pcm_driver_read(PCM_DRV_LOOP) | 1);
+    pcm_driver_write(PCM_DRV_COMMAND, pcm_driver_read(PCM_DRV_COMMAND) | 1);
+    pcm_driver_give();
+    marks.state = marks.loopStart == marks.start ? MARKS_LOOPING : MARKS_WAIT_COPY;
+}
+
+// Each frame while the start's copy is awaited: then the loop alone becomes the params.
+void midi_dac_tick(void)
+{
+    if (marks.state != MARKS_WAIT_COPY) {
+        return;
+    }
+    pcm_driver_take();
+    if (!(pcm_driver_read(PCM_DRV_COMMAND) & 1) && (pcm_driver_read(PCM_DRV_STATUS) & 1)) {
+        write16(PCM_DRV_WAVADR, marks.loopStart);
+        write16(PCM_DRV_WAVLEN, marks.loopEnd - marks.loopStart);
+        marks.state = MARKS_LOOPING;
+    }
+    pcm_driver_give();
+}
+
+// The driver ends the pass it plays at IWAVADR + IWAVLEN: with that moved to the release's end and
+// the loop flag off it plays on into the release and stops. Its block update may overwrite the
+// length (about 0.35% of Note Offs): checked once the update is surely over, and put right.
+static void marks_release(void)
+{
+    pcm_driver_take();
+    if (pcm_driver_read(PCM_DRV_COMMAND) & 1) {
+        // Not taken yet, with an intro or without: it copies these, the intro, the loop once and
+        // the release. Waiting for the copy here could take a whole block (review of 18b).
+        write16(PCM_DRV_WAVLEN, marks.end - marks.start);
+        pcm_driver_write(PCM_DRV_LOOP, pcm_driver_read(PCM_DRV_LOOP) & ~1);
+        pcm_driver_give();
+        marks.state = MARKS_RELEASE;
+        return;
+    }
+    while (!(pcm_driver_read(PCM_DRV_STATUS) & 1)) {
+        // The command is taken and the copy under way: at most 125 us.
+        pcm_driver_give();
+        pcm_driver_wait_us(130);
+        pcm_driver_take();
+    }
+    pcm_driver_write(PCM_DRV_LOOP, pcm_driver_read(PCM_DRV_LOOP) & ~1);
+    write16(PCM_DRV_IWAVLEN, marks.end - read16(PCM_DRV_IWAVADR));
+    pcm_driver_give();
+    pcm_driver_wait_us(600);
+    pcm_driver_take();
+    const u16 at = read16(PCM_DRV_IWAVADR);
+    if (at + read16(PCM_DRV_IWAVLEN) != marks.end) {
+        if (at == read16(PCM_DRV_NULLWAVADR)) {
+            // It stopped at the loop's end before it saw the length: the release as a new start.
+            write16(PCM_DRV_WAVADR, marks.loopEnd);
+            write16(PCM_DRV_WAVLEN, marks.end - marks.loopEnd);
+            pcm_driver_write(PCM_DRV_STATUS, pcm_driver_read(PCM_DRV_STATUS) & ~1);
+            pcm_driver_write(PCM_DRV_COMMAND, pcm_driver_read(PCM_DRV_COMMAND) | 1);
+        } else {
+            write16(PCM_DRV_IWAVLEN, marks.end - at);
+        }
+    }
+    pcm_driver_give();
+    marks.state = MARKS_RELEASE;
+}
 
