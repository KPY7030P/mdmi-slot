+// Stage 24a: the wave's class by tone period, from the PSG's lowest note. The thresholds fall, about three semitones apart, so
+// a glide steps through the classes in one direction; every class and height names wave tiles.
+void test_midi_psg_wave_classes_follow_the_period(UNUSED void** state)
+{
+    // Class 0 is the PSG's lowest note, A2 (period 1017), and class 1 begins three semitones up.
+    assert_in_range(UI_WAVE_PERIOD[0], 820, 900);
+    for (u8 i = 1; i < UI_WAVE_CLASSES - 1; i++) {
+        assert_true(UI_WAVE_PERIOD[i] < UI_WAVE_PERIOD[i - 1]);
+        const u32 ratio = (u32)UI_WAVE_PERIOD[i - 1] * 100 / UI_WAVE_PERIOD[i];
+        assert_in_range(ratio, 112, 126);
+    }
+    for (u8 c = 0; c < UI_WAVE_CLASSES; c++) {
+        for (u8 h = 0; h < 3; h++) {
+            for (u8 t = 0; t < 4; t++) {
+                assert_true(UI_T_WAVE + UI_WAVE[c][h][t] < UI_T_END);
+            }
+        }
+    }
+    assert_true(UI_WAVE[0][2][0] != UI_WAVE[UI_WAVE_CLASSES - 1][2][0]
+        || UI_WAVE[0][2][1] != UI_WAVE[UI_WAVE_CLASSES - 1][2][1]);
+}
