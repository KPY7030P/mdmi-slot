@@ -293,6 +309,15 @@ void midi_psg_load_envelope(const u8* eef)
     userDefinedEnvelopePtr = userDefinedEnvelope;
 }
 
+// The tail is filled with EEF_END, so a copy ends within the slot whatever was stored before.
+void midi_psg_store_envelope(u8 program, const u8* eef, u16 length)
+{
+    u8* slot = storedEnvelopes[program];
+    memset(slot, EEF_END, sizeof(storedEnvelopes[program]));
+    memcpy(slot, eef, length);
+    activeStoredEnvelopes[program] = slot;
+}
