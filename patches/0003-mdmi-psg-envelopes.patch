+// MDMI plugin fork, stage 20: the voices an arpeggio row moves. Not the DAC, not channel 3 in Ch3
+// Special nor its operators, not the noise at KIT, where the key picks the drum.
+static bool arp_applies(DeviceChannel* devChan)
+{
+    if (devChan->ops == &FM_VTable) {
+        return !(devChan->num == CH3_SPECIAL_MODE && synth_global_parameters()->specialMode);
+    }
+    return devChan->ops == &PSG_VTable && !midi_psg_plays_key(devChan->num);
+}
+
+// The row's step is added after bend and fine tune. FM is held within the keys it can play; PSG
+// holds the tone itself, it only has to stay within a key byte.
+static PitchCents arp_shift(DeviceChannel* devChan, PitchCents pc)
+{
+    const s16 MAX_PSG_PITCH_CENTS = 127 * 100;
+
+    if (devChan->arp.count == 0 || !arp_applies(devChan)) {
+        return pc;
+    }
+    bool fm = devChan->ops == &FM_VTable;
+    s16 min = fm ? MIN_MIDI_PITCH * 100 : 0;
+    s16 max = fm ? MAX_MIDI_PITCH * 100 : MAX_PSG_PITCH_CENTS;
+    s16 total = pc.pitch * 100 + pc.cents + devChan->arp.steps[devChan->arpStep] * 100;
+    if (total < min) {
+        total = min;
+    } else if (total > max) {
+        total = max;
+    }
+    return (PitchCents) { .pitch = total / 100, .cents = total % 100 };
+}
+
 static PitchCents effectivePitchCents(DeviceChannel* devChan)
 {
+    // MDMI plugin fork, stage 16 (D45): at rate KIT the key picks the drum, so bend and fine tune
+    // must not move it to the next one.
+    if (devChan->ops == &PSG_VTable && midi_psg_plays_key(devChan->num)) {
+        PitchCents key = { .pitch = devChan->pitch, .cents = 0 };
+        return key;
+    }
     MidiChannel* midiChannel = &midiChannels[devChan->midiChannel];
     PitchCents pc
         = pc_bend(devChan->pitch, devChan->cents, devChan->pitchBend, midiChannel->pitchBendRange);
-    return pc_shift(pc, midiChannel->fineTune);
+    return arp_shift(devChan, pc_shift(pc, midiChannel->fineTune));
 }
 
