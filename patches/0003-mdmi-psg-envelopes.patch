+void test_midi_psg_note_off_in_loop_ends_the_pass_then_releases(UNUSED void** state)
+{
+    __real_midi_psg_load_envelope(RELEASED_EEF);
+    expect_psg_tone(0, TONE_NTSC_C4);
+    expect_psg_attenuation(0, 1);
+    __real_midi_note_on(MIN_PSG_CHAN, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+    expect_steps(2, 3);
+    expect_steps(2, 2);
+    __real_midi_note_off(MIN_PSG_CHAN, MIDI_PITCH_C4);
+    // The pass ends, the release plays, then silence.
+    expect_steps(3, 5);
+    expect_psg_attenuation(0, PSG_ATTENUATION_SILENCE);
+    __real_midi_psg_tick();
+    __real_midi_psg_tick();
+}
+
+void test_midi_psg_note_off_in_intro_plays_the_loop_once_then_releases(UNUSED void** state)
+{
