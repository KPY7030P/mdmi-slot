+// Stage 22b (D57): entering CSM gives channel 3's four operators AR 31 with the voice's RS; leaving
+// CSM, or Ch3 Special going off, writes the voice's AR back. Only a change of the condition writes.
+void test_synth_csm_writes_attack_rate_31(UNUSED void** state)
+{
