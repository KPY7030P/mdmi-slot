+// A new attack copies the row of the voice's program from the table of its type and starts at step 0.
+static void arp_start(DeviceChannel* devChan)
+{
+    devChan->arpStep = 0;
+    devChan->arp.count = 0;
+    if (!arp_applies(devChan)) {
+        return;
+    }
+    const ArpRow* row = devChan->ops == &FM_VTable ? &fmArpRows[devChan->program]
+                                                   : &psgArpRows[devChan->program];
+    if (row->count != 0) {
+        memcpy(&devChan->arp, row, sizeof(ArpRow));
+    }
+}
