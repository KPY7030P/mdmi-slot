+// Stage 21 (D51), OPS: one write of 0x28 per event with the whole mask of channel 3.
+void test_ch3_operator_keys_from_shadow(void** state)
+{
+    stub_everdrive_as_present();
+    enable_ch3_special_mode();
+    stub_usb_receive_cc(MIDI_CHANNEL_3, CC_GENMDM_FM_ALGORITHM, 0x7F); // alg 7
+    expect_ym2612_write_reg(0, YM_REG(YM_BASE_ALGORITHM_FEEDBACK, YM_CH3), 0x7);
+    midi_rx_read();
+
+    stub_usb_receive_note_on(MIDI_CHANNEL_11, MIDI_PITCH_C4, 120);
+    expect_ym2612_write_reg(0, 0xAD, 0x22);
+    expect_ym2612_write_reg(0, 0xA9, 0x84);
+    expect_ym2612_write_operator_any_data(CH3_SPECIAL_MODE, 0, YM_BASE_TOTAL_LEVEL);
+    expect_ym2612_write_reg(0, YM_KEY_ON_OFF, 0x12);
+    midi_rx_read();
+
+    // MIDI 3 sets the level of operator 4 only.
+    stub_usb_receive_note_on(MIDI_CHANNEL_3, MIDI_PITCH_C5, 120);
+    expect_ym2612_write_operator_any_data(CH3_SPECIAL_MODE, 3, YM_BASE_TOTAL_LEVEL);
+    expect_ym2612_write_reg(0, 0xA6, 0x2A);
+    expect_ym2612_write_reg(0, 0xA2, 0x84);
+    expect_ym2612_write_reg(0, YM_KEY_ON_OFF, 0x92);
+    midi_rx_read();
+
+    // A raised key of the stack moves A9/AD without a write of 0x28.
+    stub_usb_receive_note_on(MIDI_CHANNEL_11, MIDI_PITCH_C5, 120);
+    expect_ym2612_write_reg(0, 0xAD, 0x2A);
+    expect_ym2612_write_reg(0, 0xA9, 0x84);
+    expect_ym2612_write_operator_any_data(CH3_SPECIAL_MODE, 0, YM_BASE_TOTAL_LEVEL);
+    expect_ym2612_write_reg(0, YM_KEY_ON_OFF, 0x92);
+    midi_rx_read();
+    stub_usb_receive_note_off(MIDI_CHANNEL_11, MIDI_PITCH_C5);
+    expect_ym2612_write_reg(0, 0xAD, 0x22);
+    expect_ym2612_write_reg(0, 0xA9, 0x84);
+    midi_rx_read();
+
+    stub_usb_receive_note_off(MIDI_CHANNEL_11, MIDI_PITCH_C4);
+    expect_ym2612_write_reg(0, YM_KEY_ON_OFF, 0x82);
+    midi_rx_read();
+
+    // Switching Ch3 Notes lets go of operator 4, and the next note starts from an empty shadow.
+    stub_usb_receive_cc(MIDI_CHANNEL_1, CC_CH3_NOTES, 0);
+    expect_ym2612_write_reg(0, YM_KEY_ON_OFF, 0x02);
+    midi_rx_read();
+    stub_usb_receive_note_off(MIDI_CHANNEL_3, MIDI_PITCH_C5);
+    midi_rx_read();
+    stub_usb_receive_note_on(MIDI_CHANNEL_11 + 1, MIDI_PITCH_C4, 120);
+    expect_ym2612_write_reg(0, 0xAE, 0x22);
+    expect_ym2612_write_reg(0, 0xAA, 0x84);
+    expect_ym2612_write_operator_any_data(CH3_SPECIAL_MODE, 1, YM_BASE_TOTAL_LEVEL);
+    expect_ym2612_write_reg(0, YM_KEY_ON_OFF, 0x22);
+    midi_rx_read();
+}
