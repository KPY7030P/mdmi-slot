+    expect_psg_attenuation(0, 1);
+    __real_midi_note_on(MIN_PSG_CHAN, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+    __real_midi_note_off(MIN_PSG_CHAN, MIDI_PITCH_C4);
+    // A short note sounds the whole envelope: the loop once, the release.
+    expect_steps(2, 5);
+    expect_psg_attenuation(0, PSG_ATTENUATION_SILENCE);
+    __real_midi_psg_tick();
+    __real_midi_psg_tick();
+}
+
+void test_midi_psg_note_off_on_loop_without_release_stops_at_once(UNUSED void** state)
+{
+    static const u8 toEnd[] = { 0x01, EEF_LOOP_START, 0x02, 0x03, EEF_END };
+    static const u8 toLoopEnd[] = { 0x01, EEF_LOOP_START, 0x02, 0x03, EEF_LOOP_END, EEF_END };
+    const u8* eefs[] = { toEnd, toLoopEnd };
+    for (int i = 0; i < 2; i++) {
+        __real_midi_psg_load_envelope(eefs[i]);
+        if (i == 0) {
+            // The tone is written once: it doesn't change after.
+            expect_psg_tone(0, TONE_NTSC_C4);
+        }
+        expect_psg_attenuation(0, 1);
+        __real_midi_note_on(MIN_PSG_CHAN, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+        expect_steps(2, 2);
+        // Silent in the Note Off itself, in the loop or in the intro.
+        expect_psg_attenuation(0, PSG_ATTENUATION_SILENCE);
+        __real_midi_note_off(MIN_PSG_CHAN, MIDI_PITCH_C4);
+        __real_midi_psg_tick();
+        expect_psg_attenuation(0, 1);
+        __real_midi_note_on(MIN_PSG_CHAN, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+        expect_psg_attenuation(0, PSG_ATTENUATION_SILENCE);
+        __real_midi_note_off(MIN_PSG_CHAN, MIDI_PITCH_C4);
+        __real_midi_psg_tick();
+    }
