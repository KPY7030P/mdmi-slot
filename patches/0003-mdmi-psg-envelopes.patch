@@ -415,8 +461,24 @@ static void set_downstream_pitch(DeviceChannel* devChan)
     devChan->ops->pitch(devChan->num, pc.pitch, pc.cents);
 }
 
+// A new attack copies the row of the voice's program from the table of its type and starts at step 0.
+static void arp_start(DeviceChannel* devChan)
+{
+    devChan->arpStep = 0;
+    devChan->arp.count = 0;
+    if (!arp_applies(devChan)) {
+        return;
+    }
+    const ArpRow* row = devChan->ops == &FM_VTable ? &fmArpRows[devChan->program]
+                                                   : &psgArpRows[devChan->program];
+    if (row->count != 0) {
+        memcpy(&devChan->arp, row, sizeof(ArpRow));
+    }
+}
+
 static void set_downstream_note_on(DeviceChannel* devChan, u8 velocity)
 {
+    arp_start(devChan);
     PitchCents pc = effectivePitchCents(devChan);
     devChan->ops->noteOn(devChan->num, pc.pitch, pc.cents, velocity);
 }
