 {
 }
 
-void midi_dac_pan(u8 chan, u8 pan)
+// As FM pan: 0-31 left, 32-95 centre, 96-127 right. Written to B6 at once, so a sounding sample
+// moves too; the driver writes B6 only when a sample starts.
+void midi_dac_pan(u8 chan, u8 value)
