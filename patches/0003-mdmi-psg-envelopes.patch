+// raw SysEx write of 0x27 sets; bits 4-5 (flag resets) act once and are not kept.
+#define CH3_MODE_SPECIAL 0x40
+#define CH3_MODE_CSM 0x80
+#define CH3_MODE_TIMER_A 0x01
+#define CH3_MODE_KEPT_BITS 0x0E
+#define CH3_MODE_ONCE_BITS 0x30
+static u8 ch3ModeKept;
