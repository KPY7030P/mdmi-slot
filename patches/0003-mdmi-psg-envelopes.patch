+    static const u8 hatData[256] = { 0 };
+    static const PcmSample kick = { kickData, sizeof(kickData), 1, PCM_ONE_SHOT };
+    static const PcmSample hat = { hatData, sizeof(hatData), 1, 0 };
+    const u8 kickKey = 36, hatKey = 42;
+    const PcmSample* savedKick = percussionPcmSample[kickKey];
+    const PcmSample* savedHat = percussionPcmSample[hatKey];
