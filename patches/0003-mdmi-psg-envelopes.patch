diff --git a/tests/unit/test_midi_ch3.c b/tests/unit/test_midi_ch3.c
new file mode 100644
index 0000000..ec3acdd
--- /dev/null
+++ b/tests/unit/test_midi_ch3.c
@@ -0,0 +1,619 @@
+// MDMI plugin fork, stage 21 (D51): channel 3 by operators. Ch3 Notes (CC 81), operator intervals
+// (CC 102-104) and LFO Reset (CC 82). The bytes of 0x28 are checked in test_synth.c and test_e2e.c.
+#include "test_midi_ch3.h"
+#include "test_midi.h"
+#include "mocks/mock_sgdk.h"
+#include "midi_fm_sm.h"
+#include "midi_fm.h"
+
+#define CH3_MIDI MIDI_CHANNEL_3
+#define OP1_MIDI MIDI_CHANNEL_11
+#define OP2_MIDI (MIDI_CHANNEL_11 + 1)
+#define OP3_MIDI (MIDI_CHANNEL_11 + 2)
+#define OP4 3
+#define ONE_NOTE 64
+#define OPS 0
+#define CSM 127
+
+static void special_mode(bool enable)
+{
+    expect_synth_set_special_mode(enable);
+    expect_synth_special_mode_keys_off();
+    __real_midi_cc(MIDI_CHANNEL_1, CC_GENMDM_CH3_SPECIAL_MODE, enable ? 127 : 0);
+}
+
+static void ch3_notes(u8 value)
+{
+    expect_synth_special_mode_keys_off();
+    expect_synth_set_csm(value * 3 / 128 == CH3_NOTES_CSM);
+    __real_midi_cc(MIDI_CHANNEL_1, CC_CH3_NOTES, value);
+}
+
+// The pitch written for an operator: operators 0-2 to A8-AE, operator 3 to channel 3 (A2/A6).
+static void expect_op_pitch(u8 op, u8 pitch, s8 cents)
+{
+    u8 octave = midi_fm_pitch_to_octave(pitch);
+    u16 freq = midi_fm_pitch_cents_to_freq_num(pitch, cents);
+    if (op == OP4) {
+        expect_synth_pitch(FM_CH3, octave, freq);
+    } else {
+        expect_synth_special_mode_pitch(op, octave, freq);
+    }
+}
+
+static void op_note_on(u8 op, u8 pitch, u8 velocity)
+{
+    expect_op_pitch(op, pitch, 0);
+    expect_synth_special_mode_volume(op, velocity);
+    expect_synth_special_mode_note_on(op);
+    __real_midi_note_on(op == OP4 ? CH3_MIDI : OP1_MIDI + op, pitch, velocity);
+}
+
+static void one_note_on(const u8* pitches)
+{
+    for (u8 op = 0; op < 4; op++) {
+        expect_op_pitch(op, pitches[op], 0);
+    }
+    expect_synth_volume_any();
+    expect_synth_note_on(FM_CH3);
+    __real_midi_note_on(CH3_MIDI, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+}
+
+void test_midi_ch3_ops_keys_each_operator(UNUSED void** state)
+{
+    special_mode(true);
+
+    op_note_on(0, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+    op_note_on(OP4, MIDI_PITCH_C5, 100);
+
+    expect_synth_special_mode_note_off(0);
+    __real_midi_note_off(OP1_MIDI, MIDI_PITCH_C4);
+
+    expect_synth_special_mode_note_off(OP4);
+    __real_midi_note_off(CH3_MIDI, MIDI_PITCH_C5);
+}
+
+// The velocity of MIDI 12 sets the level of operator 2 (index 1) only; synth_special_mode_volume
+// writes it only when the operator is a carrier (test_synth.c).
+void test_midi_ch3_ops_velocity_of_own_operator(UNUSED void** state)
+{
+    special_mode(true);
+    op_note_on(1, MIDI_PITCH_C4, 50);
+    op_note_on(OP4, MIDI_PITCH_C4, 70);
+}
+
+void test_midi_ch3_ops_raised_note_moves_pitch_without_key(UNUSED void** state)
+{
+    special_mode(true);
+    op_note_on(0, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+
+    expect_op_pitch(0, MIDI_PITCH_C5, 0);
+    expect_synth_special_mode_volume(0, MAX_MIDI_VOLUME);
+    expect_synth_special_mode_note_on(0);
+    __real_midi_note_on(OP1_MIDI, MIDI_PITCH_C5, MAX_MIDI_VOLUME);
+
+    expect_op_pitch(0, MIDI_PITCH_C4, 0);
+    __real_midi_note_off(OP1_MIDI, MIDI_PITCH_C5);
+
+    expect_synth_special_mode_note_off(0);
+    __real_midi_note_off(OP1_MIDI, MIDI_PITCH_C4);
+}
+
+void test_midi_ch3_ops_all_notes_off_releases_operator(UNUSED void** state)
+{
+    special_mode(true);
+    op_note_on(2, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+
+    expect_synth_special_mode_note_off(2);
+    __real_midi_cc(OP3_MIDI, CC_ALL_NOTES_OFF, 0);
+}
+
+void test_midi_ch3_operator_notes_silent_without_special_mode(UNUSED void** state)
+{
+    for (u8 op = 0; op < 3; op++) {
+        __real_midi_note_on(OP1_MIDI + op, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+        __real_midi_pitch_bend(OP1_MIDI + op, 0x3000);
+        __real_midi_note_off(OP1_MIDI + op, MIDI_PITCH_C4);
+    }
+}
+
+void test_midi_ch3_one_note_keys_all_four(UNUSED void** state)
+{
+    special_mode(true);
+    ch3_notes(ONE_NOTE);
+
+    const u8 pitches[] = { MIDI_PITCH_C4, MIDI_PITCH_C4, MIDI_PITCH_C4, MIDI_PITCH_C4 };
+    one_note_on(pitches);
+
+    expect_synth_note_off(FM_CH3);
+    __real_midi_note_off(CH3_MIDI, MIDI_PITCH_C4);
+}
+
+void test_midi_ch3_one_note_ignores_operator_channels(UNUSED void** state)
+{
+    special_mode(true);
+    ch3_notes(ONE_NOTE);
+
+    for (u8 op = 0; op < 3; op++) {
+        __real_midi_note_on(OP1_MIDI + op, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+        __real_midi_pitch_bend(OP1_MIDI + op, 0x3000);
+        __real_midi_note_off(OP1_MIDI + op, MIDI_PITCH_C4);
+    }
+}
+
+static void set_intervals(void)
+{
+    __real_midi_cc(OP1_MIDI, CC_CH3_OP_SEMI, 64 + 7);
+    __real_midi_cc(OP2_MIDI, CC_CH3_OP_SEMI, 64 + 12);
+    __real_midi_cc(OP3_MIDI, CC_CH3_OP_FINE, 64 + 10);
+    __real_midi_cc(CH3_MIDI, CC_CH3_OP_FIXED, 127);
+}
+
+// Semi +7 and +12, Fine +10 and Fixed give the bytes of G4, C5, C4 + 10 cents and C4.
+void test_midi_ch3_one_note_intervals(UNUSED void** state)
+{
+    special_mode(true);
+    ch3_notes(ONE_NOTE);
+    set_intervals();
+
+    expect_op_pitch(0, 67, 0);
+    expect_op_pitch(1, MIDI_PITCH_C5, 0);
+    expect_op_pitch(2, MIDI_PITCH_C4, 10);
+    expect_op_pitch(OP4, MIDI_PITCH_C4, 0);
+    expect_synth_volume_any();
+    expect_synth_note_on(FM_CH3);
+    __real_midi_note_on(CH3_MIDI, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+
+    expect_synth_note_off(FM_CH3);
+    __real_midi_note_off(CH3_MIDI, MIDI_PITCH_C4);
+
+    // E4: the intervals follow the note, Fixed stays at C4.
+    expect_op_pitch(0, 71, 0);
+    expect_op_pitch(1, 76, 0);
+    expect_op_pitch(2, 64, 10);
+    expect_op_pitch(OP4, MIDI_PITCH_C4, 0);
+    expect_synth_volume_any();
+    expect_synth_note_on(FM_CH3);
+    __real_midi_note_on(CH3_MIDI, 64, MAX_MIDI_VOLUME);
+}
+
+void test_midi_ch3_one_note_bend_moves_all_but_fixed(UNUSED void** state)
+{
+    special_mode(true);
+    ch3_notes(ONE_NOTE);
+    __real_midi_cc(CH3_MIDI, CC_CH3_OP_FIXED, 127);
+
+    const u8 pitches[] = { MIDI_PITCH_C4, MIDI_PITCH_C4, MIDI_PITCH_C4, MIDI_PITCH_C4 };
+    one_note_on(pitches);
+
+    for (u8 op = 0; op < 3; op++) {
+        expect_op_pitch(op, MIDI_PITCH_D3 + 12, 0);
+    }
+    expect_op_pitch(OP4, MIDI_PITCH_C4, 0);
+    __real_midi_pitch_bend(CH3_MIDI, 0x4000);
+}
+
+void test_midi_ch3_semi_is_held_within_range(UNUSED void** state)
+{
+    special_mode(true);
+    __real_midi_cc(OP1_MIDI, CC_CH3_OP_SEMI, 127);
+    __real_midi_cc(OP2_MIDI, CC_CH3_OP_SEMI, 0);
+
+    expect_op_pitch(0, MAX_MIDI_PITCH, 0);
+    expect_synth_special_mode_volume(0, MAX_MIDI_VOLUME);
+    expect_synth_special_mode_note_on(0);
+    __real_midi_note_on(OP1_MIDI, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+
+    // C4 - 48 is key 12, within the range; C3 - 48 is held at key 11.
+    expect_op_pitch(1, MIDI_PITCH_C4 - 48, 0);
+    expect_synth_special_mode_volume(1, MAX_MIDI_VOLUME);
+    expect_synth_special_mode_note_on(1);
+    __real_midi_note_on(OP2_MIDI, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+
+    expect_op_pitch(1, MIN_MIDI_PITCH, 0);
+    expect_synth_special_mode_volume(1, MAX_MIDI_VOLUME);
+    expect_synth_special_mode_note_on(1);
+    __real_midi_note_on(OP2_MIDI, MIDI_PITCH_C3, MAX_MIDI_VOLUME);
+}
+
+void test_midi_ch3_interval_moves_sounding_note(UNUSED void** state)
+{
+    special_mode(true);
+    op_note_on(0, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+    op_note_on(OP4, 64, MAX_MIDI_VOLUME);
+
+    expect_op_pitch(0, 67, 0);
+    __real_midi_cc(OP1_MIDI, CC_CH3_OP_SEMI, 64 + 7);
+
+    expect_op_pitch(0, 66, 95); // G4 - 5 cents
+    __real_midi_cc(OP1_MIDI, CC_CH3_OP_FINE, 64 - 5);
+
+    expect_op_pitch(OP4, MIDI_PITCH_C4, 0);
+    __real_midi_cc(CH3_MIDI, CC_CH3_OP_FIXED, 64);
+}
+
+// CC 102-104 on channels other than MIDI 3 and 11-13 write nothing and leave the intervals alone.
+void test_midi_ch3_interval_ccs_ignored_on_other_channels(UNUSED void** state)
+{
+    special_mode(true);
+    ch3_notes(ONE_NOTE);
+
+    for (u8 ch = 0; ch < MIDI_CHANNELS; ch++) {
+        if (ch == CH3_MIDI || (ch >= OP1_MIDI && ch <= OP3_MIDI)) {
+            continue;
+        }
+        __real_midi_cc(ch, CC_CH3_OP_SEMI, 127);
+        __real_midi_cc(ch, CC_CH3_OP_FINE, 127);
+        __real_midi_cc(ch, CC_CH3_OP_FIXED, 127);
+    }
+
+    const u8 pitches[] = { MIDI_PITCH_C4, MIDI_PITCH_C4, MIDI_PITCH_C4, MIDI_PITCH_C4 };
+    one_note_on(pitches);
+}
+
+// Interval CCs without a note, or without Ch3 Special, write nothing.
+void test_midi_ch3_interval_ccs_without_note_write_nothing(UNUSED void** state)
+{
+    set_intervals();
+    special_mode(true);
+    set_intervals();
+}
+
+static void hold_operator_notes(void)
+{
+    op_note_on(0, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+    op_note_on(1, MIDI_PITCH_C5, MAX_MIDI_VOLUME);
+    op_note_on(OP4, MIDI_PITCH_C3, MAX_MIDI_VOLUME);
+}
+
+// After the reset the held notes are forgotten: their Note Off writes nothing.
+static void released_notes_write_nothing(void)
+{
+    __real_midi_note_off(OP1_MIDI, MIDI_PITCH_C4);
+    __real_midi_note_off(OP2_MIDI, MIDI_PITCH_C5);
+    __real_midi_note_off(CH3_MIDI, MIDI_PITCH_C3);
+}
+
+void test_midi_ch3_special_mode_cc_resets_keys(UNUSED void** state)
+{
+    special_mode(true);
+    hold_operator_notes();
+
+    special_mode(true);
+    released_notes_write_nothing();
+    op_note_on(0, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+
+    special_mode(false);
+    __real_midi_note_off(OP1_MIDI, MIDI_PITCH_C4);
+}
+
+void test_midi_ch3_notes_cc_resets_keys(UNUSED void** state)
+{
+    special_mode(true);
+    hold_operator_notes();
+
+    ch3_notes(OPS);
+    released_notes_write_nothing();
+    op_note_on(0, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+
+    ch3_notes(ONE_NOTE);
+    __real_midi_note_off(OP1_MIDI, MIDI_PITCH_C4);
+}
+
+void test_midi_ch3_dac_switch_resets_keys(UNUSED void** state)
+{
+    special_mode(true);
+    hold_operator_notes();
+
+    expect_value(__wrap_synth_enable_dac, enable, true);
+    expect_synth_special_mode_keys_off();
+    expect_synth_stereo(5, STEREO_MODE_CENTRE);
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_CLOCK2);
+    __real_midi_cc(MIDI_CHANNEL_1, CC_GENMDM_ENABLE_DAC, 127);
+
+    released_notes_write_nothing();
+}
+
+// Stage 22 (D52): CSM. NA = 1024 - round(53267 / f), counted by hand: G#1 52.02 Hz is NA 0, A2
+// 540, A3 782, A4 903, A5 963.
+static void csm_note_on(u8 pitch, u16 timerA)
+{
+    for (u8 op = 0; op < 4; op++) {
+        expect_op_pitch(op, pitch, 0);
+    }
+    expect_synth_csm_timer(timerA);
+    expect_synth_volume_any();
+    expect_synth_csm_note_on();
+    __real_midi_note_on(CH3_MIDI, pitch, MAX_MIDI_VOLUME);
+}
+
+void test_midi_ch3_csm_note_sets_timer_a(UNUSED void** state)
+{
+    special_mode(true);
+    ch3_notes(CSM);
+    const u8 pitches[] = { 32, 45, 57, 69, 81 };
+    const u16 timers[] = { 0, 540, 782, 903, 963 };
+    for (u8 i = 0; i < 5; i++) {
+        csm_note_on(pitches[i], timers[i]);
+        expect_synth_csm_note_off();
+        __real_midi_note_off(CH3_MIDI, pitches[i]);
+    }
+}
+
+// Below note 32 the period would pass 1024 ticks: every such note is NA 0. Values 86 and 127 are
+// both CSM (value * 3 / 128).
+void test_midi_ch3_csm_low_notes_give_na_0(UNUSED void** state)
+{
+    special_mode(true);
+    ch3_notes(86);
+    csm_note_on(31, 0);
+    expect_synth_csm_note_off();
+    __real_midi_note_off(CH3_MIDI, 31);
+    csm_note_on(MIN_MIDI_PITCH, 0);
+}
+
+// Cents between neighbours, as the F-num: A4 + 50 cents is halfway between the periods 121 and 114.
+void test_midi_ch3_csm_cents_between_notes(UNUSED void** state)
+{
+    special_mode(true);
+    ch3_notes(CSM);
+    __real_midi_cc(CH3_MIDI, CC_FINE_TUNE, 64 + 50);
+    for (u8 op = 0; op < 4; op++) {
+        expect_op_pitch(op, 69, 50);
+    }
+    expect_synth_csm_timer(1024 - 118);
+    expect_synth_volume_any();
+    expect_synth_csm_note_on();
+    __real_midi_note_on(CH3_MIDI, 69, MAX_MIDI_VOLUME);
+}
+
+void test_midi_ch3_csm_pal_periods(UNUSED void** state)
+{
+    mock_sgdk_set_SYS_isPAL(true);
+    special_mode(true);
+    ch3_notes(CSM);
+    for (u8 op = 0; op < 4; op++) {
+        expect_op_pitch(op, 69, 0);
+    }
+    expect_synth_csm_timer(1024 - 120); // 52781 / 440
+    expect_synth_volume_any();
+    expect_synth_csm_note_on();
+    __real_midi_note_on(CH3_MIDI, 69, MAX_MIDI_VOLUME);
+    mock_sgdk_set_SYS_isPAL(false);
+}
+
+// A bend under the note and a raised note of the stack write the new NA and the formants; the
+// note stays keyed, so synth_csm_note_on writes nothing (test_synth.c).
+void test_midi_ch3_csm_legato_keeps_note(UNUSED void** state)
+{
+    special_mode(true);
+    ch3_notes(CSM);
+    csm_note_on(69, 903);
+
+    for (u8 op = 0; op < 4; op++) {
+        expect_op_pitch(op, 71, 0);
+    }
+    expect_synth_csm_timer(916);
+    __real_midi_pitch_bend(CH3_MIDI, 0x4000);
+    for (u8 op = 0; op < 4; op++) {
+        expect_op_pitch(op, 69, 0);
+    }
+    expect_synth_csm_timer(903);
+    __real_midi_pitch_bend(CH3_MIDI, 0x2000);
+}
+
+void test_midi_ch3_csm_raised_note_of_stack(UNUSED void** state)
+{
+    special_mode(true);
+    ch3_notes(CSM);
+    csm_note_on(69, 903);
+    csm_note_on(81, 963);
+    csm_note_on(69, 903);
+    // The raised note goes through Note On; the synth keeps the timer running.
+    for (u8 op = 0; op < 4; op++) {
+        expect_op_pitch(op, 81, 0);
+    }
+    expect_synth_csm_timer(963);
+    expect_synth_volume_any();
+    expect_synth_csm_note_on();
+    __real_midi_note_off(CH3_MIDI, 69);
+}
+
+// MIDI 11-13 notes in CSM write nothing.
+void test_midi_ch3_csm_ignores_operator_channels(UNUSED void** state)
+{
+    special_mode(true);
+    ch3_notes(CSM);
+    for (u8 op = 0; op < 3; op++) {
+        __real_midi_note_on(OP1_MIDI + op, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+        __real_midi_pitch_bend(OP1_MIDI + op, 0x3000);
+        __real_midi_note_off(OP1_MIDI + op, MIDI_PITCH_C4);
+    }
+}
+
+// All Notes Off releases the CSM note.
+void test_midi_ch3_csm_all_notes_off(UNUSED void** state)
+{
+    special_mode(true);
+    ch3_notes(CSM);
+    csm_note_on(69, 903);
+    expect_synth_csm_note_off();
+    __real_midi_cc(CH3_MIDI, CC_ALL_NOTES_OFF, 0);
+}
+
+// Without Ch3 Special the CSM choice does nothing: MIDI 3 is plain FM.
+void test_midi_ch3_csm_needs_special_mode(UNUSED void** state)
+{
+    ch3_notes(CSM);
+    expect_synth_pitch_any();
+    expect_synth_volume_any();
+    expect_synth_note_on(FM_CH3);
+    __real_midi_note_on(CH3_MIDI, 69, MAX_MIDI_VOLUME);
+    expect_synth_note_off(FM_CH3);
+    __real_midi_note_off(CH3_MIDI, 69);
+}
+
+static void fm_note_on(u8 midiChan, u8 fmChan, u8 pitch)
+{
+    expect_synth_pitch_any();
+    expect_synth_volume_any();
+    expect_synth_note_on(fmChan);
+    __real_midi_note_on(midiChan, pitch, MAX_MIDI_VOLUME);
+}
+
+void test_midi_lfo_reset_on_chosen_channel(UNUSED void** state)
+{
+    __real_midi_cc(MIDI_CHANNEL_6, CC_LFO_RESET, 19); // 19 * 7 / 128 = 1: MIDI 1
+
+    expect_synth_reset_lfo();
+    fm_note_on(MIDI_CHANNEL_1, FM_CH1, MIDI_PITCH_C4);
+
+    fm_note_on(MIDI_CHANNEL_1 + 1, FM_CH2, MIDI_PITCH_C4);
+
+    expect_synth_note_off(FM_CH1);
+    __real_midi_note_off(MIDI_CHANNEL_1, MIDI_PITCH_C4);
+
+    expect_synth_reset_lfo();
+    fm_note_on(MIDI_CHANNEL_1, FM_CH1, MIDI_PITCH_C5);
+}
+
+void test_midi_lfo_reset_channel_choice(UNUSED void** state)
+{
+    __real_midi_cc(MIDI_CHANNEL_1, CC_LFO_RESET, 127); // MIDI 6
+    fm_note_on(MIDI_CHANNEL_1, FM_CH1, MIDI_PITCH_C4);
+    expect_synth_reset_lfo();
+    fm_note_on(MIDI_CHANNEL_6, FM_CH6, MIDI_PITCH_C4);
+
+    __real_midi_cc(MIDI_CHANNEL_1, CC_LFO_RESET, 0);
+    fm_note_on(MIDI_CHANNEL_6, FM_CH6, MIDI_PITCH_C5);
+}
+
+void test_midi_lfo_reset_not_on_portamento_legato(UNUSED void** state)
+{
+    __real_midi_cc(MIDI_CHANNEL_1, CC_LFO_RESET, 19);
+    __real_midi_cc(MIDI_CHANNEL_1, CC_PORTAMENTO_ENABLE, 127);
+
+    expect_synth_reset_lfo();
+    fm_note_on(MIDI_CHANNEL_1, FM_CH1, MIDI_PITCH_C4);
+
+    __real_midi_note_on(MIDI_CHANNEL_1, MIDI_PITCH_C5, MAX_MIDI_VOLUME);
+}
+
+// A raised key of the note stack is a new attack, as on FM without portamento.
+void test_midi_lfo_reset_on_raised_note(UNUSED void** state)
+{
+    __real_midi_cc(MIDI_CHANNEL_1, CC_LFO_RESET, 19);
+
+    expect_synth_reset_lfo();
+    fm_note_on(MIDI_CHANNEL_1, FM_CH1, MIDI_PITCH_C4);
+    expect_synth_reset_lfo();
+    fm_note_on(MIDI_CHANNEL_1, FM_CH1, MIDI_PITCH_C5);
+
+    expect_synth_reset_lfo();
+    expect_synth_pitch_any();
+    expect_synth_volume_any();
+    expect_synth_note_on(FM_CH1);
+    __real_midi_note_off(MIDI_CHANNEL_1, MIDI_PITCH_C5);
+}
+
+void test_midi_lfo_reset_on_chord_note_of_other_voice(UNUSED void** state)
+{
+    __real_midi_cc(MIDI_CHANNEL_1, CC_GENMDM_POLYPHONIC_MODE, 127);
+    __real_midi_cc(MIDI_CHANNEL_1, CC_LFO_RESET, 19);
+
+    expect_synth_reset_lfo();
+    fm_note_on(MIDI_CHANNEL_1, FM_CH1, MIDI_PITCH_C4);
+    expect_synth_reset_lfo();
+    fm_note_on(MIDI_CHANNEL_1, FM_CH2, MIDI_PITCH_C5);
+}
+
+// Stage 22a, item 3: portamento in CSM and, as the control, in ONE NOTE. Fixed on all four formants,
+// Porta On, Porta Time 64 (47 cents a frame); note 45 held, note 57 over it, note 45 released
+// halfway. Each frame writes the four formants at C4 and, in CSM, the NA of the glide's pitch, which
+// climbs from note 45's 540 to note 57's 782 and stays there. No key is written during the glide.
+#define GLIDE_FRAMES 26 // 1200 cents at 47 a frame
+
+static void fixed_formants_at_c4(void)
+{
+    for (u8 op = 0; op < 4; op++) {
+        expect_op_pitch(op, MIDI_PITCH_C4, 0);
+    }
+}
+
+static void glide_from_45_to_57(bool csm)
+{
+    special_mode(true);
+    ch3_notes(csm ? CSM : ONE_NOTE);
+    for (u8 op = 0; op < 3; op++) {
+        __real_midi_cc(OP1_MIDI + op, CC_CH3_OP_FIXED, 127);
+    }
+    __real_midi_cc(CH3_MIDI, CC_CH3_OP_FIXED, 127);
+    __real_midi_cc(CH3_MIDI, CC_PORTAMENTO_ENABLE, 127);
+    __real_midi_cc(CH3_MIDI, CC_PORTAMENTO_TIME_MSB, 64);
+
+    fixed_formants_at_c4();
+    if (csm) {
+        expect_synth_csm_timer(540);
+    }
+    expect_synth_volume_any();
+    if (csm) {
+        expect_synth_csm_note_on();
+    } else {
+        expect_synth_note_on(FM_CH3);
+    }
+    __real_midi_note_on(CH3_MIDI, 45, MAX_MIDI_VOLUME);
+    // The second note only sets the glide's target.
+    __real_midi_note_on(CH3_MIDI, 57, MAX_MIDI_VOLUME);
+
+    u16 last = 540;
+    for (u16 frame = 1; frame <= GLIDE_FRAMES; frame++) {
+        u16 total = 4500 + frame * 47;
+        if (total > 5700) {
+            total = 5700;
+        }
+        fixed_formants_at_c4();
+        if (csm) {
+            const u16 na = midi_fm_sm_csm_timer(total / 100, total % 100);
+            assert_true(na > last);
+            last = na;
+            expect_synth_csm_timer(na);
+        }
+        midi_tick(1);
+        if (frame == GLIDE_FRAMES / 2) {
+            __real_midi_note_off(CH3_MIDI, 45);
+        }
+    }
+    if (csm) {
+        assert_int_equal(last, 782);
+    }
+    // At the target the glide writes nothing more.
+    midi_tick(1);
+    midi_tick(1);
+
+    if (csm) {
+        expect_synth_csm_note_off();
+    } else {
+        expect_synth_note_off(FM_CH3);
+    }
+    __real_midi_note_off(CH3_MIDI, 57);
+}
+
+void test_midi_ch3_csm_portamento_moves_timer_a(UNUSED void** state)
+{
+    glide_from_45_to_57(true);
+}
+
+void test_midi_ch3_one_note_portamento(UNUSED void** state)
+{
+    glide_from_45_to_57(false);
+}
+
+// A bent pitch past FM's keys reads the table's ends, never past them (review of stage 22).
+void test_midi_ch3_csm_timer_holds_out_of_range(UNUSED void** state)
+{
+    const u16 top = midi_fm_sm_csm_timer(MAX_MIDI_PITCH, 0);
+    assert_int_equal(midi_fm_sm_csm_timer(MAX_MIDI_PITCH + 1, 0), top);
+    assert_int_equal(midi_fm_sm_csm_timer(127, 50), top);
+    assert_int_equal(midi_fm_sm_csm_timer(5, 0), midi_fm_sm_csm_timer(MIN_MIDI_PITCH, 0));
+    assert_true(midi_fm_sm_csm_timer(MAX_MIDI_PITCH, 99) >= top);
+}
