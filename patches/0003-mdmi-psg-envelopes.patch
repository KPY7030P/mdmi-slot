diff --git a/tests/unit/test_midi_dac_marks.c b/tests/unit/test_midi_dac_marks.c
new file mode 100644
index 0000000..b97b712
--- /dev/null
+++ b/tests/unit/test_midi_dac_marks.c
@@ -0,0 +1,345 @@
+#include "test_midi_dac_marks.h"
+#include "test_midi.h"
+#include "mocks/mock_midi.h"
+#include "mocks/mock_psg.h"
+#include "mocks/mock_pcm_driver.h"
+#include "pcm_sample.h"
+#include "pcm_driver.h"
+#include "midi_dac.h"
+#include "snd/sound.h"
+#include "snd/pcm/snd_pcm.h"
+
+// Stage 18b: a sample with loop marks, 8 blocks: intro 0-1, loop 2-5, release 6-7.
+static const u8 dacChannel = 5;
+static const u8 key = 1;
+static const u8 markedData[256 * 8] __attribute__((aligned(256))) = { 0 };
+static const PcmMarked marked = { { markedData, sizeof(markedData), 1, PCM_LOOP | PCM_MARKS }, 2, 6 };
+#define BLOCK0 ((u16)((u32)(long)markedData >> 8))
+
+static const PcmSample* saved;
+
+static void use_marked(const PcmMarked* sample)
+{
+    saved = percussionPcmSample[key];
+    percussionPcmSample[key] = &sample->sample;
+    mock_pcm_driver_reset();
+    // The driver ready, no voice playing.
+    mock_pcm_ram[PCM_DRV_STATUS] = 0x80;
+}
+
+static void done(void)
+{
+    percussionPcmSample[key] = saved;
+    mock_pcm_driver_reset();
+}
+
+// The driver takes the command: clears it, copies the params, sets playing.
+static void driver_copies(void)
+{
+    mock_pcm_ram[PCM_DRV_COMMAND] &= ~1;
+    mock_pcm_write16(PCM_DRV_IWAVADR(0), mock_pcm_read16(PCM_DRV_WAVADR(0)));
+    mock_pcm_write16(PCM_DRV_IWAVLEN(0), mock_pcm_read16(PCM_DRV_WAVLEN(0)));
+    mock_pcm_ram[PCM_DRV_STATUS] |= 1;
+}
+
+static void assert_tick_idle(void)
+{
+    const int takes = mock_pcm_takes;
+    midi_dac_tick();
+    assert_int_equal(mock_pcm_takes, takes);
+}
+
+void test_midi_dac_marks_start_then_loop(UNUSED void** state)
+{
+    use_marked(&marked);
+    __real_midi_note_on(dacChannel, key, 100);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(0)), BLOCK0);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 6);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_VOLUME(0)], 12);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 1);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_COMMAND] & 1, 1);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_STATUS], 0x80);
+    // Not taken yet: the params stay, next frame again.
+    midi_dac_tick();
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(0)), BLOCK0);
+    driver_copies();
+    midi_dac_tick();
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(0)), BLOCK0 + 2);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 4);
+    assert_tick_idle();
+    done();
+}
+
+void test_midi_dac_marks_without_intro_need_no_frame(UNUSED void** state)
+{
+    static const PcmMarked noIntro = { { markedData, sizeof(markedData), 1, PCM_LOOP | PCM_MARKS }, 0, 6 };
+    use_marked(&noIntro);
+    __real_midi_note_on(dacChannel, key, 100);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 6);
+    assert_tick_idle();
+    done();
+}
+
+void test_midi_dac_marks_note_off_plays_release(UNUSED void** state)
+{
+    use_marked(&marked);
+    __real_midi_note_on(dacChannel, key, 100);
+    driver_copies();
+    midi_dac_tick();
+    // In the loop's second block, so the pass ends at block 6.
+    mock_pcm_write16(PCM_DRV_IWAVADR(0), BLOCK0 + 3);
+    mock_pcm_write16(PCM_DRV_IWAVLEN(0), 3);
+    __real_midi_note_off(dacChannel, key);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 0);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_IWAVLEN(0)), 8 - 3);
+    assert_int_equal(mock_pcm_waited_us, 600);
+    done();
+}
+
+void test_midi_dac_marks_note_off_in_intro_before_copy(UNUSED void** state)
+{
+    use_marked(&marked);
+    __real_midi_note_on(dacChannel, key, 100);
+    __real_midi_note_off(dacChannel, key);
+    // The driver will copy the intro, the loop once and the release.
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(0)), BLOCK0);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 8);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 0);
+    assert_int_equal(mock_pcm_waited_us, 0);
+    assert_tick_idle();
+    done();
+}
+
+// Without an intro, a Note Off before the driver took the command doesn't wait for it.
+void test_midi_dac_marks_note_off_before_copy_without_intro(UNUSED void** state)
+{
+    static const PcmMarked noIntro = { { markedData, sizeof(markedData), 1, PCM_LOOP | PCM_MARKS }, 0, 6 };
+    use_marked(&noIntro);
+    __real_midi_note_on(dacChannel, key, 100);
+    __real_midi_note_off(dacChannel, key);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 8);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 0);
+    assert_int_equal(mock_pcm_waited_us, 0);
+    done();
+}
+
+void test_midi_dac_marks_note_off_in_intro_after_copy(UNUSED void** state)
+{
+    use_marked(&marked);
+    __real_midi_note_on(dacChannel, key, 100);
+    driver_copies();
+    __real_midi_note_off(dacChannel, key);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_IWAVLEN(0)), 8);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 0);
+    assert_tick_idle();
+    done();
+}
+
+// The driver's block update overwrote the length meanwhile: it is put right.
+static void driver_steps_over_length(void)
+{
+    mock_pcm_write16(PCM_DRV_IWAVADR(0), mock_pcm_read16(PCM_DRV_IWAVADR(0)) + 1);
+    mock_pcm_write16(PCM_DRV_IWAVLEN(0), 1);
+}
+
+void test_midi_dac_marks_release_survives_lost_write(UNUSED void** state)
+{
+    use_marked(&marked);
+    __real_midi_note_on(dacChannel, key, 100);
+    driver_copies();
+    midi_dac_tick();
+    mock_pcm_write16(PCM_DRV_IWAVADR(0), BLOCK0 + 3);
+    mock_pcm_write16(PCM_DRV_IWAVLEN(0), 3);
+    mock_pcm_on_wait = driver_steps_over_length;
+    __real_midi_note_off(dacChannel, key);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_IWAVADR(0)), BLOCK0 + 4);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_IWAVLEN(0)), 8 - 4);
+    done();
+}
+
+static void driver_stops_at_loop_end(void)
+{
+    mock_pcm_write16(PCM_DRV_IWAVADR(0), mock_pcm_read16(PCM_DRV_NULLWAVADR));
+    mock_pcm_write16(PCM_DRV_IWAVLEN(0), 1);
+    mock_pcm_ram[PCM_DRV_STATUS] &= ~1;
+}
+
+void test_midi_dac_marks_release_after_driver_stopped(UNUSED void** state)
+{
+    use_marked(&marked);
+    mock_pcm_write16(PCM_DRV_NULLWAVADR, 0x77);
+    __real_midi_note_on(dacChannel, key, 100);
+    driver_copies();
+    midi_dac_tick();
+    mock_pcm_write16(PCM_DRV_IWAVADR(0), BLOCK0 + 5);
+    mock_pcm_write16(PCM_DRV_IWAVLEN(0), 1);
+    mock_pcm_on_wait = driver_stops_at_loop_end;
+    __real_midi_note_off(dacChannel, key);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(0)), BLOCK0 + 6);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 2);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_COMMAND] & 1, 1);
+    done();
+}
+
+// The loop running to the end leaves no release: Note Off stops, as in stage 18.
+void test_midi_dac_marks_without_release_stop(UNUSED void** state)
+{
+    static const PcmMarked noRelease = { { markedData, sizeof(markedData), 1, PCM_LOOP | PCM_MARKS }, 2, 8 };
+    use_marked(&noRelease);
+    __real_midi_note_on(dacChannel, key, 100);
+    __real_midi_note_off(dacChannel, key);
+    assert_tick_idle();
+    done();
+}
+
+// Stage 22a (D53): LOOP with ONE-SHOT. Note Off neither releases nor stops: the loop goes on,
+// its loop bit set and its params as they were, until the key plays again. The plugin no longer
+// writes these flags since stage 22b (D54 cancels D53); the ROM still plays them so.
+void test_midi_dac_marks_one_shot_loops_past_note_off(UNUSED void** state)
+{
+    static const PcmMarked endless
+        = { { markedData, sizeof(markedData), 1, PCM_LOOP | PCM_ONE_SHOT | PCM_MARKS }, 2, 6 };
+    use_marked(&endless);
+    __real_midi_note_on(dacChannel, key, 100);
+    driver_copies();
+    midi_dac_tick();
+    const int takes = mock_pcm_takes;
+    __real_midi_note_off(dacChannel, key);
+    assert_int_equal(mock_pcm_takes, takes);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 1);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(0)), BLOCK0 + 2);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 4);
+    assert_int_equal(mock_pcm_waited_us, 0);
+    assert_tick_idle();
+    // The key again restarts its own voice from the start; All Notes Off stops it.
+    __real_midi_note_on(dacChannel, key, 100);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(0)), BLOCK0);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 6);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_COMMAND] & 0x0f, 1);
+    driver_copies();
+    midi_dac_tick();
+    __real_midi_cc(dacChannel, 123, 0);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 0);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_STATUS] & 1, 0);
+    done();
+}
+
+// A fifth note takes the endless loop's voice when it is the oldest; switching the DAC off then
+// unloads the driver (synth_enable_dac false) with no voice left to wait for.
+void test_midi_dac_marks_one_shot_loop_taken_and_switched_off(UNUSED void** state)
+{
+    static const PcmMarked endless
+        = { { markedData, sizeof(markedData), 1, PCM_LOOP | PCM_ONE_SHOT | PCM_MARKS }, 2, 6 };
+    static const u8 otherData[256 * 2] __attribute__((aligned(256))) = { 0 };
+    static const PcmSample other = { otherData, sizeof(otherData), 1, PCM_ONE_SHOT };
+    const PcmSample* was[4];
+    for (u8 k = 1; k <= 4; k++) {
+        was[k - 1] = percussionPcmSample[key + k];
+        percussionPcmSample[key + k] = &other;
+    }
+    use_marked(&endless);
+    __real_midi_note_on(dacChannel, key, 100);
+    driver_copies();
+    midi_dac_tick();
+    __real_midi_note_off(dacChannel, key);
+    for (u8 k = 1; k <= 3; k++) {
+        __real_midi_note_on(dacChannel, key + k, 100);
+        mock_pcm_ram[PCM_DRV_COMMAND] &= ~(1 << k);
+        mock_pcm_ram[PCM_DRV_STATUS] |= 1 << k;
+    }
+    assert_int_equal(mock_pcm_ram[PCM_DRV_STATUS] & 0x0f, 0x0f);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 1);
+    __real_midi_note_on(dacChannel, key + 4, 100);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_COMMAND] & 0x0f, 1);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(0)), (u16)((u32)(long)otherData >> 8));
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 0);
+    expect_value(__wrap_synth_enable_dac, enable, false);
+    expect_synth_special_mode_keys_off();
+    expect_synth_stereo(5, STEREO_MODE_CENTRE);
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_CLOCK2);
+    __real_midi_cc(0, 78, 0);
+    assert_tick_idle();
+    for (u8 k = 1; k <= 4; k++) {
+        percussionPcmSample[key + k] = was[k - 1];
+    }
+    done();
+}
+
+// Without marks: the whole kept part loops past Note Off the same way.
+void test_midi_dac_marks_one_shot_loops_without_marks(UNUSED void** state)
+{
+    static const PcmMarked whole = { { markedData, sizeof(markedData), 1, PCM_LOOP | PCM_ONE_SHOT }, 0, 0 };
+    use_marked(&whole);
+    __real_midi_note_on(dacChannel, key, 100);
+    driver_copies();
+    const int takes = mock_pcm_takes;
+    __real_midi_note_off(dacChannel, key);
+    assert_int_equal(mock_pcm_takes, takes);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP] & 1, 1);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 8);
+    assert_tick_idle();
+    done();
+}
+
+void test_midi_dac_marks_forgotten_on_all_notes_off(UNUSED void** state)
+{
+    use_marked(&marked);
+    __real_midi_note_on(dacChannel, key, 100);
+    __real_midi_cc(dacChannel, 123, 0);
+    assert_tick_idle();
+    done();
+}
+
+void test_midi_dac_marks_forgotten_on_dac_switch(UNUSED void** state)
+{
+    use_marked(&marked);
+    __real_midi_note_on(dacChannel, key, 100);
+    expect_value(__wrap_synth_enable_dac, enable, false);
+    expect_synth_special_mode_keys_off();
+    expect_synth_stereo(5, STEREO_MODE_CENTRE);
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_CLOCK2);
+    __real_midi_cc(0, 78, 0);
+    assert_tick_idle();
+    done();
+}
+
+// Stage 19: marks on voice 3 work as on voice 0, and two marked voices keep apart.
+void test_midi_dac_marks_on_voice_3(UNUSED void** state)
+{
+    static const u8 other[256 * 8] __attribute__((aligned(256))) = { 0 };
+    static const PcmMarked second = { { other, sizeof(other), 1, PCM_LOOP | PCM_MARKS }, 1, 5 };
+    use_marked(&marked);
+    const PcmSample* was = percussionPcmSample[key + 1];
+    percussionPcmSample[key + 1] = &second.sample;
+    // Voices 0-2 busy with starts not yet taken.
+    mock_pcm_ram[PCM_DRV_COMMAND] = 7;
+    __real_midi_note_on(dacChannel, key, 100);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(3)), BLOCK0);
+    assert_int_equal(mock_pcm_ram[PCM_DRV_LOOP], 8);
+    mock_pcm_ram[PCM_DRV_COMMAND] &= ~8;
+    mock_pcm_ram[PCM_DRV_STATUS] |= 8;
+    midi_dac_tick();
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(3)), BLOCK0 + 2);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(3)), 4);
+    // Voice 0 frees: the second marked sample takes it, voice 3 keeps its loop.
+    mock_pcm_ram[PCM_DRV_COMMAND] = 0;
+    __real_midi_note_on(dacChannel, key + 1, 100);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(0)), (u16)((u32)(long)other >> 8));
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVLEN(0)), 5);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_WAVADR(3)), BLOCK0 + 2);
+    percussionPcmSample[key + 1] = was;
+    done();
+}
+
+// A start lost on the console (COMMAND cleared, never copied): Note Off stops the voice, no hang.
+void test_midi_dac_marks_lost_start_does_not_hang(UNUSED void** state)
+{
+    use_marked(&marked);
+    mock_pcm_write16(PCM_DRV_NULLWAVADR, 0x77);
+    __real_midi_note_on(dacChannel, key, 100);
+    mock_pcm_ram[PCM_DRV_COMMAND] = 0;
+    __real_midi_note_off(dacChannel, key);
+    assert_int_equal(mock_pcm_read16(PCM_DRV_IWAVADR(0)), 0x77);
+    assert_int_equal(mock_pcm_waited_us, 4 * 130);
+    done();
+}
