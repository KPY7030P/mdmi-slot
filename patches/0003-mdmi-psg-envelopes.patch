+    hold_operator_notes();
+
+    expect_value(__wrap_synth_enable_dac, enable, true);
+    expect_synth_special_mode_keys_off();
+    expect_synth_stereo(5, STEREO_MODE_CENTRE);
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_CLOCK2);
+    __real_midi_cc(MIDI_CHANNEL_1, CC_GENMDM_ENABLE_DAC, 127);
+
+    released_notes_write_nothing();
+}
+
+// Stage 22 (D52): CSM. NA = 1024 - round(53267 / f), counted by hand: G#1 52.02 Hz is NA 0, A2
+// 540, A3 782, A4 903, A5 963.
+static void csm_note_on(u8 pitch, u16 timerA)
+{
+    for (u8 op = 0; op < 4; op++) {
+        expect_op_pitch(op, pitch, 0);
+    }
+    expect_synth_csm_timer(timerA);
+    expect_synth_volume_any();
+    expect_synth_csm_note_on();
+    __real_midi_note_on(CH3_MIDI, pitch, MAX_MIDI_VOLUME);
+}
+
+void test_midi_ch3_csm_note_sets_timer_a(UNUSED void** state)
+{
+    special_mode(true);
+    ch3_notes(CSM);
+    const u8 pitches[] = { 32, 45, 57, 69, 81 };
+    const u16 timers[] = { 0, 540, 782, 903, 963 };
+    for (u8 i = 0; i < 5; i++) {
+        csm_note_on(pitches[i], timers[i]);
+        expect_synth_csm_note_off();
+        __real_midi_note_off(CH3_MIDI, pitches[i]);
+    }
+}
+
+// Below note 32 the period would pass 1024 ticks: every such note is NA 0. Values 86 and 127 are
+// both CSM (value * 3 / 128).
+void test_midi_ch3_csm_low_notes_give_na_0(UNUSED void** state)
+{
+    special_mode(true);
+    ch3_notes(86);
+    csm_note_on(31, 0);
+    expect_synth_csm_note_off();
+    __real_midi_note_off(CH3_MIDI, 31);
+    csm_note_on(MIN_MIDI_PITCH, 0);
+}
+
+// Cents between neighbours, as the F-num: A4 + 50 cents is halfway between the periods 121 and 114.
+void test_midi_ch3_csm_cents_between_notes(UNUSED void** state)
+{
