-    psgChan->envelopeStep
-        = userDefinedEnvelopePtr != NULL ? userDefinedEnvelopePtr : envelopes[psgChan->envelope];
+    const u8* stored = activeStoredEnvelopes[psgChan->envelope];
+    if (userDefinedEnvelopePtr == NULL && stored != NULL) {
+        u8* copy = playingEnvelopes[psgChan->chanNum];
+        u16 i = 0;
+        do {
+            copy[i] = stored[i];
+        } while (stored[i++] != EEF_END);
+        psgChan->envelopeStep = copy;
+    } else {
