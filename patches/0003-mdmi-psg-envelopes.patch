+// Changing the driver resets the PSG behind the ROM: a sounding note is written again, and the
+// same note after the switch is written at all.
+void test_midi_dac_switch_rewrites_psg(UNUSED void** state)
+{
+    const u8 chan = MIN_PSG_CHAN;
+    const u8 psgChan = chan - MIN_PSG_CHAN;
+
+    expect_psg_tone(psgChan, TONE_NTSC_C4);
+    expect_psg_attenuation(psgChan, 0);
+    __real_midi_note_on(chan, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+
+    expect_value(__wrap_synth_enable_dac, enable, true);
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_CLOCK2);
+    expect_psg_tone(psgChan, TONE_NTSC_C4);
+    expect_psg_attenuation(psgChan, 0);
+    __real_midi_cc(0, 78, 0x7F);
+
+    expect_psg_attenuation(psgChan, PSG_ATTENUATION_SILENCE);
+    __real_midi_note_off(chan, MIDI_PITCH_C4);
+
+    expect_value(__wrap_synth_enable_dac, enable, false);
+    expect_psg_noise(PSG_NOISE_TYPE_WHITE, PSG_NOISE_FREQ_CLOCK2);
+    __real_midi_cc(0, 78, 0);
+
+    expect_psg_tone(psgChan, TONE_NTSC_C4);
+    expect_psg_attenuation(psgChan, 0);
+    __real_midi_note_on(chan, MIDI_PITCH_C4, MAX_MIDI_VOLUME);
+}
