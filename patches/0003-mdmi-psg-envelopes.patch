+    u8 mode;
+    if (value > 95) {
+        pan = SOUND_PAN_RIGHT;
+        mode = STEREO_MODE_RIGHT;
+    } else if (value > 31) {
+        pan = SOUND_PAN_CENTER;
+        mode = STEREO_MODE_CENTRE;
+    } else {
+        pan = SOUND_PAN_LEFT;
+        mode = STEREO_MODE_LEFT;
+    }
+    synth_stereo(chan, mode);
 }
 
 void midi_dac_program(u8 chan, u8 program)
 {
 }
 
+// The panic stops any sample, a one-shot too: nothing goes on sounding after the stop button.
 void midi_dac_all_notes_off(u8 chan)
 {
+    playing = NULL;
+    marks.state = MARKS_IDLE;
+    SND_PCM_stopPlay();
 }
 
