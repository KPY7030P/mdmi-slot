-tresult PLUGIN_API WrappedView::onKeyDown(char16 /*key*/, int16 /*keyCode*/, int16 /*modifiers*/)
+// MDMI: the arrow keys reach the plugin's window through a private extension; every other key
+// stays the host's.
+struct mdmi_gui_key
 {
-  return kResultFalse;
+  bool (*key)(const clap_plugin_t *plugin, bool up);
+};
+
+tresult PLUGIN_API WrappedView::onKeyDown(char16 /*key*/, int16 keyCode, int16 /*modifiers*/)
+{
+  if (keyCode != Steinberg::KEY_UP && keyCode != Steinberg::KEY_DOWN) return kResultFalse;
+  auto ext = static_cast<const mdmi_gui_key *>(_plugin->get_extension(_plugin, "mdmi.gui-key"));
+  return ext && ext->key(_plugin, keyCode == Steinberg::KEY_UP) ? kResultTrue : kResultFalse;
 }
 
