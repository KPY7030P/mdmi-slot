diff --git a/mem_win.c b/mem_win.c
index 4076afd..d6363b8 100644
--- a/mem_win.c
+++ b/mem_win.c
@@ -6,10 +6,37 @@
 
 #include "mem.h"
 #include <windows.h>
+#include <stdlib.h>
+
+//MDMI: unloading the DLL leaves VirtualAlloc'd memory behind, so every block is kept for free_all_code
+static void **code_blocks;
+static size_t code_count, code_storage;
 
 void * alloc_code(size_t *size)
 {
 	*size += PAGE_SIZE - (*size & (PAGE_SIZE - 1));
 
-	return VirtualAlloc(NULL, *size, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
+	void *block = VirtualAlloc(NULL, *size, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
+	if (block && code_count == code_storage) {
+		void **more = realloc(code_blocks, (code_storage ? code_storage * 2 : 16) * sizeof(void *));
+		if (more) {
+			code_blocks = more;
+			code_storage = code_storage ? code_storage * 2 : 16;
+		}
+	}
+	//Without room to note it the block stays allocated for good, as before free_all_code existed
+	if (block && code_count < code_storage) {
+		code_blocks[code_count++] = block;
+	}
+	return block;
+}
+
+void free_all_code(void)
+{
+	for (size_t i = 0; i < code_count; i++) {
+		VirtualFree(code_blocks[i], 0, MEM_RELEASE);
+	}
+	free(code_blocks);
+	code_blocks = NULL;
+	code_count = code_storage = 0;
 }
