+void render_audio_source_voices(audio_source *src, uint8_t base, uint8_t count)
+{
+	if (count > RENDER_MAX_SOURCE_VOICES || src->num_channels != 2) {
+		return;
+	}
+	uint32_t frames = render_is_audio_sync() ? buffer_samples : (src->mask + 1) / 2;
+	src->voice_front = calloc(frames * 2 * count, sizeof(float));
+	src->voice_back = calloc(frames * 2 * count, sizeof(float));
+	src->keyon_front = calloc(frames, sizeof(uint16_t));
+	src->keyon_back = calloc(frames, sizeof(uint16_t));
+	src->voice_frames = frames;
+	src->voice_base = base;
+	src->num_voices = count;
+}
+
+void render_swap_voices(audio_source *src)
+{
+	float *voices = src->voice_front;
+	src->voice_front = src->voice_back;
+	src->voice_back = voices;
+	uint16_t *keyon = src->keyon_front;
+	src->keyon_front = src->keyon_back;
+	src->keyon_back = keyon;
+}
+
+//MDMI: the front buffers' voices in the mix's units, total_voices per frame, each left and right
+uint32_t render_collect_voices(float *out, uint16_t *keyon, uint32_t frames, uint8_t total_voices)
+{
+	memset(out, 0, frames * total_voices * 2 * sizeof(float));
+	memset(keyon, 0, frames * sizeof(uint16_t));
+	for (uint8_t i = 0; i < num_audio_sources; i++)
+	{
+		audio_source *src = audio_sources[i];
+		if (!src->voice_front || src->voice_base + src->num_voices > total_voices) {
+			continue;
+		}
+		float gain = src->gain_mult * overall_gain_mult / 0x7FFF;
+		uint32_t count = frames < src->voice_frames ? frames : src->voice_frames;
+		for (uint32_t f = 0; f < count; f++)
+		{
+			const float *from = src->voice_front + f * 2 * src->num_voices;
+			float *to = out + (f * total_voices + src->voice_base) * 2;
+			for (uint8_t v = 0; v < 2 * src->num_voices; v++)
+			{
+				to[v] = from[v] * gain;
+			}
+			keyon[f] |= src->keyon_front[f] << src->voice_base;
+		}
+	}
+	return frames;
 }
 
