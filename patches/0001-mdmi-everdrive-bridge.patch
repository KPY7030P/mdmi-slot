index 0000000..0a735ec
--- /dev/null
+++ b/mdmi_bridge.h
@@ -0,0 +1,15 @@
+#ifndef MDMI_BRIDGE_H_
+#define MDMI_BRIDGE_H_
+
+#include <stdint.h>
+
+//Emulated side of the Mega EverDrive USB port (0xA130E2 data, 0xA130E4 status)
+//These run on the emulation thread, from the MED mapper register handlers
+uint8_t mdmi_bridge_rx_ready(void);
+uint8_t mdmi_bridge_rx_pop(void);
+void mdmi_bridge_tx_push(uint8_t value);
+
+//Marks the core as dead and ends the emulation thread, so a fatal error can't take the host process with it
+void mdmi_bridge_fatal(void);
+
+#endif //MDMI_BRIDGE_H_
