+
+//MDMI: the voices take the mix's own steps, lowpass and interpolation, in float and at the same
+//positions, so they add up to the mix but for its rounding
+void render_put_voices_sample(audio_source *src, int16_t left, int16_t right, const int16_t *voice_left, const int16_t *voice_right, uint16_t keyon)
+{
+	uint8_t voice_values = voice_left && src->voice_back ? 2 * src->num_voices : 0;
+	float current[2 * RENDER_MAX_SOURCE_VOICES];
+	if (voice_values) {
+		float alpha = src->lowpass_alpha / 65536.0f;
+		for (uint8_t v = 0; v < src->num_voices; v++)
+		{
+			current[2 * v] = voice_left[v] * alpha + src->voice_last[2 * v] * (1.0f - alpha);
+			current[2 * v + 1] = voice_right[v] * alpha + src->voice_last[2 * v + 1] * (1.0f - alpha);
+		}
+		src->keyon_pending |= keyon;
+	}
 	left = lowpass_sample(src, src->last_left, left);
 	right = lowpass_sample(src, src->last_right, right);
