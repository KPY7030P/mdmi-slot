diff --git a/mdmi_bridge.c b/mdmi_bridge.c
new file mode 100644
index 0000000..46e1a62
--- /dev/null
+++ b/mdmi_bridge.c
@@ -0,0 +1,176 @@
+#include <stddef.h>
+#include "mdmi_bridge.h"
+#include "libretro.h"
+#include "util.h"
+#include "config.h"
+#include "genesis.h"
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <pthread.h>
+#endif
+
+//Single producer, single consumer byte queues, so the host side of each may live on another thread
+#define QUEUE_SIZE 65536
+
+typedef struct {
+	uint32_t head;
+	uint32_t tail;
+	uint8_t data[QUEUE_SIZE];
+} byte_queue;
+
+static byte_queue rx, tx;
+
+static uint8_t queue_push(byte_queue *q, uint8_t value)
+{
+	uint32_t head = __atomic_load_n(&q->head, __ATOMIC_RELAXED);
+	if (head - __atomic_load_n(&q->tail, __ATOMIC_ACQUIRE) == QUEUE_SIZE) {
+		return 0;
+	}
+	q->data[head % QUEUE_SIZE] = value;
+	__atomic_store_n(&q->head, head + 1, __ATOMIC_RELEASE);
+	return 1;
+}
+
+static uint8_t queue_pop(byte_queue *q, uint8_t *value)
+{
+	uint32_t tail = __atomic_load_n(&q->tail, __ATOMIC_RELAXED);
+	if (tail == __atomic_load_n(&q->head, __ATOMIC_ACQUIRE)) {
+		return 0;
+	}
+	*value = q->data[tail % QUEUE_SIZE];
+	__atomic_store_n(&q->tail, tail + 1, __ATOMIC_RELEASE);
+	return 1;
+}
+
+uint8_t mdmi_bridge_rx_ready(void)
+{
+	return __atomic_load_n(&rx.tail, __ATOMIC_RELAXED) != __atomic_load_n(&rx.head, __ATOMIC_ACQUIRE);
+}
+
+uint8_t mdmi_bridge_rx_pop(void)
+{
+	uint8_t value = 0xFF;
+	queue_pop(&rx, &value);
+	return value;
+}
+
+void mdmi_bridge_tx_push(uint8_t value)
+{
+	queue_push(&tx, value);
+}
+
+static uint32_t failed;
+
+void mdmi_bridge_fatal(void)
+{
+	__atomic_store_n(&failed, 1, __ATOMIC_RELEASE);
+#ifdef _WIN32
+	ExitThread(1);
+#else
+	pthread_exit(NULL);
+#endif
+}
+
+RETRO_API uint32_t mdmi_has_failed(void)
+{
+	return __atomic_load_n(&failed, __ATOMIC_ACQUIRE);
+}
+
+//Host API: exercises the fatal error path from tests
+RETRO_API void mdmi_test_fatal(void)
+{
+	fatal_error("mdmi_test_fatal\n");
+}
+
+//Host API: exercises the machine freeze path from tests. In a library build it must simply return.
+RETRO_API void mdmi_test_freeze(void)
+{
+	machine_freeze(NULL, NULL, NULL, "mdmi_test_freeze\n");
+}
+
+//Host API: what the running chip holds in a register, for tests
+RETRO_API uint8_t mdmi_test_ym_read(uint8_t part, uint8_t reg)
+{
+	extern system_header *current_system;
+	ym2612_context *ym = ((genesis_context *)current_system)->ym;
+	return part ? ym->part2_regs[reg - YM_PART2_START] : ym->part1_regs[reg - YM_PART1_START];
+}
+
+//Host API: a PSG channel's attenuation, 0 loudest and 15 silent, for tests
+RETRO_API uint8_t mdmi_test_psg_volume(uint8_t channel)
+{
+	extern system_header *current_system;
+	return ((genesis_context *)current_system)->psg->volume[channel & 3];
+}
+
+//Host API: a tone channel's 10-bit period, or the noise channel's control bits (type and rate), for tests
+RETRO_API uint16_t mdmi_test_psg_tone(uint8_t channel)
+{
+	extern system_header *current_system;
+	psg_context *psg = ((genesis_context *)current_system)->psg;
+	if ((channel & 3) < 3) {
+		return psg->counter_load[channel & 3];
+	}
+	uint16_t rate = psg->noise_use_tone ? 3 : psg->counter_load[3] == 0x10 ? 0 : psg->counter_load[3] == 0x20 ? 1 : 2;
+	return psg->noise_type | rate;
+}
+
+//Host API: how many bytes of the cartridge in [from, to) differ from an image, zeros past its end.
+//The cartridge is stored byte-swapped: the byte at 68000 address A is at A ^ 1 (MDMI plugin, D39)
+RETRO_API size_t mdmi_cart_differs(const uint8_t *image, size_t size, size_t from, size_t to)
+{
+	extern system_header *current_system;
+	const uint8_t *cart = (const uint8_t *)((genesis_context *)current_system)->cart;
+	size_t differ = 0;
+	for (size_t a = from; a < to; a++) {
+		differ += cart[a ^ 1] != (a < size ? image[a] : 0);
+	}
+	return differ;
+}
+
+//Host API: writes an image's bytes in [from, to) into the running cartridge, zeros past its end, and
+//says how many changed. Data only: code the 68000 has translated would not see it (D39)
+RETRO_API size_t mdmi_write_cart(const uint8_t *image, size_t size, size_t from, size_t to)
+{
+	extern system_header *current_system;
+	uint8_t *cart = (uint8_t *)((genesis_context *)current_system)->cart;
+	size_t changed = 0;
+	for (size_t a = from; a < to; a++) {
+		const uint8_t value = a < size ? image[a] : 0;
+		changed += cart[a ^ 1] != value;
+		cart[a ^ 1] = value;
+	}
+	return changed;
+}
+
+//Host API: writes bytes into the 68000's work RAM at an offset from 0xFF0000, stored as words in
+//host order like the cartridge (D39)
+RETRO_API void mdmi_write_ram(size_t offset, const uint8_t *bytes, size_t length)
+{
+	extern system_header *current_system;
+	uint8_t *ram = (uint8_t *)((genesis_context *)current_system)->work_ram;
+	for (size_t i = 0; i < length; i++) {
+		ram[(offset + i) ^ 1] = bytes[i];
+	}
+}
+
+//Host API: returns the number of bytes accepted
+RETRO_API size_t mdmi_midi_write(const uint8_t *data, size_t length)
+{
+	size_t written = 0;
+	while (written < length && queue_push(&rx, data[written])) {
+		written++;
+	}
+	return written;
+}
+
+//Host API: returns the number of bytes read
+RETRO_API size_t mdmi_midi_read(uint8_t *data, size_t length)
+{
+	size_t read = 0;
+	while (read < length && queue_pop(&tx, data + read)) {
+		read++;
+	}
+	return read;
+}
diff --git a/mdmi_bridge.h b/mdmi_bridge.h
